<div
  class="footer-policy-list-container"
  style="
    {% render 'typography-style', preset: 'custom', settings: block.settings %}
    {% if block.settings.text_color != blank %}--color-utilities: {{ block.settings.text_color }};{% endif %}
  "
  {{ block.shopify_attributes }}
>
  <ul
    class="
      policy_list-visible list-unstyled
      custom-typography
      {% if block.settings.font_size != "" %}custom-font-size{% endif %}
    "
  >
    {%- if shop.policies.size > 0 -%}
      {%- for policy in shop.policies -%}
        {%- if policy != blank -%}
          <li>
            <a
              href="{{ policy.url }}"
              class="footer-utilities__text"
            >
              {%- assign policy_title_lower = policy.title | downcase -%}
              {%- if policy_title_lower contains 'privacy' -%}
                Zásady ochrany osobních údajů
              {%- elsif policy_title_lower contains 'refund' or policy_title_lower contains 'return' -%}
                Vrácení zboží a reklamace
              {%- elsif policy_title_lower contains 'terms' -%}
                Obchodní podmínky
              {%- elsif policy_title_lower contains 'shipping' -%}
                Doprava a doručení
              {%- elsif policy_title_lower contains 'contact' -%}
                Kontaktní informace
              {%- else -%}
                {{- policy.title | escape -}}
              {%- endif -%}
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    {%- else -%}
      <li><a href="/policies/terms-of-service" class="footer-utilities__text">Obchodní podmínky</a></li>
      <li><a href="/policies/privacy-policy" class="footer-utilities__text">Zásady ochrany osobních údajů</a></li>
      <li><a href="/policies/refund-policy" class="footer-utilities__text">Vrácení zboží a reklamace</a></li>
      <li><a href="/policies/shipping-policy" class="footer-utilities__text">Doprava a doručení</a></li>
      <li><a href="/policies/contact-information" class="footer-utilities__text">Kontaktní informace</a></li>
    {%- endif -%}
  </ul>
</div>

{% stylesheet %}
  .footer-policy-list-container {
    width: 100%;
  }

  .policy_list-visible {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 12px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
    white-space: normal;
    text-wrap: wrap;

    @media screen and (min-width: 750px) {
      justify-content: center;
    }

    li {
      margin: 0;
      padding: 0;
    }

    a {
      color: inherit;
      text-decoration: none;
      font-size: var(--font-size, 0.75rem);
      text-transform: var(--text-transform, none);
      opacity: 0.85;
      transition: opacity 0.2s ease, text-decoration 0.2s ease;

      &:hover {
        opacity: 1;
        text-decoration: underline;
      }
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.policy_list",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.manage_policies"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "select",
      "id": "font_size",
      "label": "t:settings.size",
      "options": [
        {
          "value": "0.625rem",
          "label": "10px"
        },
        {
          "value": "0.75rem",
          "label": "12px"
        },
        {
          "value": "0.875rem",
          "label": "14px"
        },
        {
          "value": "1rem",
          "label": "16px"
        },
        {
          "value": "1.125rem",
          "label": "18px"
        }
      ],
      "default": "0.75rem"
    },
    {
      "type": "select",
      "id": "case",
      "label": "t:settings.case",
      "options": [
        {
          "value": "none",
          "label": "t:options.default"
        },
        {
          "value": "uppercase",
          "label": "t:options.uppercase"
        }
      ],
      "default": "none"
    }
  ],
  "presets": [
    {
      "name": "t:names.policy_list",
      "category": "t:categories.footer"
    }
  ]
}
{% endschema %}

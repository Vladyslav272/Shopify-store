<div
  class="footer-policy-list-container"
  style="
    {% render 'typography-style', preset: 'custom', settings: block.settings %}
    {% if block.settings.text_color != blank %}--color-utilities: {{ block.settings.text_color }};{% endif %}
  "
  {{ block.shopify_attributes }}
>
  <ul
    class="
      policy_list-visible list-unstyled
      custom-typography
      {% if block.settings.font_size != "" %}custom-font-size{% endif %}
    "
  >
    <li><a href="/policies/refund-policy" class="footer-utilities__text">Vrácení zboží & Reklamace</a></li>
    <li><a href="/policies/shipping-policy" class="footer-utilities__text">Doprava & Dodání</a></li>
    <li><a href="/policies/contact-information" class="footer-utilities__text">Kontaktní Údaje</a></li>
    <li><a href="/policies/terms-of-service" class="footer-utilities__text">Obchodní Podmínky</a></li>
    <li><a href="/policies/privacy-policy" class="footer-utilities__text">Ochrana Osobních Údajů</a></li>
  </ul>
</div>

{% stylesheet %}
  .footer-policy-list-container {
    width: 100%;
  }

  .policy_list-visible {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
    text-align: left;

    li {
      margin: 0;
      padding: 0;
    }

    a {
      color: inherit;
      text-decoration: none;
      font-size: var(--font-size, 0.9375rem);
      line-height: 1.4;
      font-weight: 500;
      text-transform: var(--text-transform, none);
      opacity: 0.9;
      transition: opacity 0.2s ease, text-decoration 0.2s ease;

      &:hover {
        opacity: 1;
        text-decoration: underline;
      }
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.policy_list",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.manage_policies"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "select",
      "id": "font_size",
      "label": "t:settings.size",
      "options": [
        {
          "value": "0.625rem",
          "label": "10px"
        },
        {
          "value": "0.75rem",
          "label": "12px"
        },
        {
          "value": "0.875rem",
          "label": "14px"
        },
        {
          "value": "1rem",
          "label": "16px"
        },
        {
          "value": "1.125rem",
          "label": "18px"
        }
      ],
      "default": "0.875rem"
    },
    {
      "type": "select",
      "id": "case",
      "label": "t:settings.case",
      "options": [
        {
          "value": "none",
          "label": "t:options.default"
        },
        {
          "value": "uppercase",
          "label": "t:options.uppercase"
        }
      ],
      "default": "none"
    }
  ],
  "presets": [
    {
      "name": "t:names.policy_list",
      "category": "t:categories.footer"
    }
  ]
}
{% endschema %}

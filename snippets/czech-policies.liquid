    function applyCzechPolicy() {
      for (var slug in policiesData) {
        if (path.includes(slug)) {
          var policy = policiesData[slug];
          
          // Update title
          var titleEl = document.querySelector('.shopify-policy__title h1');
          if (titleEl) {
            titleEl.textContent = policy.title;
          }
          
          // Update document title
          document.title = policy.title + ' – Veaskin';
          
          // Update body
          var bodyEl = document.querySelector('.shopify-policy__body .rte');
          if (bodyEl) {
            bodyEl.innerHTML = policy.body;
          }
          break;
        }
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', applyCzechPolicy);
    } else {
      applyCzechPolicy();
    }
  })();

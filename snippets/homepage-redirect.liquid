{%- comment -%}
  Automatické okamžité přesměrování z domovské stránky přímo na produkt.
  V editoru motivu (design_mode) je přesměrování vypnuto, aby byla stránka plně viditelná a editovatelná.
  Zachovává všechny UTM a reklamní parametry (?utm_source=... fbclid=...) i kotvy (#).
{%- endcomment -%}
{%- unless request.design_mode -%}
  {%- liquid
    assign target_product = all_products['eye-care-machine-household-eye-massager']
    if target_product != blank and target_product.url != blank
      assign target_url = target_product.url
    elsif settings.homepage_redirect_product != blank and settings.homepage_redirect_product.url != blank
      assign target_url = settings.homepage_redirect_product.url
    elsif collections.all.products.first != blank
      assign target_url = collections.all.products.first.url
    else
      assign fallback_path = '/products/eye-care-machine-household-eye-massager'
      if routes.root_url != '/'
        assign target_url = routes.root_url | append: fallback_path
      else
        assign target_url = fallback_path
      endif
    endif
  -%}

  {%- if template.name == 'index' or request.page_type == 'index' or request.path == '/' or request.path == routes.root_url -%}
    <meta http-equiv="refresh" content="0;url={{ target_url }}">
    <script>
      (function() {
        var target = {{ target_url | json }};
        if (target && target.length > 0) {
          var search = window.location.search || '';
          var hash = window.location.hash || '';
          window.location.replace(target + search + hash);
        }
      })();
    </script>
  {%- endif -%}

  {%- if request.path == '/pages/contact' -%}
    <meta http-equiv="refresh" content="0;url=/policies/contact-information">
    <script>
      window.location.replace('/policies/contact-information');
    </script>
  {%- endif -%}
{%- endunless -%}

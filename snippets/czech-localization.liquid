      var existing = document.querySelector('.veaskin-announcement-bar');
      if (existing) {
        // If it doesn't have track/slides yet, upgrade its innerHTML
        if (!existing.querySelector('.veaskin-announcement-track')) {
          existing.innerHTML = `
            <div class="veaskin-announcement-track">
              <div class="veaskin-announcement-slide active">
                <svg class="veaskin-shipping-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
                  <rect x="1" y="3" width="15" height="13"></rect>
                  <polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon>
                  <circle cx="5.5" cy="18.5" r="2.5"></circle>
                  <circle cx="18.5" cy="18.5" r="2.5"></circle>
                </svg>
                <span>Doprava zdarma na všechny objednávky</span>
              </div>
              <div class="veaskin-announcement-slide">
                <svg class="veaskin-shipping-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
                  <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
                  <line x1="7" y1="7" x2="7.01" y2="7"></line>
                </svg>
                <span>Sleva 30 % na celou objednávku</span>
              </div>
            </div>
          `;
        }
        initAnnouncementTimer();
        return;
      }

      if (document.querySelector('.announcement-bar:not(.veaskin-announcement-bar)')) return;

      var headerGroup = document.querySelector('#header-group');
      var bar = document.createElement('div');
      bar.className = 'veaskin-announcement-bar';
      bar.innerHTML = `
        <div class="veaskin-announcement-track">
          <div class="veaskin-announcement-slide active">
            <svg class="veaskin-shipping-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
              <rect x="1" y="3" width="15" height="13"></rect>
              <polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon>
              <circle cx="5.5" cy="18.5" r="2.5"></circle>
              <circle cx="18.5" cy="18.5" r="2.5"></circle>
            </svg>
            <span>Doprava zdarma na všechny objednávky</span>
          </div>
          <div class="veaskin-announcement-slide">
            <svg class="veaskin-shipping-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
              <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
              <line x1="7" y1="7" x2="7.01" y2="7"></line>
            </svg>
            <span>Sleva 30 % na celou objednávku</span>
          </div>
        </div>
      `;

      if (headerGroup) {
        headerGroup.insertBefore(bar, headerGroup.firstChild);
      } else {
        var headerSection = document.querySelector('.header-section, #header-component, header');
        if (headerSection && headerSection.parentNode) {
          headerSection.parentNode.insertBefore(bar, headerSection);
        }
      }

      initAnnouncementTimer();
    }

    function initAnnouncementTimer() {
      if (window._veaskinAnnounceTimer) return;
      window._veaskinAnnounceTimer = setInterval(function() {
        var slides = document.querySelectorAll('.veaskin-announcement-slide');
        if (slides.length < 2) return;
        var activeIdx = -1;
        slides.forEach(function(s, idx) {
          if (s.classList.contains('active')) activeIdx = idx;
          s.classList.remove('active');
        });
        var nextIdx = (activeIdx + 1) % slides.length;
        slides[nextIdx].classList.add('active');
      }, 3500);
    }

    function runTranslations() {
      injectAnnouncementBar();
      updateTransformationStats();
      injectTechnologyBenefits();
      injectProductShowcase();
      injectQuizDiagnostic();
      injectComparisonTable();
      injectTimelineResults();
      injectPriceReframing();
      decorateOldSections();

      // Carousel title
      document.querySelectorAll('.jdgm-carousel-title').forEach(el => {
        if (el.textContent.includes('speak for us') || el.textContent.includes('Nechte zákazníky')) {
          el.textContent = 'Co o nás říkají naši zákazníci';
        }
      });

      // Widget title
      document.querySelectorAll('.jdgm-rev-widg__title').forEach(el => {
        if (el.textContent.includes('Customer Reviews')) {
          el.textContent = 'Hodnocení zákazníků';
        }
      });

      // Badge texts
      document.querySelectorAll('.jdgm-prev-badge__text, .jdgm-carousel-title-and-link, .jdgm-rev-widg__summary-text').forEach(el => {
        translateNode(el);
      });

      // Sort dropdown
      document.querySelectorAll('.jdgm-sort-dropdown option').forEach(opt => {
        if (opt.textContent.includes('Most Recent')) opt.textContent = 'Nejnovější';
        if (opt.textContent.includes('Highest Rating')) opt.textContent = 'Nejvyšší hodnocení';
        if (opt.textContent.includes('Lowest Rating')) opt.textContent = 'Nejnižší hodnocení';
        if (opt.textContent.includes('Only Pictures')) opt.textContent = 'Pouze s fotkami';
        if (opt.textContent.includes('Pictures First')) opt.textContent = 'Nejprve s fotkami';
      });

      // Form labels
      document.querySelectorAll('.jdgm-form__label').forEach(el => {
        if (el.textContent.includes('Name')) el.textContent = 'Jméno (zobrazí se veřejně)';
        if (el.textContent.includes('Email')) el.textContent = 'E-mail';
        if (el.textContent.includes('Rating')) el.textContent = 'Hodnocení';
        if (el.textContent.includes('Review Title')) el.textContent = 'Název recenze';
        if (el.textContent.includes('Review') && !el.textContent.includes('Title')) el.textContent = 'Vaše recenze';
      });

      // Submit button
      document.querySelectorAll('.jdgm-submit-rev').forEach(el => {
        if (el.value && el.value.includes('Submit')) el.value = 'Odeslat recenzi';
      });

      // Hide carousel navigation arrows & handle mobile layout
      document.querySelectorAll('.jdgm-carousel__arrows, .jdgm-carousel__left-arrow, .jdgm-carousel__right-arrow').forEach(el => {
        el.style.display = 'none';
      });
      if (window.innerWidth <= 749) {
        document.querySelectorAll('.jdgm-carousel__item-wrapper').forEach(el => {
          el.style.transform = 'none';
        });
      }

      // Ensure product image in sticky add-to-cart bar
      var stickyBar = document.querySelector('.sticky-add-to-cart__bar');
      if (stickyBar && !stickyBar.querySelector('.sticky-add-to-cart__image')) {
        var galleryImg = document.querySelector('.product-media-gallery img, .product-gallery img, media-gallery img');
        if (galleryImg && galleryImg.src) {
          var imgDiv = document.createElement('div');
          imgDiv.className = 'sticky-add-to-cart__image';
          imgDiv.innerHTML = '<img src="' + galleryImg.src + '" class="sticky-add-to-cart__image-img" alt="Product" style="width:100%;height:100%;object-fit:cover;border-radius:inherit;" />';
          var info = stickyBar.querySelector('.sticky-add-to-cart__info');
          if (info) {
            info.setAttribute('data-has-image', 'true');
            stickyBar.insertBefore(imgDiv, info);
          }
        }
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', runTranslations);
    } else {
      runTranslations();
    }

    // Smooth scroll for CTA button directly to product image
    document.addEventListener('click', function(e) {
      var btn = e.target.closest('.product-showcase-btn');
      if (btn) {
        e.preventDefault();
        e.stopPropagation();
        var target = document.querySelector('.product-information img[src*="zenabilepozadi"]') ||
                     document.querySelector('.product-information__media') ||
                     document.querySelector('#shopify-section-template--30716979773814__product-information') ||
                     document.querySelector('.product-information');
        if (target) {
          var offset = 16;
          var top = target.getBoundingClientRect().top + window.pageYOffset - offset;
          window.scrollTo({ top: top, behavior: 'smooth' });
        }
      }
    }, true);

    // Observer for asynchronously injected widgets and DOM updates
    const observer = new MutationObserver(function() {
      runTranslations();
    });

    if (document.body) {
      observer.observe(document.body, { childList: true, subtree: true });
    } else {
      document.addEventListener('DOMContentLoaded', function() {


        observer.observe(document.body, { childList: true, subtree: true });
      });
    }
  })();
</script>

<script>
  (function() {
    function translateNode(node) {
      if (node.nodeType === Node.TEXT_NODE) {
        let val = node.nodeValue;
        if (!val) return;
        
        let newVal = val
          .replace(/Let customers speak for us/gi, 'Co o nás říkají naši zákazníci')
          .replace(/Nechte zákazníky mluvit za nás/gi, 'Co o nás říkají naši zákazníci')
          .replace(/Customer Reviews/gi, 'Hodnocení zákazníků')
          .replace(/Write a review/gi, 'Napsat recenzi')
          .replace(/Cancel review/gi, 'Zrušit')
          .replace(/from\s+(\d+)\s+reviews?/gi, 'ze $1 recenzí')
          .replace(/Based on\s+(\d+)\s+reviews?/gi, 'Na základě $1 recenzí')
          .replace(/(\d+)\s+reviews/gi, '$1 recenzí')
          .replace(/(\d+)\s+review/gi, '$1 recenze')
          .replace(/\bAll reviews\b/gi, 'Všechny recenze')
          .replace(/\bMost Recent\b/gi, 'Nejnovější')
          .replace(/\bHighest Rating\b/gi, 'Nejvyšší hodnocení')
          .replace(/\bLowest Rating\b/gi, 'Nejnižší hodnocení')
          .replace(/\bOnly Pictures\b/gi, 'Pouze s fotkami')
          .replace(/\bPictures First\b/gi, 'Nejprve s fotkami')
          .replace(/\bVideos First\b/gi, 'Nejprve s videi')
          .replace(/\bVerified Buyer\b/gi, 'Ověřený nákup')
          .replace(/\bVerified\b/gi, 'Ověřeno')
          .replace(/\bReview Title\b/gi, 'Předmět recenze')
          .replace(/\bReview\b/gi, 'Recenze')
          .replace(/\bSubmit Review\b/gi, 'Odeslat recenzi')
          .replace(/\bEye Care Machine\b/gi, 'Brýle proti otokům');
          
        if (newVal !== val) {
          node.nodeValue = newVal;
        }
      } else if (node.nodeType === Node.ELEMENT_NODE) {
        // Translate placeholders
        if (node.placeholder) {
          node.placeholder = node.placeholder
            .replace(/Write your review here/gi, 'Napište svou recenzi zde...')
            .replace(/Give your review a title/gi, 'Zadejte název recenze')
            .replace(/Enter your name/gi, 'Vaše jméno')
            .replace(/Enter your email/gi, 'Váš e-mail');
        }
        
        for (let i = 0; i < node.childNodes.length; i++) {
          translateNode(node.childNodes[i]);
        }
      }
    }

    function updateTransformationStats() {
      var slider = document.querySelector('comparison-slider-component, .comparison-slider');
      if (!slider) return;

      var parentWrapper = slider.closest('.section-content-wrapper, [data-testid="section-content"]');
      if (!parentWrapper) return;

      var leftCol = parentWrapper.firstElementChild;
      if (!leftCol || leftCol === slider) return;

      if (leftCol.querySelector('.veaskin-transformation-stats')) return;

      if (leftCol.textContent.includes('Od unavených') || leftCol.querySelector('img[src*="90.png"]') || !leftCol.textContent.includes('Viditelná proměna')) {
        leftCol.style.width = '48%';
        leftCol.style.maxWidth = '550px';
        leftCol.innerHTML = `
          <div class="veaskin-transformation-stats" style="display: flex; flex-direction: column; gap: 24px; width: 100%;">
            <h2 class="veaskin-transformation-title" style="font-size: 2.15rem; font-weight: 700; line-height: 1.25; color: #2b2325; margin: 0; letter-spacing: -0.01em;">
              Viditelná proměna už během několika týdnů
            </h2>

            <div class="veaskin-transformation-list" style="display: flex; flex-direction: column; gap: 20px; margin: 0; padding: 0;">
              <div class="veaskin-transformation-item" style="display: flex; align-items: center; gap: 22px;">
                <span class="veaskin-transformation-percent" style="font-size: 2.6rem; font-weight: 800; color: #c98a7d; line-height: 1; min-width: 95px; flex-shrink: 0; letter-spacing: -0.02em;">
                  82 %
                </span>
                <p class="veaskin-transformation-desc" style="font-size: 1.05rem; line-height: 1.45; color: #2b2325; font-weight: 500; margin: 0;">
                  Zaznamenalo zesvětlení tmavých kruhů a sjednocení tónu pleti již po 2 týdnech.
                </p>
              </div>

              <div class="veaskin-transformation-item" style="display: flex; align-items: center; gap: 22px;">
                <span class="veaskin-transformation-percent" style="font-size: 2.6rem; font-weight: 800; color: #c98a7d; line-height: 1; min-width: 95px; flex-shrink: 0; letter-spacing: -0.02em;">
                  87 %
                </span>
                <p class="veaskin-transformation-desc" style="font-size: 1.05rem; line-height: 1.45; color: #2b2325; font-weight: 500; margin: 0;">
                  Potvrdilo výraznou redukci ranních otoků a váčků pod očima po 2 týdnech.
                </p>
              </div>

              <div class="veaskin-transformation-item" style="display: flex; align-items: center; gap: 22px;">
                <span class="veaskin-transformation-percent" style="font-size: 2.6rem; font-weight: 800; color: #c98a7d; line-height: 1; min-width: 95px; flex-shrink: 0; letter-spacing: -0.02em;">
                  91 %
                </span>
                <p class="veaskin-transformation-desc" style="font-size: 1.05rem; line-height: 1.45; color: #2b2325; font-weight: 500; margin: 0;">
                  Zaznamenalo vyhlazení jemných vrásek a pevnou pokožku během 5 týdnů.
                </p>
              </div>
            </div>

            <p class="veaskin-transformation-note" style="font-size: 0.82rem; line-height: 1.4; color: #725d57; font-style: italic; margin: 4px 0 0 0;">
              *Výsledky založené na nezávislém spotřebitelském testování při pravidelném používání 10 minut denně.
            </p>
          </div>
        `;
      }
    }

    function runTranslations() {
      updateTransformationStats();

      // Carousel title
      document.querySelectorAll('.jdgm-carousel-title').forEach(el => {
        if (el.textContent.includes('speak for us') || el.textContent.includes('Nechte zákazníky')) {
          el.textContent = 'Co o nás říkají naši zákazníci';
        }
      });

      // Widget title
      document.querySelectorAll('.jdgm-rev-widg__title').forEach(el => {
        if (el.textContent.includes('Customer Reviews')) {
          el.textContent = 'Hodnocení zákazníků';
        }
      });

      // Badge texts
      document.querySelectorAll('.jdgm-prev-badge__text, .jdgm-carousel-title-and-link, .jdgm-rev-widg__summary-text').forEach(el => {
        translateNode(el);
      });

      // Sort dropdown
      document.querySelectorAll('.jdgm-sort-dropdown option').forEach(opt => {
        if (opt.textContent.includes('Most Recent')) opt.textContent = 'Nejnovější';
        if (opt.textContent.includes('Highest Rating')) opt.textContent = 'Nejvyšší hodnocení';
        if (opt.textContent.includes('Lowest Rating')) opt.textContent = 'Nejnižší hodnocení';
        if (opt.textContent.includes('Only Pictures')) opt.textContent = 'Pouze s fotkami';
        if (opt.textContent.includes('Pictures First')) opt.textContent = 'Nejprve s fotkami';
      });

      // Form labels
      document.querySelectorAll('.jdgm-form__label').forEach(el => {
        if (el.textContent.includes('Name')) el.textContent = 'Jméno (zobrazí se veřejně)';
        if (el.textContent.includes('Email')) el.textContent = 'E-mail';
        if (el.textContent.includes('Rating')) el.textContent = 'Hodnocení';
        if (el.textContent.includes('Review Title')) el.textContent = 'Název recenze';
        if (el.textContent.includes('Review') && !el.textContent.includes('Title')) el.textContent = 'Vaše recenze';
      });

      // Submit button
      document.querySelectorAll('.jdgm-submit-rev').forEach(el => {
        if (el.value && el.value.includes('Submit')) el.value = 'Odeslat recenzi';
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', runTranslations);
    } else {
      runTranslations();
    }

    // Observer for asynchronously injected widgets and DOM updates
    const observer = new MutationObserver(function() {
      runTranslations();
    });

    if (document.body) {
      observer.observe(document.body, { childList: true, subtree: true });
    } else {
      document.addEventListener('DOMContentLoaded', function() {
        observer.observe(document.body, { childList: true, subtree: true });
      });
    }
  })();
</script>

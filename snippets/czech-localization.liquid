    window.toggleVeaSkinQuiz = function(el) {
      el.classList.toggle('is-checked');
      var mark = el.querySelector('.product-quiz-check-mark');
      if (el.classList.contains('is-checked')) {
        mark.textContent = '✓';
      } else {
        mark.textContent = '';
      }
      var parent = el.closest('.product-quiz-card');
      if (!parent) return;
      var count = parent.querySelectorAll('.product-quiz-item.is-checked').length;
      var countEl = parent.querySelector('.quiz-live-count');
      if (countEl) countEl.textContent = count;
      var resBox = parent.querySelector('.product-quiz-result');
      if (resBox) {
        resBox.style.display = count === 0 ? 'none' : 'block';
      }
    };


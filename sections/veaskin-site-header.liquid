{% liquid
  assign main_product = all_products['eye-care-machine-household-eye-massager']
  if main_product != blank and main_product.url != blank
    assign base_product_url = main_product.url
  else
    assign base_product_url = '/products/eye-care-machine-household-eye-massager'
  endif

  if request.page_type == 'product'
    assign anchor_prefix = ''
    assign logo_href = '#top'
  else
    assign anchor_prefix = base_product_url
    assign logo_href = base_product_url
  endif
%}

<script
  type="module"
  src="{{ 'cart-icon.js' | asset_url }}"
  fetchpriority="low"
></script>
<script
  type="module"
  src="{{ 'header-actions.js' | asset_url }}"
  fetchpriority="low"
></script>

<div class="vs-site-header-shell" data-vs-header-root>
  <div class="vs-topbar" role="region" aria-label="Důležité informace o dopravě a slevě">
    <div class="vs-topbar__inner">
      <span>🚚 {{ section.settings.shipping_text }}</span>
      <span class="vs-topbar__pill">{{ section.settings.promo_pill }}</span>
      <span class="vs-topbar__hide-sm">🛡️ {{ section.settings.guarantee_text }}</span>
    </div>
  </div>

  <div class="vs-header-sticky">
    <header class="vs-header">
      <div class="vs-header__mobile-left">
        <button
          type="button"
          class="vs-menu-btn"
          aria-label="Otevřít navigaci"
          aria-controls="vs-mobile-nav-drawer"
          aria-expanded="false"
          data-vs-menu-open
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <line x1="3.5" y1="6.5" x2="20.5" y2="6.5"></line>
            <line x1="3.5" y1="12" x2="20.5" y2="12"></line>
            <line x1="3.5" y1="17.5" x2="15.5" y2="17.5"></line>
          </svg>
        </button>
      </div>

      <a href="{{ logo_href }}" class="vs-logo" aria-label="{{ shop.name | default: 'VeaSkin' }} – Domů">
        {%- if settings.logo != blank -%}
          <img
            src="{{ settings.logo | image_url: width: 320 }}"
            alt="{{ shop.name | default: 'VeaSkin' | escape }}"
            class="vs-logo__img"
            width="114"
            height="38"
            loading="eager"
            fetchpriority="high"
          >
        {%- else -%}
          <img
            src="{{ 'logo.png' | asset_url }}"
            alt="{{ shop.name | default: 'VeaSkin' | escape }}"
            class="vs-logo__img"
            width="114"
            height="38"
            loading="eager"
            fetchpriority="high"
          >
        {%- endif -%}
      </a>

      <nav class="vs-desktop-nav" aria-label="Hlavní navigace">
        <ul class="vs-nav">
          <li><a href="{{ anchor_prefix }}#jak-funguje" class="vs-nav__link">4 kroky péče</a></li>
          <li><a href="{{ anchor_prefix }}#technologie" class="vs-nav__link">LED &amp; EMS</a></li>
          <li><a href="{{ anchor_prefix }}#vysledky" class="vs-nav__link">Před a po</a></li>
          <li><a href="{{ anchor_prefix }}#srovnani" class="vs-nav__link">Srovnání</a></li>
          <li><a href="{{ anchor_prefix }}#dotazy" class="vs-nav__link">Časté dotazy</a></li>
        </ul>
      </nav>

      <div class="vs-header__actions">
        <header-actions>
          {%- if settings.cart_type == 'drawer' and template.name != 'cart' -%}
            <button
              type="button"
              class="vs-cart-chip button-unstyled"
              on:click="#cart-drawer/toggle"
              aria-haspopup="dialog"
              aria-expanded="false"
              aria-controls="cart-drawer"
              aria-label="{{ 'accessibility.cart' | t }}"
              aria-describedby="cart-bubble-text"
              data-testid="vs-cart-drawer-trigger"
            >
              <svg
                class="vs-cart-chip__bag"
                width="17"
                height="17"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.9"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <path d="M16 10a4 4 0 0 1-8 0"></path>
              </svg>
              <span class="vs-cart-chip__label">Košík</span>
              <span
                class="vs-cart-chip__count{% if cart.item_count == 0 %} is-empty{% endif %}"
                data-vs-cart-count
                aria-hidden="true"
              >{{ cart.item_count }}</span>
              <cart-icon class="visually-hidden" data-testid="cart-icon">
                {% render 'cart-bubble', limit: 100 %}
              </cart-icon>
            </button>
          {%- else -%}
            <a
              href="{{ routes.cart_url }}"
              class="vs-cart-chip"
              aria-label="{{ 'accessibility.cart' | t }}"
            >
              <svg
                class="vs-cart-chip__bag"
                width="17"
                height="17"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.9"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <path d="M16 10a4 4 0 0 1-8 0"></path>
              </svg>
              <span class="vs-cart-chip__label">Košík</span>
              <span
                class="vs-cart-chip__count{% if cart.item_count == 0 %} is-empty{% endif %}"
                data-vs-cart-count
                aria-hidden="true"
              >{{ cart.item_count }}</span>
              <cart-icon class="visually-hidden" data-testid="cart-icon">
                {% render 'cart-bubble', limit: 100 %}
              </cart-icon>
            </a>
          {%- endif -%}
          <span
            ref="liveRegion"
            class="visually-hidden"
            role="status"
            data-testid="cart-count-live-region"
          ></span>
        </header-actions>
      </div>
    </header>
  </div>

  <dialog
    id="vs-mobile-nav-drawer"
    class="vs-mobile-drawer"
    aria-label="Mobilní navigace"
    data-vs-mobile-drawer
  >
    <div class="vs-mobile-drawer__panel">
      <div class="vs-mobile-drawer__head">
        <a href="{{ logo_href }}" class="vs-logo" data-vs-drawer-link aria-label="{{ shop.name | default: 'VeaSkin' }} – Domů">
          {%- if settings.logo != blank -%}
            <img
              src="{{ settings.logo | image_url: width: 320 }}"
              alt="{{ shop.name | default: 'VeaSkin' | escape }}"
              class="vs-logo__img"
              width="96"
              height="32"
              loading="lazy"
            >
          {%- else -%}
            <img
              src="{{ 'logo.png' | asset_url }}"
              alt="{{ shop.name | default: 'VeaSkin' | escape }}"
              class="vs-logo__img"
              width="96"
              height="32"
              loading="lazy"
            >
          {%- endif -%}
        </a>
        <button
          type="button"
          class="vs-mobile-drawer__close"
          aria-label="Zavřít navigaci"
          data-vs-menu-close
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <line x1="6" y1="6" x2="18" y2="18"></line>
            <line x1="18" y1="6" x2="6" y2="18"></line>
          </svg>
        </button>
      </div>

      <nav class="vs-mobile-drawer__nav" aria-label="Sekce stránky">
        <ul class="vs-mobile-drawer__list">
          <li>
            <a href="{{ anchor_prefix }}#nabidka-box" class="vs-mobile-drawer__link vs-mobile-drawer__link--highlight" data-vs-drawer-link>
              <span>Zvýhodněné sady</span>
              <span class="vs-mobile-drawer__badge">AŽ −42 %</span>
            </a>
          </li>
          <li>
            <a href="{{ anchor_prefix }}#jak-funguje" class="vs-mobile-drawer__link" data-vs-drawer-link>
              <span>4 kroky péče</span>
              <span class="vs-mobile-drawer__arrow" aria-hidden="true">›</span>
            </a>
          </li>
          <li>
            <a href="{{ anchor_prefix }}#technologie" class="vs-mobile-drawer__link" data-vs-drawer-link>
              <span>LED &amp; EMS technologie</span>
              <span class="vs-mobile-drawer__arrow" aria-hidden="true">›</span>
            </a>
          </li>
          <li>
            <a href="{{ anchor_prefix }}#vysledky" class="vs-mobile-drawer__link" data-vs-drawer-link>
              <span>Výsledky Před a po</span>
              <span class="vs-mobile-drawer__arrow" aria-hidden="true">›</span>
            </a>
          </li>
          <li>
            <a href="{{ anchor_prefix }}#srovnani" class="vs-mobile-drawer__link" data-vs-drawer-link>
              <span>Srovnání s krémy</span>
              <span class="vs-mobile-drawer__arrow" aria-hidden="true">›</span>
            </a>
          </li>
          <li>
            <a href="{{ anchor_prefix }}#recenze-sekce" class="vs-mobile-drawer__link" data-vs-drawer-link>
              <span>Ověřené recenze (4,9 ★)</span>
              <span class="vs-mobile-drawer__arrow" aria-hidden="true">›</span>
            </a>
          </li>
          <li>
            <a href="{{ anchor_prefix }}#dotazy" class="vs-mobile-drawer__link" data-vs-drawer-link>
              <span>Časté dotazy</span>
              <span class="vs-mobile-drawer__arrow" aria-hidden="true">›</span>
            </a>
          </li>
        </ul>
      </nav>

      <div class="vs-mobile-drawer__foot">
        <div class="vs-mobile-drawer__perks">
          <span>🚚 Doprava zdarma na vše</span>
          <span>🛡️ 30 dní na vyzkoušení bez rizika</span>
        </div>
        <a href="{{ anchor_prefix }}#nabidka-box" class="vs-cta-btn vs-mobile-drawer__cta" data-vs-drawer-link>
          Vybrat sadu se slevou →
        </a>
      </div>
    </div>
  </dialog>
</div>

{% javascript %}
  (() => {
    const syncExpanded = (open) => {
      document.querySelectorAll('[data-vs-menu-open]').forEach((btn) => {
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
      document.documentElement.style.overflow = open ? 'hidden' : '';
    };

    const syncCartCountBadges = (count) => {
      const n = Number.isFinite(count) && count >= 0 ? count : 0;
      document.querySelectorAll('[data-vs-cart-count]').forEach((badge) => {
        badge.textContent = String(n);
        badge.classList.toggle('is-empty', n === 0);
      });
    };

    const observeNativeCartBubble = () => {
      const bubbleCount = document.querySelector('.vs-site-header-shell cart-icon [ref="cartBubbleCount"]');
      if (!bubbleCount) return;
      const readCount = () => {
        const raw = (bubbleCount.textContent || '').trim();
        const parsed = parseInt(raw, 10);
        if (!Number.isNaN(parsed)) {
          syncCartCountBadges(bubbleCount.classList.contains('hidden') ? 0 : parsed);
        }
      };
      const obs = new MutationObserver(readCount);
      obs.observe(bubbleCount, { childList: true, characterData: true, subtree: true, attributes: true });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', observeNativeCartBubble, { once: true });
    } else {
      observeNativeCartBubble();
    }

    window.addEventListener('pageshow', (event) => {
      if (event.persisted) {
        fetch('/cart.js')
          .then((r) => r.json())
          .then((c) => syncCartCountBadges(c.item_count))
          .catch(() => {});
      }
    });

    document.addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target : null;
      if (!target) return;

      const openBtn = target.closest('[data-vs-menu-open]');
      if (openBtn) {
        const dialog = document.querySelector('[data-vs-mobile-drawer]');
        if (dialog instanceof HTMLDialogElement && !dialog.open) {
          dialog.showModal();
          syncExpanded(true);
        }
        return;
      }

      const closeBtn = target.closest('[data-vs-menu-close]');
      const navLink = target.closest('[data-vs-drawer-link]');
      if (closeBtn || navLink) {
        const dialog = document.querySelector('[data-vs-mobile-drawer]');
        if (dialog instanceof HTMLDialogElement && dialog.open) {
          dialog.close();
          syncExpanded(false);
        }
        return;
      }

      if (target instanceof HTMLDialogElement && target.hasAttribute('data-vs-mobile-drawer')) {
        target.close();
        syncExpanded(false);
      }
    });

    document.addEventListener(
      'close',
      (event) => {
        if (event.target instanceof HTMLDialogElement && event.target.hasAttribute('data-vs-mobile-drawer')) {
          syncExpanded(false);
        }
      },
      true
    );
  })();
{% endjavascript %}

{% schema %}
{
  "name": "VeaSkin Hlavička",
  "settings": [
    {
      "type": "text",
      "id": "shipping_text",
      "label": "Text dopravy",
      "default": "Doprava zdarma na všechny objednávky"
    },
    {
      "type": "text",
      "id": "promo_pill",
      "label": "Zvýrazněný štítek akce",
      "default": "SLEVA AŽ 42 % NA SADY"
    },
    {
      "type": "text",
      "id": "guarantee_text",
      "label": "Text garance",
      "default": "30 dní na vyzkoušení bez rizika"
    }
  ]
}
{% endschema %}

{% liquid
  assign main_product = all_products['led-ems-bryle-na-ocni-okoli']
  if main_product == blank
    assign main_product = collections.all.products.first
  endif
  if main_product != blank and main_product.url != blank
    assign base_product_url = main_product.url
  else
    assign base_product_url = '/products/led-ems-bryle-na-ocni-okoli'
  endif

  assign hdr_variant = main_product.selected_or_first_available_variant
  assign hdr_price = hdr_variant.price | default: 125400
  if hdr_price <= 0
    assign hdr_price = 125400
  endif
  assign hdr_compare = hdr_variant.compare_at_price | default: 0
  if hdr_compare <= hdr_price
    assign hdr_compare = hdr_price
  endif

  if main_product.variants.size >= 3
    assign hdr_p3 = main_product.variants[2].price
    assign hdr_c3 = main_product.variants[2].compare_at_price | default: 0
    if hdr_c3 <= hdr_p3
      assign hdr_c3 = hdr_compare | times: 3
    endif
  else
    assign hdr_p3 = hdr_price | times: 3 | times: 85 | divided_by: 100
    assign hdr_c3 = hdr_compare | times: 3
  endif

  assign max_discount_pct = hdr_c3 | minus: hdr_p3 | times: 100.0 | divided_by: hdr_c3 | round

  assign promo_label = section.settings.promo_text
  if promo_label == blank or promo_label == 'Sleva až 42 % na sady' or promo_label == 'Sleva až 43 % na sady' or promo_label == 'Sleva až 15 % na sady'
    assign promo_label = 'Sleva až ' | append: max_discount_pct | append: ' % na sady'
  endif

  if request.page_type == 'product'
    assign anchor_prefix = ''
    assign logo_href = '#top'
  else
    assign anchor_prefix = base_product_url
    assign logo_href = base_product_url
  endif
%}

<script
  type="module"
  src="{{ 'cart-icon.js' | asset_url }}"
  fetchpriority="low"
></script>
<script
  type="module"
  src="{{ 'header-actions.js' | asset_url }}"
  fetchpriority="low"
></script>


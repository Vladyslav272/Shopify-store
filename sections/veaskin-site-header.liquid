          class="vs-menu-btn"
          aria-label="Otevřít navigaci"
          aria-controls="vs-mobile-nav-drawer"
          aria-expanded="false"
          data-vs-menu-open
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <line x1="3.5" y1="6.5" x2="20.5" y2="6.5"></line>
            <line x1="3.5" y1="12" x2="20.5" y2="12"></line>
            <line x1="3.5" y1="17.5" x2="15.5" y2="17.5"></line>
          </svg>
        </button>
      </div>

      <a href="{{ logo_href }}" class="vs-logo" aria-label="{{ shop.name | default: 'VeaSkin' }} – Domů">
        {%- if settings.logo != blank -%}
          <img
            src="{{ settings.logo | image_url: width: 320 }}"
            alt="{{ shop.name | default: 'VeaSkin' | escape }}"
            class="vs-logo__img"
            width="114"
            height="38"
            loading="eager"
            fetchpriority="high"
          >
        {%- else -%}
          <img
            src="{{ 'logo.png' | asset_url }}"
            alt="{{ shop.name | default: 'VeaSkin' | escape }}"
            class="vs-logo__img"
            width="114"
            height="38"
            loading="eager"
            fetchpriority="high"
          >
        {%- endif -%}
      </a>


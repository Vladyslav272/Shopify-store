{% liquid
  assign product_resource = closest.product | default: product
  assign display_image = section.settings.image | default: product_resource.featured_media.preview_image | default: product_resource.featured_image
  assign bg_color = section.settings.background_color | default: '#FAF5F5'
%}

<div class="product-showcase-section" style="background-color: {{ bg_color }};">
  <div class="product-showcase-wrapper">

    <!-- Header: Heading and text ABOVE image -->
    <div class="product-showcase-header">
      {% if section.settings.kicker != blank %}
        <div class="product-showcase-kicker">
          <span class="product-showcase-kicker-dot"></span>
          {{ section.settings.kicker }}
        </div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="product-showcase-heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="product-showcase-desc">
          <p>{{ section.settings.text }}</p>
        </div>
      {% endif %}
    </div>

    <!-- Body: Image + Details & CTA -->
    <div class="product-showcase-body">

      <!-- Product Image Column -->
      <div class="product-showcase-visual">
        <div class="product-showcase-card">
          {% if display_image != blank %}
            {{ display_image | image_url: width: 900 | image_tag:
              class: 'product-showcase-img',
              loading: 'lazy',
              alt: section.settings.heading | default: product_resource.title | default: 'VeaSkin'
            }}
          {% else %}
            <img src="{{ 'rannikafe.jpg' | asset_url }}" alt="VeaSkin ranní káva a péče" class="product-showcase-img" loading="lazy" />
          {% endif %}

          <div class="product-showcase-badge">
            <span class="product-showcase-stars" aria-hidden="true">★★★★★</span>
            <div class="product-showcase-badge-text">
              <strong>4,9 / 5</strong>
              <span>2 000+ spokojených žen</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Feature Points & CTA Column -->
      <div class="product-showcase-details">
        <!-- Feature Points -->
        <ul class="product-showcase-features" role="list">
          <li class="product-showcase-feature-item">
            <div class="product-showcase-feature-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="12" cy="12" r="10" fill="#c98a7d" fill-opacity="0.15"/>
                <path d="M8 12.3L10.5 14.8L16 9.3" stroke="#c98a7d" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div class="product-showcase-feature-text">
              <strong>Viditelné výsledky již za 14 dní</strong>
              <p>Zjemnění ranních otoků, tmavých kruhů a vyhlazenější oční okolí bez jehel a bolesti.</p>
            </div>
          </li>

          <li class="product-showcase-feature-item">
            <div class="product-showcase-feature-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="12" cy="12" r="10" fill="#c98a7d" fill-opacity="0.15"/>
                <path d="M8 12.3L10.5 14.8L16 9.3" stroke="#c98a7d" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div class="product-showcase-feature-text">
              <strong>30denní garance vrácení zboží</strong>
              <p>Vyzkoušejte v klidu domova. Pokud neuvidíte změnu, vrátíme vám 100 % peněz.</p>
            </div>
          </li>

          <li class="product-showcase-feature-item">
            <div class="product-showcase-feature-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="12" cy="12" r="10" fill="#c98a7d" fill-opacity="0.15"/>
                <path d="M8 12.3L10.5 14.8L16 9.3" stroke="#c98a7d" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div class="product-showcase-feature-text">
              <strong>Doprava zdarma & odeslání do 24 h</strong>
              <p>Bleskové a bezpečné doručení přímo k vašim dveřím s českou zákaznickou podporou.</p>
            </div>
          </li>
        </ul>

        <!-- Action CTA -->
        <div class="product-showcase-actions">
          <a href="{{ section.settings.cta_link | default: '#ProductInformation-template--30716979773814__product-information' }}" class="product-showcase-btn" onclick="var t = document.querySelector('.product-details') || document.querySelector('[id*=\'ProductInformation\']') || document.querySelector('.product-information'); if (t) { var offset = 20; var top = t.getBoundingClientRect().top + window.pageYOffset - offset; window.scrollTo({ top: top, behavior: 'smooth' }); return false; }">
            <span>{{ section.settings.cta_text | default: 'Chci se cítit svěže každé ráno' }}</span>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
          <p class="product-showcase-guarantee-note">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
            <span>Bezpečný nákup • Garance vrácení zboží 30 dní • Česká značka</span>
          </p>
        </div>

      </div>

    </div>
  </div>
</div>

{% stylesheet %}
  .product-showcase-section {
    width: 100%;
    padding: 100px 24px;
    box-sizing: border-box;
    position: relative;
    overflow: hidden;
  }

  .product-showcase-wrapper {
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
  }

  .product-showcase-grid {
    display: grid;
    grid-template-columns: 1fr 1.08fr;
    gap: 64px;
    align-items: center;
  }

  .product-showcase-visual {
    position: relative;
  }

  .product-showcase-card {
    position: relative;
    border-radius: 28px;
    overflow: hidden;
    box-shadow: 0 24px 50px -12px rgba(59, 47, 50, 0.16);
    border: 1px solid rgba(201, 138, 125, 0.25);
    background: radial-gradient(circle at 50% 50%, #ffffff 0%, #faf3f3 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 36px 30px;
    min-height: 440px;
    box-sizing: border-box;
  }

  .product-showcase-img {
    width: 100%;
    height: auto;
    max-height: 480px;
    object-fit: contain;
    display: block;
    border-radius: 20px;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .product-showcase-card:hover .product-showcase-img {
    transform: scale(1.02);
  }

  .product-showcase-placeholder {
    width: 100%;
    max-width: 320px;
    fill: #e8dede;
  }

  .product-showcase-badge {
    position: absolute;
    bottom: 24px;
    left: 24px;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    padding: 12px 18px;
    border-radius: 18px;
    display: flex;
    align-items: center;
    gap: 12px;
    box-shadow: 0 12px 30px rgba(45, 30, 32, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.9);
    z-index: 2;
  }

  .product-showcase-stars {
    color: #e28743;
    letter-spacing: 2px;
    font-size: 1.1rem;
    line-height: 1;
  }

  .product-showcase-badge-text strong {
    display: block;
    font-size: 0.9rem;
    color: #1d1617;
    font-weight: 700;
    line-height: 1.2;
  }

  .product-showcase-badge-text span {
    display: block;
    font-size: 0.78rem;
    color: #837274;
  }

  .product-showcase-kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    background: rgba(201, 138, 125, 0.14);
    color: #c98a7d;
    border-radius: 50px;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 18px;
  }

  .product-showcase-kicker-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #c98a7d;
    box-shadow: 0 0 8px #c98a7d;
  }

  .product-showcase-heading {
    font-size: clamp(2.2rem, 1.8rem + 1.6vw, 3.4rem);
    font-weight: 800;
    line-height: 1.22;
    color: #2b2325;
    margin: 0 0 18px 0;
    letter-spacing: -0.02em;
    text-align: center;
  }

  .product-showcase-heading em {
    font-style: italic;
    font-weight: 400;
    color: #c98a7d;
    display: block;
  }

  .product-showcase-desc {
    font-size: 1.05rem;
    line-height: 1.6;
    color: #5a4b4e;
    margin: 0 0 28px 0;
    text-align: center;
  }

  .product-showcase-desc p {
    margin: 0;
  }

  .product-showcase-features {
    list-style: none;
    padding: 0;
    margin: 0 0 32px 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .product-showcase-feature-item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }

  .product-showcase-feature-icon {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .product-showcase-feature-text strong {
    display: block;
    font-size: 0.98rem;
    color: #2b2325;
    font-weight: 700;
    margin-bottom: 2px;
  }

  .product-showcase-feature-text p {
    font-size: 0.88rem;
    color: #725d57;
    line-height: 1.45;
    margin: 0;
  }

  .product-showcase-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }

  .product-showcase-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 16px 36px;
    background: #2b2325;
    color: #ffffff;
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    border-radius: 50px;
    box-shadow: 0 10px 24px rgba(43, 35, 37, 0.22);
    transition: all 0.3s ease;
    cursor: pointer;
    box-sizing: border-box;
    width: 100%;
    max-width: 440px;
  }

  .product-showcase-btn:hover {
    background: #c98a7d;
    transform: translateY(-2px);
    box-shadow: 0 14px 28px rgba(201, 138, 125, 0.35);
  }

  .product-showcase-guarantee-note {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.82rem;
    color: #837274;
    margin: 0;
  }

  .product-showcase-guarantee-note svg {
    color: #c98a7d;
    flex-shrink: 0;
  }

  @media (max-width: 749px) {
    .product-showcase-section {
      padding: 44px var(--page-margin, 16px) 54px;
      box-sizing: border-box;
    }

    .product-showcase-wrapper,
    .product-showcase-header,
    .product-showcase-heading,
    .product-showcase-desc,
    .product-showcase-body,
    .product-showcase-visual,
    .product-showcase-card,
    .product-showcase-details,
    .product-showcase-actions,
    .product-showcase-btn,
    .product-showcase-features {
      width: 100% !important;
      max-width: 100% !important;
      box-sizing: border-box;
    }

    .product-showcase-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .product-showcase-card {
      padding: 0;
      margin: 0 auto;
      min-height: auto;
    }

    .product-showcase-badge {
      bottom: 12px;
      left: 12px;
      padding: 8px 12px;
    }

    .product-showcase-heading {
      font-size: 1.75rem;
    }

    .product-showcase-desc {
      font-size: 0.96rem;
    }

    .product-showcase-details {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .product-showcase-actions {
      order: 1;
      align-items: center;
      margin-bottom: 26px;
      width: 100%;
    }

    .product-showcase-features {
      order: 2;
      margin: 0;
    }

    .product-showcase-btn {
      max-width: 100%;
    }

    .product-showcase-guarantee-note {
      text-align: center;
      font-size: 0.76rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Produktový showcase",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Barva pozadí",
      "default": "#FAF5F5"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Vlastní obrázek produktu (pokud prázdné, použije se hlavní foto produktu)"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Podtitulek / Kicker",
      "default": "První krok k vaší ranní proměně"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Hlavní nadpis",
      "default": "Vykročte do rána s úsměvem. <em>Stačí jen 10 minut péče.</em>"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text popisu",
      "default": "Probuďte se do dne bez otoků a unavených očí. VeaSkin vám během pár minut vrátí svěžest a ten příjemný pocit, kdy se na sebe do zrcadla s chutí usmějete – i bez kapky make-upu."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Text tlačítka",
      "default": "Chci se cítit svěže každé ráno"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Odkaz tlačítka"
    }
  ],
  "presets": [
    {
      "name": "Produktový showcase"
    }
  ]
}
{% endschema %}

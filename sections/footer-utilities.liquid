{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="background-color: {{ section.settings.background_color | default: 'var(--color-background, #FAF5F5)' }};"
></div>

<div
  class="section section--{{ section.settings.section_width }}{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="
    background-color: {{ section.settings.background_color | default: 'var(--color-background, #FAF5F5)' }};
    border-top: {{ section.settings.divider_thickness | default: 1 }}px solid {{ section.settings.divider_color | default: 'rgba(43, 35, 37, 0.08)' }};
    padding-block-start: {{ section.settings.padding-block-start | default: 48 }}px;
    padding-block-end: {{ section.settings.padding-block-end | default: 40 }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="veaskin-footer">
    <div class="veaskin-footer__main">
      <!-- Left Column: Policy Links -->
      <nav class="veaskin-footer__col-left" aria-label="Právní informace a podmínky">
        <ul class="veaskin-footer__links" role="list">
          <li class="veaskin-footer__link-item">
            <a href="/policies/refund-policy" class="veaskin-footer__link">
              Vrácení zboží & Reklamace
            </a>
          </li>
          <li class="veaskin-footer__link-item">
            <a href="/policies/shipping-policy" class="veaskin-footer__link">
              Doprava & Dodání
            </a>
          </li>
          <li class="veaskin-footer__link-item">
            <a href="/policies/contact-information" class="veaskin-footer__link">
              Kontaktní Údaje
            </a>
          </li>
          <li class="veaskin-footer__link-item">
            <a href="/policies/terms-of-service" class="veaskin-footer__link">
              Obchodní Podmínky
            </a>
          </li>
          <li class="veaskin-footer__link-item">
            <a href="/policies/privacy-policy" class="veaskin-footer__link">
              Ochrana Osobních Údajů
            </a>
          </li>
        </ul>
      </nav>

      <!-- Right Column: Payment Icons (aligned to bottom) -->
      <div class="veaskin-footer__col-right">
        <div class="veaskin-footer__payments">
          <ul class="veaskin-footer__payment-list" role="list" aria-label="Platební metody">
            {%- assign displayed_payments = 'apple_pay,google_pay,master,visa,paypal' | split: ',' -%}
            {%- for type in displayed_payments -%}
              <li class="veaskin-footer__payment-item">
                {{ type | payment_type_svg_tag: class: 'veaskin-footer__payment-svg' }}
              </li>
            {%- endfor -%}
          </ul>
        </div>
      </div>
    </div>

    <!-- Bottom: Copyright -->
    <div class="veaskin-footer__bottom">
      <p class="veaskin-footer__copyright">
        &copy; {{ 'now' | date: '%Y' }}, {{ shop.name }}
      </p>
    </div>
  </div>

  <div class="visually-hidden" style="display: none !important;">
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .veaskin-footer {
    width: 100%;
    color: var(--color-foreground, #2b2325);
  }

  .veaskin-footer__main {
    display: flex;
    flex-direction: column;
    gap: 28px;
    align-items: flex-start;
  }

  @media screen and (min-width: 768px) {
    .veaskin-footer__main {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
      gap: 48px;
    }
  }

  /* Left Column: Policy links */
  .veaskin-footer__col-left {
    flex: 1;
    min-width: 240px;
  }

  .veaskin-footer__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 15px;
    align-items: flex-start;
  }

  .veaskin-footer__link-item {
    margin: 0;
    padding: 0;
  }

  .veaskin-footer__link {
    font-family: var(--font-heading--family, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif);
    font-size: 15px;
    font-weight: 500;
    color: var(--color-foreground, #2b2325);
    text-decoration: none;
    letter-spacing: -0.01em;
    display: inline-block;
    transition: color 0.2s ease, opacity 0.2s ease;
  }

  .veaskin-footer__link:hover {
    color: var(--color-primary-accent, #BB6966);
    opacity: 0.85;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* Right Column: Payments */
  .veaskin-footer__col-right {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  @media screen and (min-width: 768px) {
    .veaskin-footer__col-right {
      align-items: flex-end;
      text-align: end;
      align-self: flex-end;
      padding-bottom: 2px;
    }
  }

  /* Payment Badges */
  .veaskin-footer__payments {
    display: flex;
    align-items: center;
  }

  .veaskin-footer__payment-list {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media screen and (min-width: 768px) {
    .veaskin-footer__payment-list {
      justify-content: flex-end;
    }
  }

  .veaskin-footer__payment-item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .veaskin-footer__payment-svg {
    height: 24px;
    width: auto;
    border-radius: 4px;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
    display: block;
  }

  /* Bottom Copyright */
  .veaskin-footer__bottom {
    margin-top: 36px;
    padding-top: 16px;
    text-align: left;
  }

  .veaskin-footer__copyright {
    margin: 0;
    font-size: 13px;
    color: var(--color-foreground-muted, #725d57);
    opacity: 0.85;
    letter-spacing: 0.01em;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.policies_and_links",
  "tag": "div",
  "class": "footer-utilities",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "#FAF5F5"
    },
    {
      "type": "range",
      "id": "divider_thickness",
      "label": "t:settings.divider_thickness",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 1
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "t:settings.divider_color"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "footer-copyright"
    },
    {
      "type": "footer-policy-list"
    },
    {
      "type": "social-links"
    }
  ],
  "presets": [
    {
      "name": "t:names.policies_and_links",
      "category": "t:categories.footer"
    }
  ]
}
{% endschema %}

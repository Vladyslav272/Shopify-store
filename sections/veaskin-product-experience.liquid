{% liquid
  assign target_product = product
  if target_product == blank
    assign target_product = all_products['led-ems-bryle-na-ocni-okoli']
  endif
  if target_product == blank
    assign target_product = collections.all.products.first
  endif

  assign first_variant = target_product.selected_or_first_available_variant
  assign v1_id = first_variant.id
  assign v1_qty = 1

  assign base_price = first_variant.price | default: 125400
  if base_price <= 0
    assign base_price = 125400
  endif
  assign base_compare = first_variant.compare_at_price | default: 0
  if base_compare <= base_price
    assign base_compare = base_price
  endif

  if target_product.variants.size >= 3
    assign v2_id = target_product.variants[1].id
    assign v2_qty = 1
    assign v3_id = target_product.variants[2].id
    assign v3_qty = 1

    assign p1 = target_product.variants[0].price
    assign c1 = target_product.variants[0].compare_at_price | default: 0
    if c1 <= p1
      assign c1 = p1
    endif

    assign p2 = target_product.variants[1].price
    assign c2 = target_product.variants[1].compare_at_price | default: 0
    if c2 <= p2
      assign c2 = c1 | times: 2
    endif

    assign p3 = target_product.variants[2].price
    assign c3 = target_product.variants[2].compare_at_price | default: 0
    if c3 <= p3
      assign c3 = c1 | times: 3
    endif
  else
    assign v2_id = first_variant.id
    assign v2_qty = 2
    assign v3_id = first_variant.id
    assign v3_qty = 3

    assign p1 = base_price
    assign c1 = base_compare

    assign p2 = base_price | times: 2 | times: 90 | divided_by: 100
    assign c2 = base_compare | times: 2

    assign p3 = base_price | times: 3 | times: 85 | divided_by: 100
    assign c3 = base_compare | times: 3
  endif

  assign p1_fmt = p1 | money_without_trailing_zeros | replace: '.', ' '
  assign c1_fmt = c1 | money_without_trailing_zeros | replace: '.', ' '
  assign p2_fmt = p2 | money_without_trailing_zeros | replace: '.', ' '
  assign c2_fmt = c2 | money_without_trailing_zeros | replace: '.', ' '
  assign p3_fmt = p3 | money_without_trailing_zeros | replace: '.', ' '
  assign c3_fmt = c3 | money_without_trailing_zeros | replace: '.', ' '

  assign save1_raw = c1 | minus: p1
  assign save2_raw = c2 | minus: p2
  assign save3_raw = c3 | minus: p3

  assign d1_pct = save1_raw | times: 100.0 | divided_by: c1 | round
  assign d2_pct = save2_raw | times: 100.0 | divided_by: c2 | round
  assign d3_pct = save3_raw | times: 100.0 | divided_by: c3 | round

  assign save2_fmt = save2_raw | money_without_trailing_zeros | replace: '.', ' '
  assign save3_fmt = save3_raw | money_without_trailing_zeros | replace: '.', ' '

  assign unit2_raw = p2 | divided_by: 2
  assign unit3_raw = p3 | divided_by: 3
  assign unit2_fmt = unit2_raw | money_without_trailing_zeros | replace: '.', ' '
  assign unit3_fmt = unit3_raw | money_without_trailing_zeros | replace: '.', ' '

  assign day1_cents = p1 | divided_by: 365.0 | divided_by: 10.0 | round | times: 10
  assign day2_cents = p2 | divided_by: 2.0 | divided_by: 365.0 | divided_by: 10.0 | round | times: 10
  assign day1_fmt = day1_cents | money | replace: '.', ' '
  assign day2_fmt = day2_cents | money | replace: '.', ' '

  assign p1_cta = p1_fmt | replace: 'Kč', 'KČ'
  assign p2_cta = p2_fmt | replace: 'Kč', 'KČ'
  assign p3_cta = p3_fmt | replace: 'Kč', 'KČ'
  assign save2_cta = save2_fmt | replace: 'Kč', 'KČ'
  assign save3_cta = save3_fmt | replace: 'Kč', 'KČ'

  assign cta1_main = 'PŘIDAT DO KOŠÍKU - ' | append: p1_cta
  assign cta1_sub = '(DOPRAVA ZDARMA)'
  assign cta1_label = cta1_main | append: ' ' | append: cta1_sub

  assign cta2_main = 'PŘIDAT DO KOŠÍKU - ' | append: p2_cta
  assign cta2_sub = '(UŠETŘÍTE ' | append: save2_cta | append: ')'
  assign cta2_label = cta2_main | append: ' ' | append: cta2_sub

  assign cta3_main = 'PŘIDAT DO KOŠÍKU - ' | append: p3_cta
  assign cta3_sub = '(UŠETŘÍTE ' | append: save3_cta | append: ')'
  assign cta3_label = cta3_main | append: ' ' | append: cta3_sub

  if images['zenabilepozadi.jpg'] != blank
    assign hero_img_url = images['zenabilepozadi.jpg'] | image_url: width: 1200
  elsif target_product.featured_image != blank
    assign hero_img_url = target_product.featured_image | image_url: width: 1200
  else
    assign hero_img_url = '/cdn/shop/files/zenabilepozadi.jpg'
  endif

  assign morning_img_url = 'rannikafe.jpg' | asset_url

  if images['krok_1.gif'] != blank
    assign step1_gif_url = images['krok_1.gif'] | image_url
  else
    assign step1_gif_url = '/cdn/shop/files/krok_1.gif'
  endif

  if images['krok_2.gif'] != blank
    assign step2_gif_url = images['krok_2.gif'] | image_url
  else
    assign step2_gif_url = '/cdn/shop/files/krok_2.gif'
  endif

  if images['krok_3.gif'] != blank
    assign step3_gif_url = images['krok_3.gif'] | image_url
  else
    assign step3_gif_url = '/cdn/shop/files/krok_3.gif'
  endif

  if images['krok_4.gif'] != blank
    assign step4_gif_url = images['krok_4.gif'] | image_url
  else
    assign step4_gif_url = '/cdn/shop/files/krok_4.gif'
  endif

  if images['pred.jpg'] != blank
    assign before_img_url = images['pred.jpg'] | image_url: width: 1000
  else
    assign before_img_url = '/cdn/shop/files/pred.jpg'
  endif

  if images['po.jpg'] != blank
    assign after_img_url = images['po.jpg'] | image_url: width: 1000
  else
    assign after_img_url = '/cdn/shop/files/po.jpg'
  endif

  assign product_form_id = 'VeaSkinBundleForm-' | append: section.id
%}

{% render 'theme-drawer-styles' %}
<script
  src="{{ 'product-form.js' | asset_url }}"
  type="module"
></script>

{%- if target_product != blank -%}
  <script type="application/ld+json">
    {{ target_product | structured_data }}
  </script>
{%- endif -%}

<div class="vs-shell" id="veaskin-pdp-v2" data-vs-experience>

  {%- if section.settings.show_trust_bar != false -%}
    {%- assign t_rating = section.settings.trust_rating | default: '4,9/5' -%}
    {%- assign t_count = section.settings.trust_count | default: '2 000+ zákaznic' -%}
    {%- assign t_tagline = section.settings.trust_tagline | default: 'česká značka' -%}
    <aside class="vs-trust-bar">
      <a href="#recenze-sekce" class="vs-trust-bar__link" aria-label="Hodnocení {{ t_rating }} z 5 hvězdiček, {{ t_count }}, {{ t_tagline }}">
        <div class="vs-trust-bar__stars" aria-hidden="true">★★★★★</div>
        <div class="vs-trust-bar__text">
          <span class="vs-trust-bar__rating">{{ t_rating }}</span>
          <span class="vs-trust-bar__dot" aria-hidden="true">·</span>
          <span class="vs-trust-bar__count">{{ t_count }}</span>
          <span class="vs-trust-bar__dot" aria-hidden="true">·</span>
          <span class="vs-trust-bar__origin">{{ t_tagline }}</span>
        </div>
      </a>
    </aside>
  {%- endif -%}

  <!-- 1. RANNÍ PROMĚNA (CENTERED VERTICAL HERO) -->
  <section class="vs-section vs-section--hero{% if section.settings.show_trust_bar != false %} has-trust-bar{% endif %}" id="top">
    <div class="vs-morning-card">
      <div class="vs-morning-content">
        <h1 class="vs-morning-title">Vykročte do rána <span class="vs-highlight">s úsměvem.*</span></h1>
        <h2 class="vs-morning-subtitle">Stačí jen 10 minut péče u ranní kávy.</h2>
        <p class="vs-morning-lead">
          VeaSkin vám během ranní kávy vrátí <strong>svěžest a příjemný pocit</strong>, kdy se na sebe do zrcadla s chutí usmějete – i bez kapky korektoru a make-upu.<br>
          <strong>Šetrně a v pohodlí domova.</strong>
        </p>
        <div class="vs-morning-actions">
          <a href="#nabidka-box" class="vs-cta-btn vs-morning-cta">
            Dopřát si svěží pohled ↓
          </a>
        </div>
        <div class="vs-morning-guarantee">
          <span class="vs-guarantee-icon" aria-hidden="true">🛡️</span>
          <span>30 dní na vyzkoušení – nepomůže, vrátíme peníze</span>
        </div>
      </div>
      <div class="vs-morning-media">
        <img
          src="{{ morning_img_url }}"
          alt="Ranní káva a VeaSkin péče"
          width="900"
          height="600"
          loading="eager"
          fetchpriority="high"
        >
      </div>
      <div class="vs-morning-footnote">*Výsledky se mohou lišit.</div>
    </div>
  </section>

  <!-- 2. HERO GALLERY + TIERED BUNDLE OFFER BUY BOX -->
  <section class="vs-section" id="nabidka">
    <div class="vs-hero-grid">
      <!-- Left: Product Gallery -->
      <div class="vs-gallery-card">
        <div class="vs-main-media">
          <img
            src="{{ hero_img_url }}"
            alt="Brýle proti otokům VeaSkin"
            class="vs-main-media__img"
            width="900"
            height="900"
            loading="eager"
            fetchpriority="high"
            data-vs-main-img
          >
          <div class="vs-media-badge-top">
            <span class="vs-dot-live" aria-hidden="true"></span>
            <span>630-660 nm Červené LED + EMS</span>
          </div>
        </div>

        <div class="vs-thumbs" role="group" aria-label="Galerie obrázků produktu">
          <button
            type="button"
            class="vs-thumb-btn is-active"
            aria-pressed="true"
            aria-label="Zobrazit hlavní fotografii Brýle proti otokům"
            data-vs-thumb="{{ hero_img_url }}"
          >
            <img src="{{ hero_img_url }}" alt="Brýle proti otokům" width="180" height="180" loading="eager">
          </button>
          <button
            type="button"
            class="vs-thumb-btn"
            aria-pressed="false"
            aria-label="Zobrazit ranní rituál s kávou"
            data-vs-thumb="{{ morning_img_url }}"
          >
            <img src="{{ morning_img_url }}" alt="Ranní rituál s kávou" width="180" height="180" loading="lazy">
          </button>
          <button
            type="button"
            class="vs-thumb-btn"
            aria-pressed="false"
            aria-label="Zobrazit ukázku použití"
            data-vs-thumb="{{ step4_gif_url }}"
          >
            <img src="{{ step4_gif_url }}" alt="Ukázka použití" width="180" height="180" loading="lazy">
          </button>
          <button
            type="button"
            class="vs-thumb-btn"
            aria-pressed="false"
            aria-label="Zobrazit výsledek péče"
            data-vs-thumb="{{ after_img_url }}"
          >
            <img src="{{ after_img_url }}" alt="Výsledek péče" width="180" height="180" loading="lazy">
          </button>
        </div>
      </div>

      <!-- Right: Buy Box & Tiered Bundle Selector -->
      <div class="vs-buy-panel" id="nabidka-box">
        <a href="#recenze-sekce" class="vs-review-pill" aria-label="Hodnocení 4,9 z 5 hvězdiček na základě 150+ recenzí">
          <span class="vs-stars" aria-hidden="true">★★★★★</span>
          <span class="vs-review-pill__text">
            <span>4,9 / 5 • 150+ ověřených recenzí</span>
            <span class="vs-review-pill__extra"> (2 000+ spokojených žen)</span>
          </span>
        </a>

        <h1 class="vs-product-title">{{ section.settings.product_heading }}</h1>
        <p class="vs-product-lead">
          Probuďte se do dne bez ranních otoků, váčků a tmavých kruhů pod očima. Cílené červené světlo a jemné EMS mikroproudy rozhýbou lymfu a zpevní oční okolí za pouhých <strong>10 minut denně</strong> - bez jehel a rekonvalescence.
        </p>

        <div class="vs-quick-tags">
          <span class="vs-quick-tag">✓ Redukce ranních otoků a váčků</span>
          <span class="vs-quick-tag">✓ Zesvětlení tmavých kruhů</span>
          <span class="vs-quick-tag">✓ Vyhlazení jemných vrásek</span>
        </div>

        <div class="vs-offer-head">
          <span class="vs-offer-head__title">Vyberte si nabídku:</span>
          <span class="vs-offer-head__badge">🔥 Sleva až {{ d3_pct }} % na sady</span>
        </div>

        <div class="vs-offer-list" role="radiogroup" aria-label="Zvýhodněné sady Brýlí proti otokům">
          <!-- Option 1 -->
          <button
            type="button"
            class="vs-offer-option"
            role="radio"
            aria-checked="false"
            data-vs-offer
            data-variant-id="{{ v1_id }}"
            data-qty="{{ v1_qty }}"
            data-bundle-label="1× Brýle - Ranní péče"
            data-cta-main="{{ cta1_main | escape }}"
            data-cta-sub="{{ cta1_sub | escape }}"
            data-cta-label="{{ cta1_label | escape }}"
          >
            <div class="vs-offer-left">
              <span class="vs-radio-dot" aria-hidden="true"></span>
              <div>
                <div class="vs-offer-name">1× Brýle proti otokům - Ranní péče</div>
                {%- if d1_pct > 0 -%}
                  <span class="vs-offer-perk">
                    <span class="vs-perk-line">Sleva {{ d1_pct }}&nbsp;%</span>
                    <span class="vs-perk-sep">•</span>
                    <span class="vs-perk-line">Doprava zdarma</span>
                  </span>
                {%- else -%}
                  <span class="vs-offer-perk">
                    <span class="vs-perk-line">✓ Doprava zdarma</span>
                    <span class="vs-perk-sep">•</span>
                    <span class="vs-perk-line">30&nbsp;dní na&nbsp;vyzkoušení</span>
                  </span>
                {%- endif -%}
              </div>
            </div>
            <div class="vs-offer-right">
              <div class="vs-offer-price">{{ p1_fmt }}</div>
              {%- if c1 > p1 -%}
                <div class="vs-offer-old">{{ c1_fmt }}</div>
              {%- endif -%}
            </div>
          </button>

          <!-- Option 2 (Default Selected) -->
          <button
            type="button"
            class="vs-offer-option is-selected"
            role="radio"
            aria-checked="true"
            data-vs-offer
            data-variant-id="{{ v2_id }}"
            data-qty="{{ v2_qty }}"
            data-bundle-label="2× Brýle - Rituál ve dvou"
            data-cta-main="{{ cta2_main | escape }}"
            data-cta-sub="{{ cta2_sub | escape }}"
            data-cta-label="{{ cta2_label | escape }}"
          >
            <span class="vs-offer-ribbon">Nejoblíbenější • −{{ d2_pct }} %</span>
            <div class="vs-offer-left">
              <span class="vs-radio-dot" aria-hidden="true"></span>
              <div>
                <div class="vs-offer-name">2× Brýle proti otokům - Rituál ve dvou</div>
                <span class="vs-offer-perk">
                  <span class="vs-perk-line">+ Ušetříte {{ save2_fmt | replace: ' ', '&nbsp;' }}</span>
                  <span class="vs-perk-sep">•</span>
                  <span class="vs-perk-line">{{ unit2_fmt | replace: ' ', '&nbsp;' }}&nbsp;/&nbsp;kus</span>
                </span>
              </div>
            </div>
            <div class="vs-offer-right">
              <div class="vs-offer-price">{{ p2_fmt }}</div>
              {%- if c2 > p2 -%}
                <div class="vs-offer-old">{{ c2_fmt }}</div>
              {%- endif -%}
            </div>
          </button>

          <!-- Option 3 -->
          <button
            type="button"
            class="vs-offer-option"
            role="radio"
            aria-checked="false"
            data-vs-offer
            data-variant-id="{{ v3_id }}"
            data-qty="{{ v3_qty }}"
            data-bundle-label="3× Brýle - Rodinná & dárková sada"
            data-cta-main="{{ cta3_main | escape }}"
            data-cta-sub="{{ cta3_sub | escape }}"
            data-cta-label="{{ cta3_label | escape }}"
          >
            <span class="vs-offer-ribbon vs-offer-ribbon--dark">Nejvýhodnější −{{ d3_pct }} %</span>
            <div class="vs-offer-left">
              <span class="vs-radio-dot" aria-hidden="true"></span>
              <div>
                <div class="vs-offer-name">3× Brýle proti otokům - Rodinná &amp; dárková sada</div>
                <span class="vs-offer-perk">
                  <span class="vs-perk-line">+ Ušetříte {{ save3_fmt | replace: ' ', '&nbsp;' }}</span>
                  <span class="vs-perk-sep">•</span>
                  <span class="vs-perk-line">{{ unit3_fmt | replace: ' ', '&nbsp;' }}&nbsp;/&nbsp;kus</span>
                </span>
              </div>
            </div>
            <div class="vs-offer-right">
              <div class="vs-offer-price">{{ p3_fmt }}</div>
              {%- if c3 > p3 -%}
                <div class="vs-offer-old">{{ c3_fmt }}</div>
              {%- endif -%}
            </div>
          </button>
        </div>

        <div class="vs-bonus-bar">
          <span>🎁 <strong>Součástí nabídky:</strong> Doprava zdarma + 30denní garance vrácení peněz</span>
          <span class="vs-bonus-tag">ZDARMA</span>
        </div>

        {%- if target_product != blank -%}
          <product-form-component
            data-section-id="{{ section.id }}"
            data-product-id="{{ target_product.id }}"
            data-product-url="{{ target_product.url }}"
            on:submit="/handleSubmit"
            data-quantity-default="{{ v2_qty }}"
            data-quantity-error-max="{{ 'products.product.quantity_error_max' | t }}"
          >
            <div
              class="visually-hidden"
              aria-live="assertive"
              role="status"
              aria-atomic="true"
              ref="liveRegion"
            ></div>
            {%- form 'product', target_product, id: product_form_id, data-type: 'add-to-cart-form' -%}
              <input
                type="hidden"
                name="id"
                ref="variantId"
                value="{{ v2_id }}"
                data-vs-form-id
              >
              <input
                type="hidden"
                name="quantity"
                value="{{ v2_qty }}"
                data-vs-form-qty
              >
              <span class="product-form-text__error hidden" ref="addToCartTextError">
                <span class="svg-wrapper">
                  {{- 'icon-error.svg' | inline_asset_content -}}
                </span>
              </span>
              <button
                type="submit"
                name="add"
                class="vs-cta-btn"
                data-vs-cta-btn
                {% unless first_variant.available %}disabled{% endunless %}
              >
                {%- if first_variant.available -%}
                  <span class="vs-cta-btn__main" data-vs-cta-main>{{ cta2_main }}</span>
                  <span class="vs-cta-btn__sub" data-vs-cta-sub>{{ cta2_sub }}</span>
                {%- else -%}
                  <span class="vs-cta-btn__main">VYPRODÁNO</span>
                {%- endif -%}
              </button>
            {%- endform -%}
          </product-form-component>
        {%- endif -%}

        <div class="vs-usp-grid">
          <div class="vs-usp-item"><span class="vs-usp-item__icon" aria-hidden="true">⚡</span>LED &amp; EMS PÉČE</div>
          <div class="vs-usp-item"><span class="vs-usp-item__icon" aria-hidden="true">⏱️</span>10 MIN DENNĚ</div>
          <div class="vs-usp-item"><span class="vs-usp-item__icon" aria-hidden="true">🌿</span>100% BEZPEČNÉ</div>
          <div class="vs-usp-item"><span class="vs-usp-item__icon" aria-hidden="true">📦</span>DOPRAVA ZDARMA</div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. RYCHLÁ SEBEDIAGNOSTIKA -->
  <section class="vs-section">
    <div class="vs-quiz-card" data-vs-quiz>
      <div class="vs-center-head">
        <span class="vs-kicker">🩺 Rychlá sebediagnostika</span>
        <h2 class="vs-heading">Trápí vás některý z těchto projevů?</h2>
        <p class="vs-sub">Označte příznaky, které u sebe pozorujete, a zjistěte, kde je jejich skutečný fyziologický původ.</p>
      </div>

      <div class="vs-symptom-grid">
        <button type="button" class="vs-symptom-btn" role="checkbox" aria-checked="false" data-vs-symptom>
          <span class="vs-symptom-box" aria-hidden="true">✓</span>
          <span>Ranní otoky očních víček a váčky po probuzení</span>
        </button>
        <button type="button" class="vs-symptom-btn" role="checkbox" aria-checked="false" data-vs-symptom>
          <span class="vs-symptom-box" aria-hidden="true">✓</span>
          <span>Tmavé kruhy pod očima, které nezakryje ani korektor</span>
        </button>
        <button type="button" class="vs-symptom-btn" role="checkbox" aria-checked="false" data-vs-symptom>
          <span class="vs-symptom-box" aria-hidden="true">✓</span>
          <span>Jemné vrásky a unavená, dehydratovaná pleť očního okolí</span>
        </button>
        <button type="button" class="vs-symptom-btn" role="checkbox" aria-checked="false" data-vs-symptom>
          <span class="vs-symptom-box" aria-hidden="true">✓</span>
          <span>Pocit pálení, těžkosti a suchých očí po práci u obrazovky</span>
        </button>
        <button type="button" class="vs-symptom-btn vs-symptom-btn--wide" role="checkbox" aria-checked="false" data-vs-symptom>
          <span class="vs-symptom-box" aria-hidden="true">✓</span>
          <span>Běžné oční krémy přinášejí jen krátkodobý nebo nulový efekt</span>
        </button>
      </div>

      <div class="vs-diagnosis-banner is-empty" aria-live="polite">
        <div class="vs-diag-prompt" data-vs-diag-prompt>
          <span class="vs-diag-prompt__icon" aria-hidden="true">👆</span>
          <span>Pro zobrazení výsledků a příčiny zaškrtněte alespoň jeden projev výše</span>
        </div>
        <div class="vs-diag-result" data-vs-diag-result hidden>
          <strong data-vs-diag-headline>Proč běžné krémy samy o sobě nestačí:</strong>

{% javascript %}
  document.addEventListener('click', (event) => {
    const target = event.target instanceof Element ? event.target : null;
    if (!target) return;

    // 1. Thumbnail switcher
    const thumbBtn = target.closest('[data-vs-thumb]');
    if (thumbBtn) {
      const root = thumbBtn.closest('[data-vs-experience]');
      const mainImg = root?.querySelector('[data-vs-main-img]');
      const url = thumbBtn.getAttribute('data-vs-thumb');
      if (mainImg && url) {
        mainImg.setAttribute('src', url);
        root.querySelectorAll('[data-vs-thumb]').forEach((btn) => {
          const active = btn === thumbBtn;
          btn.classList.toggle('is-active', active);
          btn.setAttribute('aria-pressed', active ? 'true' : 'false');
        });
      }
      return;
    }

    // 2. Bundle Offer selector
    const offerBtn = target.closest('[data-vs-offer]');
    if (offerBtn) {
      const root = offerBtn.closest('[data-vs-experience]');
      if (!root) return;
      root.querySelectorAll('[data-vs-offer]').forEach((opt) => {
        const selected = opt === offerBtn;
        opt.classList.toggle('is-selected', selected);
        opt.setAttribute('aria-checked', selected ? 'true' : 'false');
      });

      const variantId = offerBtn.getAttribute('data-variant-id');
      const qty = offerBtn.getAttribute('data-qty');
      const ctaLabel = offerBtn.getAttribute('data-cta-label');

      const idInput = root.querySelector('[data-vs-form-id]');
      const qtyInput = root.querySelector('[data-vs-form-qty]');
      const ctaBtn = root.querySelector('[data-vs-cta-btn]');

      if (idInput && variantId) idInput.value = variantId;
      if (qtyInput && qty) qtyInput.value = qty;
      if (ctaBtn && !ctaBtn.hasAttribute('disabled')) {
        const ctaMain = offerBtn.getAttribute('data-cta-main');
        const ctaSub = offerBtn.getAttribute('data-cta-sub');
        const ctaMainEl = root.querySelector('[data-vs-cta-main]');
        const ctaSubEl = root.querySelector('[data-vs-cta-sub]');
        if (ctaMainEl && ctaMain) {
          ctaMainEl.textContent = ctaMain;
        } else if (ctaBtn && ctaLabel) {
          ctaBtn.textContent = ctaLabel;
        }
        if (ctaSubEl) {
          ctaSubEl.textContent = ctaSub || '';
        }
      }
      return;
    }

    // 3. Symptom Diagnostic checkboxes
    const symptomBtn = target.closest('[data-vs-symptom]');
    if (symptomBtn) {
      const quizCard = symptomBtn.closest('[data-vs-quiz]');
      if (!quizCard) return;
      const nowChecked = !symptomBtn.classList.contains('is-checked');
      symptomBtn.classList.toggle('is-checked', nowChecked);
      symptomBtn.setAttribute('aria-checked', nowChecked ? 'true' : 'false');

      const count = quizCard.querySelectorAll('[data-vs-symptom].is-checked').length;
      const banner = quizCard.querySelector('.vs-diagnosis-banner');
      const promptEl = quizCard.querySelector('[data-vs-diag-prompt]');
      const resultEl = quizCard.querySelector('[data-vs-diag-result]');
      const headline = quizCard.querySelector('[data-vs-diag-headline]');

      if (banner && promptEl && resultEl) {
        if (count === 0) {
          banner.classList.add('is-empty');
          promptEl.hidden = false;
          resultEl.hidden = true;
        } else {
          banner.classList.remove('is-empty');
          promptEl.hidden = true;
          resultEl.hidden = false;
          if (headline) {
            if (count === 1) {
              headline.textContent = 'Označen 1 z 5 projevů - Proč běžné krémy samy o sobě nestačí:';
            } else if (count < 5) {
              headline.textContent = `Označeny ${count} z 5 projevů - Proč běžné krémy samy o sobě nestačí:`;
            } else {
              headline.textContent = 'Označeno 5 z 5 projevů - Proč běžné krémy samy o sobě nestačí:';
            }
          }
        }
      }
    }
  });

  // 4. Interactive Before / After range slider
  document.addEventListener('input', (event) => {
    const input = event.target instanceof HTMLInputElement ? event.target : null;
    if (!input || !input.hasAttribute('data-vs-ba-range')) return;
    const viewer = input.closest('[data-vs-ba-viewer]');
    if (!viewer) return;
    const val = Number(input.value);
    const beforeImg = viewer.querySelector('[data-vs-ba-before]');
    const line = viewer.querySelector('[data-vs-ba-line]');
    const knob = viewer.querySelector('[data-vs-ba-knob]');
    if (beforeImg instanceof HTMLElement) {
      beforeImg.style.clipPath = `inset(0 ${100 - val}% 0 0)`;
    }
    if (line instanceof HTMLElement) {
      line.style.left = `${val}%`;
    }
    if (knob instanceof HTMLElement) {
      knob.style.left = `${val}%`;
    }
  });
{% endjavascript %}


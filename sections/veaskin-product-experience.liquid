{% javascript %}
  (() => {
    const formatKc = (val) => `${Math.round(val).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ' ')} Kč`;

    const updateQuantityState = (root, rawQty) => {
      if (!root) return;
      const qty = Math.max(1, Math.min(10, parseInt(String(rawQty), 10) || 1));

      const p1 = Number(root.getAttribute('data-p1-kc')) || 1835;
      const c1 = Number(root.getAttribute('data-c1-kc')) || 2621;

      const totalPrice = p1 * qty;
      const totalCompare = c1 * qty;

      const priceFmt = formatKc(totalPrice);
      const compareFmt = formatKc(totalCompare);

      const qtyDisplayInput = root.querySelector('[data-vs-qty-input]');
      const formQtyInput = root.querySelector('[data-vs-form-qty]');
      const priceCurrentEl = root.querySelector('[data-vs-price-current]');
      const priceCompareEl = root.querySelector('[data-vs-price-compare]');
      const ctaLabelEl = root.querySelector('[data-vs-cta-label]');
      const stickyPriceEl = root.querySelector('[data-vs-sticky-price]');

      if (qtyDisplayInput instanceof HTMLInputElement) {
        qtyDisplayInput.value = String(qty);
      }
      if (formQtyInput instanceof HTMLInputElement) {
        formQtyInput.value = String(qty);
      }
      if (priceCurrentEl) {
        priceCurrentEl.textContent = priceFmt;
      }
      if (priceCompareEl) {
        priceCompareEl.textContent = compareFmt;
      }
      if (ctaLabelEl) {
        ctaLabelEl.textContent = `PŘIDAT DO KOŠÍKU - ${priceFmt}`;
      }
      if (stickyPriceEl) {
        stickyPriceEl.textContent = priceFmt;
      }
    };

    document.addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target : null;
      if (!target) return;

      // 1. Přepínání fotografií v galerii
      const thumbBtn = target.closest('[data-vs-thumb]');
      if (thumbBtn) {
        const root = thumbBtn.closest('[data-vs-experience]');
        const mainImg = root?.querySelector('[data-vs-main-img]');
        const url = thumbBtn.getAttribute('data-vs-thumb');
        if (mainImg && url) {
          mainImg.setAttribute('src', url);
          root.querySelectorAll('[data-vs-thumb]').forEach((btn) => {
            const active = btn === thumbBtn;
            btn.classList.toggle('is-active', active);
            btn.setAttribute('aria-pressed', active ? 'true' : 'false');
          });
        }
        return;
      }

      // 2. Tlačítka [ - ] a [ + ] u voliče množství
      const stepBtn = target.closest('[data-vs-qty-step]');
      if (stepBtn) {
        const root = stepBtn.closest('[data-vs-experience]');
        const qtyInput = root?.querySelector('[data-vs-qty-input]');
        const delta = parseInt(stepBtn.getAttribute('data-vs-qty-step') || '0', 10);
        const current = qtyInput instanceof HTMLInputElement ? parseInt(qtyInput.value, 10) || 1 : 1;
        updateQuantityState(root, current + delta);
        return;
      }

      // 3. Plynulé odscrollování k nákupní zóně
      const scrollTrigger = target.closest('[data-vs-sticky-cta], [data-vs-scroll-buy]');
      if (scrollTrigger) {
        event.preventDefault();
        const buyZone = document.querySelector('#nabidka-box');
        if (buyZone) {
          buyZone.scrollIntoView({ behavior: 'smooth', block: 'start' });
          buyZone.classList.add('is-highlighted');
          setTimeout(() => buyZone.classList.remove('is-highlighted'), 950);
        }
      }
    });

    // Ruční přepsání čísla v poli počtu kusů
    document.addEventListener('change', (event) => {
      const input = event.target instanceof HTMLInputElement ? event.target : null;
      if (!input || !input.hasAttribute('data-vs-qty-input')) return;
      const root = input.closest('[data-vs-experience]');
      updateQuantityState(root, input.value);
    });

    // Volitelné automatické přidání digitálního produktu e-booku (0 Kč), pokud je spárován v editoru
    document.addEventListener('submit', (event) => {
      const form = event.target instanceof HTMLFormElement ? event.target : null;
      if (!form || form.getAttribute('data-type') !== 'add-to-cart-form') return;
      const root = form.closest('[data-vs-experience]');
      const ebookVarId = root?.getAttribute('data-ebook-variant-id');
      if (!ebookVarId) return;

      setTimeout(async () => {
        try {
          const cartRes = await fetch('/cart.js');
          if (cartRes.ok) {
            const cartData = await cartRes.json();
            const alreadyInCart = (cartData.items || []).some((item) => String(item.variant_id) === String(ebookVarId));
            if (alreadyInCart) return;
          }
          await fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ items: [{ id: Number(ebookVarId), quantity: 1 }] }),
          });
        } catch {
          // E-book je doručen automaticky e-mailem
        }
      }, 280);
    });

    // Interaktivní posuvník Před / Po
    document.addEventListener('input', (event) => {
      const input = event.target instanceof HTMLInputElement ? event.target : null;
      if (!input || !input.hasAttribute('data-vs-ba-range')) return;
      const viewer = input.closest('[data-vs-ba-viewer]');
      if (!viewer) return;
      const val = Number(input.value);
      const beforeImg = viewer.querySelector('[data-vs-ba-before]');
      const line = viewer.querySelector('[data-vs-ba-line]');
      const knob = viewer.querySelector('[data-vs-ba-knob]');
      if (beforeImg instanceof HTMLElement) {
        beforeImg.style.clipPath = `inset(0 ${100 - val}% 0 0)`;
      }
      if (line instanceof HTMLElement) {
        line.style.left = `${val}%`;
      }
      if (knob instanceof HTMLElement) {
        knob.style.left = `${val}%`;
      }
    });

    // Zobrazení dokované spodní lišty po odscrollování z Buy Boxu
    const initStickyBar = () => {
      const stickyBar = document.querySelector('[data-vs-sticky-bar]');
      const buyBox = document.querySelector('#nabidka-box');
      if (!stickyBar || !buyBox) return;

      const checkVisibility = () => {
        const rect = buyBox.getBoundingClientRect();
        const isInView = rect.top < window.innerHeight && rect.bottom > 80;
        if (!isInView && window.scrollY > 320) {
          stickyBar.classList.add('is-visible');
        } else {
          stickyBar.classList.remove('is-visible');
        }
      };

      window.addEventListener('scroll', checkVisibility, { passive: true });
      checkVisibility();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initStickyBar, { once: true });
    } else {
      initStickyBar();
    }
  })();

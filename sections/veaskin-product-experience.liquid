{% liquid
  assign target_product = product
  if target_product == blank
    assign target_product = all_products['led-ems-bryle-na-ocni-okoli']
  endif
  if target_product == blank
    assign target_product = collections.all.products.first
  endif

  assign first_variant = target_product.selected_or_first_available_variant
  assign v1_id = first_variant.id

  assign raw_price = first_variant.price | default: 132900
  assign raw_compare = first_variant.compare_at_price | default: 0

  if raw_compare > raw_price
    assign c_base = raw_compare
    assign p_base = raw_price
  else
    assign p_base = 132900
    assign c_base = 189900
  endif

  assign save_raw = c_base | minus: p_base
  assign p_base_fmt = p_base | money_without_trailing_zeros | replace: '.', ' '
  assign c_base_fmt = c_base | money_without_trailing_zeros | replace: '.', ' '
  assign save_fmt = save_raw | money_without_trailing_zeros | replace: '.', ' '

  if images['zenabilepozadi.jpg'] != blank
    assign hero_img_url = images['zenabilepozadi.jpg'] | image_url: width: 1200
  elsif target_product.featured_image != blank
    assign hero_img_url = target_product.featured_image | image_url: width: 1200
  else
    assign hero_img_url = '/cdn/shop/files/zenabilepozadi.jpg'
  endif

  assign morning_img_url = 'rannikafe.jpg' | asset_url

  if images['krok_1.gif'] != blank
    assign step1_gif_url = images['krok_1.gif'] | image_url
  else
    assign step1_gif_url = '/cdn/shop/files/krok_1.gif'
  endif

  if images['krok_2.gif'] != blank
    assign step2_gif_url = images['krok_2.gif'] | image_url
  else
    assign step2_gif_url = '/cdn/shop/files/krok_2.gif'
  endif

  if images['krok_3.gif'] != blank
    assign step3_gif_url = images['krok_3.gif'] | image_url
  else
    assign step3_gif_url = '/cdn/shop/files/krok_3.gif'
  endif

  if images['krok_4.gif'] != blank
    assign step4_gif_url = images['krok_4.gif'] | image_url
  else
    assign step4_gif_url = '/cdn/shop/files/krok_4.gif'
  endif

  if images['pred.jpg'] != blank
    assign before_img_url = images['pred.jpg'] | image_url: width: 1000
  else
    assign before_img_url = '/cdn/shop/files/pred.jpg'
  endif

  if images['po.jpg'] != blank
    assign after_img_url = images['po.jpg'] | image_url: width: 1000
  else
    assign after_img_url = '/cdn/shop/files/po.jpg'
  endif

  assign product_form_id = 'VeaSkinBundleForm-' | append: section.id
%}

{% render 'theme-drawer-styles' %}
<script
  src="{{ 'product-form.js' | asset_url }}"
  type="module"
></script>

{%- if target_product != blank -%}
  <script type="application/ld+json">
    {{ target_product | structured_data }}
  </script>
{%- endif -%}

<div class="vs-shell" id="veaskin-pdp-v2" data-vs-experience>

  {%- if section.settings.show_trust_bar != false -%}
    {%- assign t_rating = section.settings.trust_rating | default: '4,9/5' -%}
    {%- assign t_count = section.settings.trust_count | default: '180+ ověřených recenzí' -%}
    {%- assign t_tagline = section.settings.trust_tagline | default: 'Doprava zdarma' -%}
    <aside class="vs-trust-bar">
      <a href="#recenze-sekce" class="vs-trust-bar__link" aria-label="Hodnocení {{ t_rating }} z 5 hvězdiček, {{ t_count }}, {{ t_tagline }}">
        <div class="vs-trust-bar__content">
          <div class="vs-trust-bar__item vs-trust-bar__item--rating">
            <span class="vs-trust-bar__stars" aria-hidden="true">★★★★★</span>
            <span class="vs-trust-bar__rating">{{ t_rating }}</span>
            <span class="vs-trust-bar__dot" aria-hidden="true">·</span>
            <span class="vs-trust-bar__count">{{ t_count }}</span>
          </div>
          <span class="vs-trust-bar__sep" aria-hidden="true">·</span>
          <div class="vs-trust-bar__item vs-trust-bar__item--perk">
            <span class="vs-trust-bar__origin">{{ t_tagline }}</span>
          </div>
        </div>
      </a>
    </aside>
  {%- endif -%}

  <!-- 1. MASTER LUXURY HERO (GALLERY + BUY BOX WITH RITUAL BUNDLES) -->
  <section class="vs-section vs-section--hero" id="top">
    <div class="vs-hero-grid" id="nabidka">
      <!-- Left: Gallery Card -->
      <div class="vs-gallery-card">
        <div class="vs-main-media">
          <img
            src="{{ hero_img_url }}"
            alt="LED & EMS Brýle na oční okolí VeaSkin"
            class="vs-main-media__img"
            width="900"
            height="900"
            loading="eager"
            fetchpriority="high"
            data-vs-main-img
          >
          <div class="vs-media-badge-top">
            <span class="vs-dot-live" aria-hidden="true"></span>
            <span>660 nm Červené LED &amp; EMS mikroproudy</span>
          </div>
        </div>

        <div class="vs-thumbs" role="tablist" aria-label="Galerie produktu">
          <button
            type="button"
            class="vs-thumb-btn is-active"
            data-vs-thumb="{{ hero_img_url }}"
            aria-label="Zobrazit přístroj"
            aria-pressed="true"
          >
            <img src="{{ hero_img_url }}" alt="Přístroj VeaSkin" width="120" height="120" loading="eager">
          </button>
          <button
            type="button"
            class="vs-thumb-btn"
            data-vs-thumb="{{ morning_img_url }}"
            aria-label="Zobrazit ranní rituál"
            aria-pressed="false"
          >
            <img src="{{ morning_img_url }}" alt="Ranní rituál s kávou" width="120" height="120" loading="lazy">
          </button>
          <button
            type="button"
            class="vs-thumb-btn"
            data-vs-thumb="{{ after_img_url }}"
            aria-label="Zobrazit klinický výsledek"
            aria-pressed="false"
          >
            <img src="{{ after_img_url }}" alt="Výsledek po aplikaci" width="120" height="120" loading="lazy">
          </button>
          <button
            type="button"
            class="vs-thumb-btn"
            data-vs-thumb="{{ step1_gif_url }}"
            aria-label="Zobrazit aplikaci péče"
            aria-pressed="false"
          >
            <img src="{{ step1_gif_url }}" alt="Aplikace péče" width="120" height="120" loading="lazy">
          </button>
        </div>
      </div>

      <!-- Right: Buy Box & Tiered Bundle Selector -->
      <div class="vs-buy-panel" id="nabidka-box">
        <a href="#recenze-sekce" class="vs-review-pill" aria-label="Hodnocení 4,9 z 5 hvězdiček na základě 180+ recenzí">
          <span class="vs-stars" aria-hidden="true">★★★★★</span>
          <span class="vs-review-pill__text">
            <span>4,9 / 5 • 180+ ověřených recenzí</span>
            <span class="vs-review-pill__extra"> (2 000+ spokojených žen)</span>
          </span>
        </a>

        <h1 class="vs-product-title">{{ section.settings.product_heading | default: 'LED & EMS Brýle na oční okolí' }}</h1>

        <p class="vs-product-lead">
          Cílená lymfatická mikromasáž a fotonové 660 nm červené světlo pro svěží, odpočatý pohled bez ranních otoků a tmavých stínů. Stačí 10 minut u ranní kávy.
        </p>

        <div class="vs-product-features">
          <div class="vs-feature-item">
            <span class="vs-feature-icon" aria-hidden="true">✓</span>
            <div class="vs-feature-text">
              <div class="vs-feature-title">Cílená lymfatická mikromasáž proti ranním otokům a váčkům</div>
            </div>
          </div>
          <div class="vs-feature-item">
            <span class="vs-feature-icon" aria-hidden="true">✓</span>
            <div class="vs-feature-text">
              <div class="vs-feature-title">660 nm červené fotonové LED světlo stimulující tvorbu kolagenu</div>
            </div>
          </div>
          <div class="vs-feature-item">
            <span class="vs-feature-icon" aria-hidden="true">✓</span>
            <div class="vs-feature-text">
              <div class="vs-feature-title">Příjemná jemná termoterapie pro uvolnění unavených očí</div>
            </div>
          </div>
          <div class="vs-feature-item">
            <span class="vs-feature-icon" aria-hidden="true">✓</span>
            <div class="vs-feature-text">
              <div class="vs-feature-title">Hebký ergonomický tvar – netlačí a umožňuje volný pohyb</div>
            </div>
          </div>
        </div>

        <!-- Single Product Luxury Buy Box -->
        <div class="vs-single-offer-card">
          <div class="vs-single-offer-badge-row">
            <span class="vs-stock-status"><span class="vs-stock-dot"></span> Skladem (ihned k odeslání)</span>
            <span class="vs-shipping-status">Doprava zdarma</span>
          </div>

          <div class="vs-offer-price-row">
            <span class="vs-price-current" data-vs-price-display>{{ p_base_fmt }}</span>
            <span class="vs-price-before" data-vs-compare-display>{{ c_base_fmt }}</span>
            <span class="vs-price-saving" data-vs-save-display>Ušetříte {{ save_fmt | replace: ' ', '&nbsp;' }}</span>
          </div>

          <div class="vs-package-includes">
            📦 <strong>Kompletní balení obsahuje:</strong> VeaSkin masážní brýle na oční okolí, prémiové sametové pouzdro, USB-C rychlonabíjecí kabel a český návod.
          </div>
        </div>

        <!-- Touch-Friendly Mobile Quantity Selector -->
        <div class="vs-qty-wrapper">
          <div class="vs-qty-header">
            <span class="vs-qty-label">Zvolte počet kusů:</span>
            <span class="vs-qty-note">Doprava zdarma na celou objednávku</span>
          </div>

          <div class="vs-qty-bar">
            <!-- Stepper with min 46px touch targets for mobile thumb -->
            <div class="vs-qty-stepper" role="group" aria-label="Změna množství">
              <button
                type="button"
                class="vs-qty-btn vs-qty-btn--minus"
                aria-label="Snížit počet kusů"
                data-vs-qty-btn="minus"
              >−</button>
              <span class="vs-qty-val" data-vs-qty-val>1</span>
              <button
                type="button"
                class="vs-qty-btn vs-qty-btn--plus"
                aria-label="Zvýšit počet kusů"
                data-vs-qty-btn="plus"
              >+</button>
            </div>

            <!-- Quick-Pick Pills for Mobile Thumb -->
            <div class="vs-qty-pills" role="radiogroup" aria-label="Rychlý výběr počtu kusů">
              <button type="button" class="vs-qty-pill is-active" data-vs-qty-pill="1" role="radio" aria-checked="true">1 ks</button>
              <button type="button" class="vs-qty-pill" data-vs-qty-pill="2" role="radio" aria-checked="false">2 ks</button>
              <button type="button" class="vs-qty-pill" data-vs-qty-pill="3" role="radio" aria-checked="false">3 ks</button>
            </div>
          </div>
        </div>
              {%- if target_product != blank -%}
          <product-form-component
            data-section-id="{{ section.id }}"
            data-product-id="{{ target_product.id }}"
            data-product-url="{{ target_product.url }}"
            on:submit="/handleSubmit"
            data-quantity-default="1"
            data-quantity-error-max="{{ 'products.product.quantity_error_max' | t }}"
          >
            <div
              class="visually-hidden"
              aria-live="assertive"
              role="status"
              aria-atomic="true"
              ref="liveRegion"
            ></div>

            {%- form 'product', target_product, id: product_form_id, data-type: 'add-to-cart-form' -%}
              <input
                type="hidden"
                name="id"
                ref="variantId"
                value="{{ v1_id }}"
                data-vs-form-id
              >
              <input
                type="hidden"
                name="quantity"
                value="1"
                data-vs-form-qty
              >
              <span class="product-form-text__error hidden" ref="addToCartTextError">
                <span class="svg-wrapper">
                  {{- 'icon-error.svg' | inline_asset_content -}}
                </span>
              </span>
              <button
                type="submit"
                name="add"
                class="vs-cta-btn vs-cta-btn--single"
                data-vs-cta-btn
                {% unless first_variant.available %}disabled{% endunless %}
              >
                {%- if first_variant.available -%}
                  <span class="vs-cta-btn__main" data-vs-cta-main>PŘIDAT DO KOŠÍKU — {{ p_base_fmt }}</span>
                  <span class="vs-cta-btn__sub" data-vs-cta-sub>
                    <span class="vs-cta-sub--full">(30 DNÍ NA VYZKOUŠENÍ • DOPRAVA ZDARMA)</span>
                    <span class="vs-cta-sub--short">(DOPRAVA ZDARMA)</span>
                  </span>
                {%- else -%}
                  <span class="vs-cta-btn__main">VYPRODÁNO</span>
                {%- endif -%}
              </button>
            {%- endform -%}
          </product-form-component>
        {%- endif -%}

        <!-- Luxury Trust Pillars -->
        <div class="vs-trust-grid" role="list" aria-label="Garance a výhody nákupu">
          <div class="vs-trust-card" role="listitem">
            <div class="vs-trust-card__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                <path d="m9 12 2 2 4-4"/>
              </svg>
            </div>
            <div class="vs-trust-card__text">
              <div class="vs-trust-card__title">30 dní na zkoušku</div>
              <div class="vs-trust-card__desc">Garance vrácení peněz</div>
            </div>
          </div>

          <div class="vs-trust-card" role="listitem">
            <div class="vs-trust-card__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
              </svg>
            </div>
            <div class="vs-trust-card__text">
              <div class="vs-trust-card__title">10 minut denně</div>
              <div class="vs-trust-card__desc">Snadný ranní rituál</div>
            </div>
          </div>

          <div class="vs-trust-card" role="listitem">
            <div class="vs-trust-card__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="8" r="6"/>
                <path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/>
              </svg>
            </div>
            <div class="vs-trust-card__text">
              <div class="vs-trust-card__title">Klinicky ověřeno</div>
              <div class="vs-trust-card__desc">660nm LED technologie</div>
            </div>
          </div>

          <div class="vs-trust-card" role="listitem">
            <div class="vs-trust-card__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 8h1a4 4 0 1 1 0 8h-1"/>
                <path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"/>
                <line x1="6" x2="6" y1="2" y2="4"/>
                <line x1="10" x2="10" y1="2" y2="4"/>
                <line x1="14" x2="14" y1="2" y2="4"/>
              </svg>
            </div>
            <div class="vs-trust-card__text">
              <div class="vs-trust-card__title">Hands-free pohodlí</div>
              <div class="vs-trust-card__desc">Volný pohyb při ranní kávě</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. STATS BANNER: KLINICKY OVĚŘENÁ ÚČINNOST -->
  <section class="vs-section" style="padding-top: 10px; padding-bottom: 20px;">
    <div class="vs-stats-row">
      <div class="vs-stat-box">
        <div class="vs-stat-num">87 %</div>
        <div class="vs-stat-txt">viditelná redukce ranních otoků a váčků</div>
      </div>
      <div class="vs-stat-box">
        <div class="vs-stat-num">82 %</div>
        <div class="vs-stat-txt">prosvětlení tmavých kruhů pod očima již po 2 týdnech</div>
      </div>
      <div class="vs-stat-box">
        <div class="vs-stat-num">10 min</div>
        <div class="vs-stat-txt">denní rituál s automatickým vypnutím</div>
      </div>
    </div>
  </section>

  <!-- 3. RANNÍ RITUÁL KRÁSY VE 3 KROCÍCH -->
  <section class="vs-section" id="jak-funguje">
    <div class="vs-center-head">
      <span class="vs-kicker">✨ Ranní rituál krásy</span>
      <h2 class="vs-heading">Pouhé 4 kroky k odpočatému pohledu</h2>
      <p class="vs-sub">Snadná a příjemná 10minutová péče, kterou hravě zařadíte k ranní kávě, čaji nebo poslechu podcastu.</p>
    </div>

    <div class="vs-steps-slider-wrapper" data-vs-steps-slider>
      <div class="vs-steps-track" data-vs-steps-track>
        <article class="vs-step-card" data-vs-step-card>
          <div class="vs-step-media">
            <img src="{{ step1_gif_url }}" alt="Krok 1 - Čistá pleť" width="400" height="300" loading="lazy">
            <span class="vs-step-pill">Krok 1</span>
          </div>
          <div class="vs-step-body">
            <h3 class="vs-step-title">Čistá pleť</h3>
            <p class="vs-step-desc">Začněte s čistou pletí — důkladně si umyjte obličej, abyste odstranili mastnotu i nečistoty pro maximální účinek.</p>
          </div>
        </article>

        <article class="vs-step-card" data-vs-step-card>
          <div class="vs-step-media">
            <img src="{{ step2_gif_url }}" alt="Krok 2 - Kapka séra či krému" width="400" height="300" loading="lazy">
            <span class="vs-step-pill">Krok 2</span>
          </div>
          <div class="vs-step-body">
            <h3 class="vs-step-title">Kapka séra či krému</h3>
            <p class="vs-step-desc">Naneste pod oči kapku očního krému nebo séra na vodní bázi o velikosti hrášku pro zesílení vodivosti mikroproudů.</p>
          </div>
        </article>

        <article class="vs-step-card" data-vs-step-card>
          <div class="vs-step-media">
            <img src="{{ step3_gif_url }}" alt="Krok 3 - Volba režimu" width="400" height="300" loading="lazy">
            <span class="vs-step-pill">Krok 3</span>
          </div>
          <div class="vs-step-body">
            <h3 class="vs-step-title">Volba režimu</h3>
            <p class="vs-step-desc">Zapněte přístroj a pomocí tlačítka zvolte požadovaný režim pulzů a příjemnou intenzitu mikromasáže.</p>
          </div>
        </article>

        <article class="vs-step-card" data-vs-step-card>
          <div class="vs-step-media">
            <img src="{{ step4_gif_url }}" alt="Krok 4 - 10 minut relaxace" width="400" height="300" loading="lazy">
            <span class="vs-step-pill">Krok 4</span>
          </div>
          <div class="vs-step-body">
            <h3 class="vs-step-title">10 minut relaxace</h3>
            <p class="vs-step-desc">Pohodlně si vychutnejte ranní kávu nebo čaj. Přístroj pracuje sám za vás a po 10 minutách se automaticky vypne.</p>
          </div>
        </article>
      </div>

      <div class="vs-steps-meta">
        <div class="vs-steps-dots" role="tablist" aria-label="Kroky ranního rituálu">
          <button type="button" class="vs-step-dot is-active" data-vs-step-dot="0" aria-label="Přejít na Krok 1"></button>
          <button type="button" class="vs-step-dot" data-vs-step-dot="1" aria-label="Přejít na Krok 2"></button>
          <button type="button" class="vs-step-dot" data-vs-step-dot="2" aria-label="Přejít na Krok 3"></button>
          <button type="button" class="vs-step-dot" data-vs-step-dot="3" aria-label="Přejít na Krok 4"></button>
        </div>
        <span class="vs-steps-hint">Posuňte prstem →</span>
      </div>
    </div>
  </section>

  <!-- 4. TECHNOLOGIE + INTERAKTIVNÍ PŘED / PO SLIDER -->
  <section class="vs-section" id="technologie">
    <div class="vs-science-grid" id="vysledky">
      <!-- Left: Clinical Benefits -->
      <div class="vs-science-card">
        <div>
          <span class="vs-kicker vs-kicker--dark">🔬 Klinicky ověřená synergie</span>
          <h2 class="vs-heading">Proč je <span class="vs-science-highlight">terapie červeným světlem + mikroproudy</span> tak účinná</h2>

          <ul class="vs-science-list">
            <li>
              <span class="vs-science-dot" aria-hidden="true">✓</span>
              <div><strong>Červené fotonové světlo (660 nm) proniká hloubkově do dermis</strong> — stimuluje buněčné mitochondrie a přirozenou tvorbu kolagenu tam, kam krémy nedosáhnou.</div>
            </li>
            <li>
              <span class="vs-science-dot" aria-hidden="true">✓</span>
              <div><strong>EMS mikroproudy aktivují jemnou lymfatickou drenáž</strong> — eliminují stagnaci tekutin, která je přímou příčinou ranních otoků a unavených váčků.</div>
            </li>
            <li>
              <span class="vs-science-dot" aria-hidden="true">✓</span>
              <div><strong>Řeší všechny 3 hlavní projevy stárnutí očí</strong> — zpomalenou mikrocirkulaci (kruhy), zadržování vody (otoky) a úbytek pružnosti (vrásky).</div>
            </li>
            <li>
              <span class="vs-science-dot" aria-hidden="true">✓</span>
              <div><strong>100% neinvazivní a bezpečné</strong> — bez bolesti, bez jehel a bez nutnosti rekonvalescence. Certifikováno dle evropských norem CE a RoHS.</div>
            </li>
          </ul>
        </div>
      </div>

      <!-- Right: Before / After Slider -->
      <div class="vs-ba-card">
        <div>
          <div class="vs-ba-top">
            <strong>Viditelná proměna očního okolí</strong>
            <span class="vs-ba-hint">↔ Posuňte pro srovnání</span>
          </div>


{% liquid
  assign target_product = product
  if target_product == blank
    assign target_product = all_products['led-ems-bryle-na-ocni-okoli']
  endif
  if target_product == blank
    assign target_product = collections.all.products.first
  endif

  assign first_variant = target_product.selected_or_first_available_variant
  assign v1_id = first_variant.id

  assign raw_price = first_variant.price | default: 0
  assign raw_compare = first_variant.compare_at_price | default: 0

  assign custom_p = section.settings.custom_price
  assign custom_c = section.settings.custom_compare_price

  if custom_p != blank and custom_p > 0 and custom_c != blank and custom_c > 0
    assign p1_base = custom_p | times: 100
    assign c1_base = custom_c | times: 100
  elsif raw_price == 262100 or raw_compare == 374500
    # 2 621 Kc je cena pred slevou (3 745 Kc byl puvodni chybny dopocet predpokladajici 2621 po sleve)
    assign c1_base = 262100
    assign p1_base = 183500
  elsif raw_compare > raw_price and raw_price > 0
    assign p1_base = raw_price
    assign c1_base = raw_compare
  elsif raw_price > 0 and raw_price != 262100
    assign c1_base = raw_price
    assign p1_base = raw_price | times: 70 | divided_by: 10000.0 | round | times: 100
  else
    assign c1_base = 262100
    assign p1_base = 183500
  endif

  assign save_amount = c1_base | minus: p1_base
  if c1_base > p1_base and c1_base > 0
    assign discount_pct = save_amount | times: 100.0 | divided_by: c1_base | round
  else
    assign discount_pct = 30
  endif

  assign p1_kc = p1_base | divided_by: 100
  assign c1_kc = c1_base | divided_by: 100

  assign p1_fmt = p1_base | money_without_trailing_zeros | replace: '.', ' '
  assign c1_fmt = c1_base | money_without_trailing_zeros | replace: '.', ' '

  assign ebook_product = section.settings.ebook_product
  assign ebook_variant_id = ''
  if ebook_product != blank and ebook_product.selected_or_first_available_variant != blank
    assign ebook_variant_id = ebook_product.selected_or_first_available_variant.id
  endif

  assign studio_hero_url = 'veaskin-hero-pearl.jpg' | asset_url
  if section.settings.hero_image != blank
    assign studio_hero_url = section.settings.hero_image | image_url: width: 1200
  endif

  if images['zenabilepozadi.jpg'] != blank
    assign model_white_url = images['zenabilepozadi.jpg'] | image_url: width: 1200
  else
    assign model_white_url = 'zenabilepozadi.jpg' | asset_url
  endif

  if section.settings.lifestyle_image != blank
    assign lifestyle_img_url = section.settings.lifestyle_image | image_url: width: 1200
  else
    assign lifestyle_img_url = 'veaskin-morning-lifestyle.jpg' | asset_url
  endif

  assign thumb_detail_url = 'veaskin-review-2.jpg' | asset_url

  if section.settings.before_image != blank
    assign before_img_url = section.settings.before_image | image_url: width: 1000
  else
    assign before_img_url = 'veaskin-den0.jpg' | asset_url
  endif

  if section.settings.after_image != blank
    assign after_img_url = section.settings.after_image | image_url: width: 1000
  else
    assign after_img_url = 'veaskin-den14.jpg' | asset_url
  endif

  assign rev1_img_url = 'veaskin-review-1.jpg' | asset_url
  assign rev2_img_url = 'veaskin-review-hand.jpg' | asset_url
  assign rev3_img_url = 'veaskin-review-3.jpg' | asset_url

  assign product_form_id = 'VeaSkinProductForm-' | append: section.id
%}

{% render 'theme-drawer-styles' %}
<script
  src="{{ 'product-form.js' | asset_url }}"
  type="module"
></script>

{%- if target_product != blank -%}
  <script type="application/ld+json">
    {{ target_product | structured_data }}
  </script>
{%- endif -%}

<div
  class="vs-shell"
  id="veaskin-pdp"
  data-vs-experience
  data-ebook-variant-id="{{ ebook_variant_id }}"
  data-p1-kc="{{ p1_kc }}"
  data-c1-kc="{{ c1_kc }}"
>

  <!-- ========================================================================
       SEKCE 2: KOMPAKTNÍ NÁKUPNÍ SEKCE (BUY BOX + E-BOOK V CENĚ + VOLIČ KUSŮ)
       ======================================================================== -->
  <section class="vs-band vs-band--white" id="top">
    <div class="vs-container vs-container--hero">
      <div class="vs-hero-grid" id="nabidka">
        <!-- Levý sloupec / Mobil nahoře: Čistá produktová galerie -->
        <div class="vs-gallery">
          <div class="vs-gallery__stage">
            <img
              src="{{ studio_hero_url }}"
              alt="VeaSkin LED & EMS brýle na oční okolí - Perlově bílá otevřená konstrukce s průhlednými nožičkami"
              class="vs-gallery__main-img"
              width="960"
              height="960"
              loading="eager"
              fetchpriority="high"
              data-vs-main-img
            >
            <a
              href="#recenze-sekce"
              class="vs-gallery__trust-strip"
              aria-label="Hodnocení 4,9 z 5 hvězdiček - Ověřeno 158 zákaznicemi"
            >
              <span class="vs-stars" aria-hidden="true">★★★★★</span>
              <span class="vs-gallery__trust-text">4.9 / 5 • Ověřeno 158 zákaznicemi</span>
            </a>
          </div>

          <div class="vs-gallery__thumbs" role="tablist" aria-label="Fotografie produktu VeaSkin">
            <button
              type="button"
              class="vs-gallery__thumb is-active"
              data-vs-thumb="{{ studio_hero_url }}"
              aria-label="Detail perlově bílých brýlí VeaSkin s průhlednými nožičkami"
              aria-pressed="true"
            >
              <img src="{{ studio_hero_url }}" alt="Studiový detail perlově bílých brýlí VeaSkin" width="160" height="160" loading="eager">
            </button>
            <button
              type="button"
              class="vs-gallery__thumb"
              data-vs-thumb="{{ model_white_url }}"
              aria-label="Ukázka usazení pod očima na lícních kostech - volný výhled"
              aria-pressed="false"
            >
              <img src="{{ model_white_url }}" alt="Brýle VeaSkin nasazené pod očima s volným výhledem" width="160" height="160" loading="lazy">
            </button>
            <button
              type="button"
              class="vs-gallery__thumb"
              data-vs-thumb="{{ lifestyle_img_url }}"
              aria-label="Ranní rituál u čaje v lněném županu"
              aria-pressed="false"
            >
              <img src="{{ lifestyle_img_url }}" alt="Ranní rituál u čaje s otevřenými brýlemi VeaSkin" width="160" height="160" loading="lazy">
            </button>
            <button
              type="button"
              class="vs-gallery__thumb"
              data-vs-thumb="{{ thumb_detail_url }}"
              aria-label="Otevřená konstrukce VeaSkin u ranní kávy"
              aria-pressed="false"
            >
              <img src="{{ thumb_detail_url }}" alt="Detail otevřené konstrukce VeaSkin u ranního cappuccina" width="160" height="160" loading="lazy">
            </button>
          </div>
        </div>

        <!-- Pravý sloupec / Mobil dole: Přehledný konverzní Buy Box -->
        <div class="vs-buy-panel" id="nabidka-box">
          <div class="vs-stock-line">
            <span class="vs-stock-line__dot" aria-hidden="true"></span>
            <span>{{ section.settings.stock_text | default: 'Skladem - ihned k odeslání' }}</span>
            <span class="vs-stock-line__sep" aria-hidden="true">|</span>
            <span>Doprava zdarma</span>
          </div>

          <h1 class="vs-product-title">
            {{ section.settings.product_heading | default: 'VeaSkin LED & EMS brýle na oční okolí' }}
          </h1>

          <p class="vs-product-subtitle">
            {{ section.settings.product_subtitle | default: 'Svěží a odpočatý pohled za 10 minut denně - bez ranních otoků a vrstvy korektoru.' }}
          </p>

          <!-- Přehledný řádek s cenou -->
          <div class="vs-price-row">
            <span class="vs-price-row__current" data-vs-price-current>{{ p1_fmt }}</span>
            <span class="vs-price-row__compare" data-vs-price-compare>{{ c1_fmt }}</span>
            <span class="vs-price-row__ebook" data-vs-price-badge>Ušetříte {{ discount_pct }} %</span>
          </div>

          <!-- Informační box v barvě Soft Mint (#EAF5EE) s jemným rámečkem (#2F6F54): E-book „Oči bez stínů“ v ceně -->
          <div class="vs-volume-mint-box">
            <span class="vs-volume-mint-box__icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
              </svg>
            </span>
            <div class="vs-volume-mint-box__content">
              <p class="vs-volume-mint-box__title">E-book „Oči bez stínů“ máte v ceně</p>
              <p class="vs-volume-mint-box__text">
                Praktický průvodce ranní péčí o oční okolí (v hodnotě <strong>390 Kč</strong>) je součástí balení zdarma a dorazí vám ihned na e-mail.
              </p>
            </div>
          </div>

          <!-- Čistý, moderní volič množství (Quantity Selector: tlačítka [ - ] 1 [ + ] v rámečku #E8E2D8 vedle popisku „Počet kusů:“) přímo nad CTA -->
          <div class="vs-qty-bar">
            <label class="vs-qty-bar__label" for="vs-qty-display-{{ section.id }}">Počet kusů:</label>
            <div class="vs-qty-stepper" role="group" aria-label="Nastavení počtu kusů">
              <button
                type="button"
                class="vs-qty-stepper__btn"
                data-vs-qty-step="-1"
                aria-label="Snížit počet kusů"
              >
                &minus;
              </button>
              <input
                type="number"
                id="vs-qty-display-{{ section.id }}"
                class="vs-qty-stepper__value"
                value="1"
                min="1"
                max="10"
                inputmode="numeric"
                aria-label="Počet kusů"
                data-vs-qty-input
              >
              <button
                type="button"
                class="vs-qty-stepper__btn"
                data-vs-qty-step="1"
                aria-label="Zvýšit počet kusů"
              >
                +
              </button>
            </div>
          </div>

          <!-- Hlavní CTA tlačítko napojené na Shopify košík -->
          {%- if target_product != blank -%}
            <product-form-component
              data-section-id="{{ section.id }}"
              data-product-id="{{ target_product.id }}"
              data-product-url="{{ target_product.url }}"
              on:submit="/handleSubmit"
              data-quantity-default="1"
              data-quantity-error-max="{{ 'products.product.quantity_error_max' | t }}"
            >
              <div
                class="visually-hidden"
                aria-live="assertive"
                role="status"
                aria-atomic="true"
                ref="liveRegion"
              ></div>

              {%- form 'product', target_product, id: product_form_id, data-type: 'add-to-cart-form' -%}
                <input
                  type="hidden"
                  name="id"
                  ref="variantId"
                  value="{{ v1_id }}"
                  data-vs-form-id
                >
                <input
                  type="hidden"
                  name="quantity"
                  value="1"
                  data-vs-form-qty
                >
                <span class="product-form-text__error hidden" ref="addToCartTextError">
                  <span class="svg-wrapper">
                    {{- 'icon-error.svg' | inline_asset_content -}}
                  </span>
                </span>
                <button
                  type="submit"
                  name="add"
                  class="vs-cta-btn vs-cta-btn--main"
                  data-vs-cta-btn
                  {% unless first_variant.available %}disabled{% endunless %}
                >
                  {%- if first_variant.available -%}
                    <span class="vs-cta-btn__main" data-vs-cta-label>PŘIDAT DO KOŠÍKU - {{ p1_fmt }}</span>
                    <span class="vs-cta-btn__sub">(DOPRAVA ZDARMA)</span>
                  {%- else -%}
                    <span class="vs-cta-btn__main">VYPRODÁNO</span>
                  {%- endif -%}
                </button>
              {%- endform -%}
            </product-form-component>
          {%- else -%}
            <button type="button" class="vs-cta-btn vs-cta-btn--main" data-vs-cta-btn>
              <span class="vs-cta-btn__main" data-vs-cta-label>PŘIDAT DO KOŠÍKU - {{ p1_fmt }}</span>
              <span class="vs-cta-btn__sub">(DOPRAVA ZDARMA)</span>
            </button>
          {%- endif -%}

          <!-- Rychlé pilíře důvěry oddělené jemnými svislými linkami -->
          <ul class="vs-quick-trust" aria-label="Garance nákupu VeaSkin">
            <li class="vs-quick-trust__item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                <path d="m9 12 2 2 4-4"></path>
              </svg>
              <span>30 dní na zkoušku</span>
            </li>
            <li class="vs-quick-trust__item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="1" y="3" width="15" height="13" rx="1"></rect>
                <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                <circle cx="5.5" cy="18.5" r="2.5"></circle>
                <circle cx="18.5" cy="18.5" r="2.5"></circle>
              </svg>
              <span>Odeslání do 24 h</span>
            </li>
            <li class="vs-quick-trust__item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
              </svg>
              <span>E-book „Oči bez stínů“</span>
            </li>
          </ul>

          <!-- Samostatný garanční pás 30 dní bez rizika -->
          <div class="vs-guarantee-strip">
            <span class="vs-guarantee-strip__icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="8" r="6"></circle>
                <path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"></path>
              </svg>
            </span>
            <div>
              <p class="vs-guarantee-strip__title">30 dní na vyzkoušení u ranní kávy bez rizika</p>
              <p class="vs-guarantee-strip__text">
                Vyzkoušejte VeaSkin v klidu domova. Pokud do 30 dnů neuvidíte rozdíl, vrátíme vám 100 % částky.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================
       SEKCE 3: 4 KLÍČOVÉ BENEFITY (PÁS SILK CREAM #FAF8F5 S ČISTÝMI LINKAMI)
       ======================================================================== -->
  <section class="vs-band vs-band--cream" id="benefity" aria-label="Klíčové benefity přístroje VeaSkin">
    <div class="vs-container vs-container--compact">
      <div class="vs-benefits-list">
        <div class="vs-benefit-item">
          <span class="vs-benefit-item__check" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </span>
          <div>
            <h2 class="vs-benefit-item__title">Jemná mikromasáž a EMS impulzy</h2>
            <p class="vs-benefit-item__desc">Uvolňuje napětí a viditelně zmírňuje ranní otoky pod očima.</p>
          </div>
        </div>

        <div class="vs-benefit-item">
          <span class="vs-benefit-item__check" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </span>
          <div>
            <h2 class="vs-benefit-item__title">Příjemné hřejivé prohřátí</h2>
            <p class="vs-benefit-item__desc">Přináší úlevu unaveným očím po práci s počítačem či telefonem.</p>
          </div>
        </div>

        <div class="vs-benefit-item">
          <span class="vs-benefit-item__check" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </span>
          <div>
            <h2 class="vs-benefit-item__title">Více režimů a úrovní intenzity</h2>
            <p class="vs-benefit-item__desc">Ranní i večerní péči si snadno přizpůsobíte své citlivosti.</p>
          </div>
        </div>

        <div class="vs-benefit-item">
          <span class="vs-benefit-item__check" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </span>
          <div>
            <h2 class="vs-benefit-item__title">Lehká otevřená konstrukce</h2>
            <p class="vs-benefit-item__desc">Sedí pouze pod očima na lícních kostech - přes brýle normálně vidíte.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================
       SEKCE 4: EMOČNÍ LIFESTYLOVÁ SEKCE (PLNÝ PÁS BEZ KARTY)
       ======================================================================== -->
  <section class="vs-band vs-band--mint" id="ranni-ritual">
    <div class="vs-container">
      <div class="vs-lifestyle-split">
        <div class="vs-lifestyle-split__media">
          <img
            src="{{ lifestyle_img_url }}"
            alt="Usměvavá 38letá žena v béžovém lněném županu s hrnkem čaje a otevřenými perlově bílými brýlemi VeaSkin pod očima"
            width="960"
            height="720"
            loading="lazy"
          >
          <div class="vs-lifestyle-split__caption">
            ✓ Otevřená konstrukce s průhlednými nožičkami sedí pouze pod očima - během rituálu normálně vidíte.
          </div>
        </div>

        <div class="vs-lifestyle-split__copy">
          <span class="vs-kicker">☕ První krok k vaší ranní proměně</span>
          <h2 class="vs-section-heading">
            Vykročte do rána <span class="vs-text-accent">s úsměvem.</span> Stačí jen <span class="vs-text-accent">10 minut péče.</span>
          </h2>
          <p class="vs-lifestyle-split__text">
            Cítíte se plná energie, ale pohled do zrcadla říká opak? Ranní otoky a unavené oči už nemusíte zakrývat vrstvou korektoru. VeaSkin vám během ranní kávy vrátí svěží pohled a sebevědomí cítit se krásná - přirozeně a bez líčení.
          </p>
          <a href="#nabidka-box" class="vs-cta-btn vs-cta-btn--inline" data-vs-scroll-buy>
            Přejít k objednávce VeaSkin →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================
       SEKCE 5: JAK TECHNOLOGIE FUNGUJE (3 OTEVŘENÉ SLOUPCE S LINKAMI)
       ======================================================================== -->
  <section class="vs-band vs-band--white" id="technologie">
    <div class="vs-container">
      <div class="vs-section-head">
        <span class="vs-kicker">630-660 nm Červené LED + EMS</span>
        <h2 class="vs-section-heading">Síla světla a jemné mikromasáže v jednom kroku</h2>
        <p class="vs-section-sub">
          Ergonomické perlově bílé oblouky působí přesně pod očima na lícních kostech, zatímco vaše oči zůstávají po celou dobu zcela volné.
        </p>
      </div>

      <div class="vs-tech-columns">
        <article class="vs-tech-col">
          <div class="vs-tech-col__icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2"></path>
              <path d="M12 20v2"></path>
              <path d="m4.93 4.93 1.41 1.41"></path>
              <path d="m17.66 17.66 1.41 1.41"></path>
              <path d="M2 12h2"></path>
              <path d="M20 12h2"></path>
              <path d="m6.34 17.66-1.41 1.41"></path>
              <path d="m19.07 4.93-1.41 1.41"></path>
            </svg>
          </div>
          <div>
            <h3 class="vs-tech-col__title">Červené LED světlo (630-660 nm)</h3>
            <p class="vs-tech-col__desc">
              Cílené červené světlo proniká do jemné pokožky pod očima, podporuje přirozenou obnovu kolagenu a postupně zjemňuje drobné vějířkovité linky.
            </p>
          </div>
        </article>

        <article class="vs-tech-col">
          <div class="vs-tech-col__icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 12h4l3-9 5 18 3-9h5"></path>
            </svg>
          </div>
          <div>
            <h3 class="vs-tech-col__title">Jemné EMS mikroproudy</h3>
            <p class="vs-tech-col__desc">
              Šetrné impulzy probouzejí mikrocirkulaci a přirozený tok lymfy v očním okolí, čímž pomáhají splasknout ranním otokům a váčkům pod očima.
            </p>
          </div>
        </article>

        <article class="vs-tech-col">
          <div class="vs-tech-col__icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">

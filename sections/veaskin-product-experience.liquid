{% liquid
  assign target_product = product
  if target_product == blank
    assign target_product = all_products['led-ems-bryle-na-ocni-okoli']
  endif
  if target_product == blank
    assign target_product = collections.all.products.first
  endif

  assign first_variant = target_product.selected_or_first_available_variant
  assign v1_id = first_variant.id
  assign v1_qty = 1

  assign raw_price = first_variant.price | default: 189900
  assign raw_compare = first_variant.compare_at_price | default: 0

  if raw_compare > raw_price
    assign c1 = raw_compare
    assign p1 = raw_price
  elsif raw_price >= 170000
    assign c1 = raw_price
    assign p1 = 132900
  else
    assign p1 = raw_price
    assign c1 = 189900
  endif

  if p1 >= c1
    assign c1 = 189900
    assign p1 = 132900
  endif

  assign p1_fmt = p1 | money_without_trailing_zeros | replace: '.', ' '
  assign c1_fmt = c1 | money_without_trailing_zeros | replace: '.', ' '

  assign save1_raw = c1 | minus: p1
  assign d1_pct = save1_raw | times: 100.0 | divided_by: c1 | round
  assign save1_fmt = save1_raw | money_without_trailing_zeros | replace: '.', ' '

  assign day1_cents = p1 | divided_by: 365.0 | divided_by: 10.0 | round | times: 10
  assign day1_fmt = day1_cents | money | replace: '.', ' '

  assign p1_cta = p1_fmt | replace: 'Kč', 'KČ'

  assign cta1_main = 'PŘIDAT DO KOŠÍKU – ' | append: p1_cta
  assign cta1_sub_full = '(DOPRAVA ZDARMA • SLEVA 30 % DO ZÍTŘEJŠÍ PŮLNOCI)'
  assign cta1_sub_short = '(DOPRAVA ZDARMA • SLEVA 30 %)'
  assign cta1_sub = cta1_sub_full
  assign cta1_label = cta1_main | append: ' ' | append: cta1_sub_full

  if images['zenabilepozadi.jpg'] != blank
    assign hero_img_url = images['zenabilepozadi.jpg'] | image_url: width: 1200
  elsif target_product.featured_image != blank
    assign hero_img_url = target_product.featured_image | image_url: width: 1200
  else
    assign hero_img_url = '/cdn/shop/files/zenabilepozadi.jpg'
  endif

  assign morning_img_url = 'rannikafe.jpg' | asset_url

  if images['krok_1.gif'] != blank
    assign step1_gif_url = images['krok_1.gif'] | image_url
  else
    assign step1_gif_url = '/cdn/shop/files/krok_1.gif'
  endif

  if images['krok_2.gif'] != blank
    assign step2_gif_url = images['krok_2.gif'] | image_url
  else
    assign step2_gif_url = '/cdn/shop/files/krok_2.gif'
  endif

  if images['krok_3.gif'] != blank
    assign step3_gif_url = images['krok_3.gif'] | image_url
  else
    assign step3_gif_url = '/cdn/shop/files/krok_3.gif'
  endif

  if images['krok_4.gif'] != blank
    assign step4_gif_url = images['krok_4.gif'] | image_url
  else
    assign step4_gif_url = '/cdn/shop/files/krok_4.gif'
  endif

  if images['pred.jpg'] != blank
    assign before_img_url = images['pred.jpg'] | image_url: width: 1000
  else
    assign before_img_url = '/cdn/shop/files/pred.jpg'
  endif

  if images['po.jpg'] != blank
    assign after_img_url = images['po.jpg'] | image_url: width: 1000
  else
    assign after_img_url = '/cdn/shop/files/po.jpg'
  endif

  assign product_form_id = 'VeaSkinBundleForm-' | append: section.id
%}

{% render 'theme-drawer-styles' %}
<script
  src="{{ 'product-form.js' | asset_url }}"
  type="module"
></script>

{%- if target_product != blank -%}
  <script type="application/ld+json">
    {{ target_product | structured_data }}
  </script>
{%- endif -%}

<div class="vs-shell" id="veaskin-pdp-v2" data-vs-experience>

  {%- if section.settings.show_trust_bar != false -%}
    {%- assign t_rating = section.settings.trust_rating | default: '4,9/5' -%}
    {%- assign t_count = section.settings.trust_count | default: '2 000+ žen' -%}
    {%- assign t_tagline = section.settings.trust_tagline | default: 'Doprava zdarma' -%}
    {%- if t_tagline == 'česká značka' or t_tagline contains 'ČR' or t_tagline == blank -%}
      {%- assign t_tagline = 'Doprava zdarma' -%}
    {%- endif -%}
    <aside class="vs-trust-bar">
      <a href="#recenze-sekce" class="vs-trust-bar__link" aria-label="Hodnocení {{ t_rating }} z 5 hvězdiček, {{ t_count }}, {{ t_tagline }}">
        <div class="vs-trust-bar__stars" aria-hidden="true">★★★★★</div>
        <div class="vs-trust-bar__text">
          <span class="vs-trust-bar__rating">{{ t_rating }}</span>
          <span class="vs-trust-bar__dot" aria-hidden="true">·</span>
          <span class="vs-trust-bar__count">{{ t_count }}</span>
          <span class="vs-trust-bar__dot" aria-hidden="true">·</span>
          <span class="vs-trust-bar__origin">{{ t_tagline }}</span>
        </div>
      </a>
    </aside>
  {%- endif -%}

  <!-- 1. RANNÍ PROMĚNA (CENTERED VERTICAL HERO) -->
  <section class="vs-section vs-section--hero{% if section.settings.show_trust_bar != false %} has-trust-bar{% endif %}" id="top">
    <div class="vs-morning-card">
      <div class="vs-morning-content">
        <span class="vs-hero-tagline">✨ Každodenní 10minutový rituál</span>
        <h1 class="vs-morning-title">
          Svěží pohled bez ranních otoků <span class="vs-highlight">a kruhů pod očima</span>
        </h1>
        <h2 class="vs-morning-subtitle">Stačí jen 10 minut péče u ranní kávy.</h2>
        <p class="vs-morning-lead">
          Příjemná teplá komprese v kombinaci s lymfatickou mikromasáží a červeným světlem <strong>odvádí nahromaděnou tekutinu</strong> a probouzí unavené oční okolí. Výsledek? <strong>Viditelně odpočatý pohled</strong> bez nutnosti korektoru.
        </p>
        <div class="vs-morning-actions">
          <a href="#nabidka-box" class="vs-cta-btn vs-morning-cta">
            Získat se slevou 30 % – {{ p1_fmt | replace: ' ', '&nbsp;' }}&nbsp;↓
          </a>
        </div>
        <div class="vs-morning-guarantee">
          <span class="vs-guarantee-icon" aria-hidden="true">🛡️</span>
          <span>30 dní na vyzkoušení – nepomůže, vrátíme peníze</span>
        </div>
      </div>
      <div class="vs-morning-media">
        <img
          src="{{ morning_img_url }}"
          alt="Ranní káva a VeaSkin péče"
          width="900"
          height="600"
          loading="eager"
          fetchpriority="high"
        >
      </div>
    </div>
  </section>

  <!-- 2. HERO GALLERY + TIERED BUNDLE OFFER BUY BOX -->
  <section class="vs-section" id="nabidka">
    <div class="vs-hero-grid">
      <!-- Left: Product Gallery -->
      <div class="vs-gallery-card">
        <div class="vs-main-media">
          <img
            src="{{ hero_img_url }}"
            alt="Brýle proti otokům VeaSkin"
            class="vs-main-media__img"
            width="900"
            height="900"
            loading="eager"
            fetchpriority="high"
            data-vs-main-img
          >
          <div class="vs-media-badge-top">
            <span class="vs-dot-live" aria-hidden="true"></span>
            <span>630-660 nm Červené LED + EMS</span>
          </div>
        </div>
      </div>

      <!-- Right: Buy Box & Tiered Bundle Selector -->
      <div class="vs-buy-panel" id="nabidka-box">
        <a href="#recenze-sekce" class="vs-review-pill" aria-label="Hodnocení 4,9 z 5 hvězdiček na základě 150+ recenzí">
          <span class="vs-stars" aria-hidden="true">★★★★★</span>
          <span class="vs-review-pill__text">
            <span>4,9 / 5 • 150+ ověřených recenzí</span>
            <span class="vs-review-pill__extra"> (2 000+ spokojených žen)</span>
          </span>
        </a>

        <h1 class="vs-product-title">{{ section.settings.product_heading | default: 'LED & EMS Brýle na oční okolí' }}</h1>

        <div class="vs-product-features">
          <div class="vs-feature-item">
            <span class="vs-feature-icon" aria-hidden="true">✓</span>
            <div class="vs-feature-text">
              <div class="vs-feature-title">Jemná kompresní a vibrační masáž</div>
              <div class="vs-feature-desc">Rozproudí stagnující lymfu a stahuje ranní váčky.</div>
            </div>
          </div>
          <div class="vs-feature-item">
            <span class="vs-feature-icon" aria-hidden="true">✓</span>
            <div class="vs-feature-text">
              <div class="vs-feature-title">Příjemná tepelná terapie</div>
              <div class="vs-feature-desc">Ulevuje suchým, pálícím očím a únavě z obrazovek.</div>
            </div>
          </div>
          <div class="vs-feature-item">
            <span class="vs-feature-icon" aria-hidden="true">✓</span>
            <div class="vs-feature-text">
              <div class="vs-feature-title">630-660 nm červené LED světlo</div>
              <div class="vs-feature-desc">Podporuje tvorbu kolagenu a zesvětluje tmavé kruhy.</div>
            </div>
          </div>
          <div class="vs-feature-item">
            <span class="vs-feature-icon" aria-hidden="true">✓</span>
            <div class="vs-feature-text">
              <div class="vs-feature-title">Měkké ergonomické polstrování</div>
              <div class="vs-feature-desc">Hebký materiál, který netlačí na oči a padne každému.</div>
            </div>
          </div>
        </div>

        <div class="vs-single-offer-card">
          <div class="vs-single-offer-badge-row">
            <span class="vs-badge-discount">🔥 AKČNÍ SLEVA 30 %</span>
            <span class="vs-stock-status"><span class="vs-stock-dot"></span> Skladem (ihned k odeslání)</span>
          </div>

          <div class="vs-offer-price-row">
            <span class="vs-price-current">{{ p1_fmt }}</span>
            <span class="vs-price-before">{{ c1_fmt }}</span>
            <span class="vs-price-saving">Ušetříte {{ save1_fmt | replace: ' ', '&nbsp;' }}</span>
          </div>

          <div class="vs-package-includes">
            📦 <strong>Kompletní balení obsahuje:</strong> VeaSkin masážní brýle na oční okolí, USB-C nabíjecí kabel, prémiové pouzdro a český návod.
          </div>
        </div>

        {%- if target_product != blank -%}
          <product-form-component
            data-section-id="{{ section.id }}"
            data-product-id="{{ target_product.id }}"
            data-product-url="{{ target_product.url }}"
            on:submit="/handleSubmit"
            data-quantity-default="1"
            data-quantity-error-max="{{ 'products.product.quantity_error_max' | t }}"
          >
            <div
              class="visually-hidden"
              aria-live="assertive"
              role="status"
              aria-atomic="true"
              ref="liveRegion"
            ></div>
            {%- form 'product', target_product, id: product_form_id, data-type: 'add-to-cart-form' -%}
              <input
                type="hidden"
                name="id"
                ref="variantId"
                value="{{ v1_id }}"
                data-vs-form-id
              >
              <input
                type="hidden"
                name="quantity"
                value="1"
                data-vs-form-qty
              >
              <span class="product-form-text__error hidden" ref="addToCartTextError">
                <span class="svg-wrapper">
                  {{- 'icon-error.svg' | inline_asset_content -}}
                </span>
              </span>
              <button
                type="submit"
                name="add"
                class="vs-cta-btn vs-cta-btn--single"
                data-vs-cta-btn
                {% unless first_variant.available %}disabled{% endunless %}
              >
                {%- if first_variant.available -%}
                  <span class="vs-cta-btn__main" data-vs-cta-main>{{ cta1_main }}</span>
                  <span class="vs-cta-btn__sub" data-vs-cta-sub>
                    <span class="vs-cta-sub--full">{{ cta1_sub_full }}</span>
                    <span class="vs-cta-sub--short">{{ cta1_sub_short }}</span>
                  </span>
                {%- else -%}
                  <span class="vs-cta-btn__main">VYPRODÁNO</span>
                {%- endif -%}
              </button>
            {%- endform -%}
          </product-form-component>
        {%- endif -%}

        <div class="vs-usp-grid">
          <div class="vs-usp-item"><span class="vs-usp-item__icon" aria-hidden="true">⚡</span>LED &amp; EMS PÉČE</div>
          <div class="vs-usp-item"><span class="vs-usp-item__icon" aria-hidden="true">⏱️</span>10 MIN DENNĚ</div>
          <div class="vs-usp-item"><span class="vs-usp-item__icon" aria-hidden="true">🌿</span>100% BEZPEČNÉ</div>
          <div class="vs-usp-item"><span class="vs-usp-item__icon" aria-hidden="true">📦</span>DOPRAVA ZDARMA</div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. RYCHLÁ SEBEDIAGNOSTIKA -->
  <section class="vs-section">
    <div class="vs-quiz-card" data-vs-quiz>
      <div class="vs-center-head">
        <span class="vs-kicker">🩺 Rychlá sebediagnostika</span>
        <h2 class="vs-heading">Trápí vás některý z těchto projevů?</h2>
        <p class="vs-sub">Označte příznaky, které u sebe pozorujete, a zjistěte, kde je jejich skutečný fyziologický původ.</p>
      </div>

      <div class="vs-symptom-grid">
        <button type="button" class="vs-symptom-btn" role="checkbox" aria-checked="false" data-vs-symptom>
          <span class="vs-symptom-box" aria-hidden="true">✓</span>
          <span>Ranní otoky očních víček a váčky po probuzení</span>
        </button>
        <button type="button" class="vs-symptom-btn" role="checkbox" aria-checked="false" data-vs-symptom>
          <span class="vs-symptom-box" aria-hidden="true">✓</span>
          <span>Tmavé kruhy pod očima, které nezakryje ani korektor</span>
        </button>
        <button type="button" class="vs-symptom-btn" role="checkbox" aria-checked="false" data-vs-symptom>
          <span class="vs-symptom-box" aria-hidden="true">✓</span>
          <span>Jemné vrásky a unavená, dehydratovaná pleť očního okolí</span>
        </button>
        <button type="button" class="vs-symptom-btn" role="checkbox" aria-checked="false" data-vs-symptom>
          <span class="vs-symptom-box" aria-hidden="true">✓</span>
          <span>Pocit pálení, těžkosti a suchých očí po práci u obrazovky</span>
        </button>
        <button type="button" class="vs-symptom-btn vs-symptom-btn--wide" role="checkbox" aria-checked="false" data-vs-symptom>
          <span class="vs-symptom-box" aria-hidden="true">✓</span>
          <span>Běžné oční krémy přinášejí jen krátkodobý nebo nulový efekt</span>
        </button>
      </div>

      <div class="vs-diagnosis-banner is-empty" aria-live="polite">
        <div class="vs-diag-prompt" data-vs-diag-prompt>
          <span class="vs-diag-prompt__icon" aria-hidden="true">👆</span>
          <span>Pro zobrazení výsledků a příčiny zaškrtněte alespoň jeden projev výše</span>
        </div>
        <div class="vs-diag-result" data-vs-diag-result hidden>
          <strong data-vs-diag-headline>Proč běžné krémy samy o sobě nestačí:</strong>
          <span>Problém není ve svrchní vrstvě kůže, ale ve zpomalené lymfatické cirkulaci a zhoršeném mikrokrevním oběhu kolem očí. Samotný krém lymfu nerozhýbe - k tomu je nutná cílená mikromasáž EMS pulzy a červené světlo.</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. NÁVOD NA POUŽITÍ - 4 KROKY S REÁLNÝMI GIFY -->
  <section class="vs-section" id="jak-funguje">
    <div class="vs-center-head">
      <span class="vs-kicker">✨ Snadná 10minutová péče</span>
      <h2 class="vs-heading">Bez zákroků a bez rekonvalescence</h2>
      <p class="vs-sub">Stačí nasadit, zvolit intenzitu a nechat přístroj pracovat za vás - po 10 minutách se sám vypne.</p>
    </div>

    <div class="vs-steps-grid">
      <article class="vs-step-card">
        <div class="vs-step-media">
          <img src="{{ step1_gif_url }}" alt="Krok 1 - Čistá pleť" width="400" height="400" loading="lazy">
          <span class="vs-step-pill">Krok 1</span>
        </div>
        <div class="vs-step-body">
          <strong>Čistá pleť</strong>
          Začněte s čistou pletí - důkladně si umyjte obličej, abyste odstranili mastnotu i nečistoty pro maximální účinek.
        </div>
      </article>

      <article class="vs-step-card">
        <div class="vs-step-media">
          <img src="{{ step2_gif_url }}" alt="Krok 2 - Kapka séra či krému" width="400" height="400" loading="lazy">
          <span class="vs-step-pill">Krok 2</span>
        </div>
        <div class="vs-step-body">
          <strong>Kapka séra či krému</strong>
          Naneste pod oči množství očního krému nebo séra na vodní bázi o velikosti hrášku pro zesílení vodivosti mikroproudů.
        </div>
      </article>

      <article class="vs-step-card">
        <div class="vs-step-media">
          <img src="{{ step3_gif_url }}" alt="Krok 3 - Volba režimu" width="400" height="400" loading="lazy">
          <span class="vs-step-pill">Krok 3</span>
        </div>
        <div class="vs-step-body">
          <strong>Volba režimu</strong>
          Zapněte přístroj a pomocí tlačítek zvolte požadovaný režim pulzů a příjemnou intenzitu mikroproudů.
        </div>
      </article>

      <article class="vs-step-card">
        <div class="vs-step-media">
          <img src="{{ step4_gif_url }}" alt="Krok 4 - 10 minut relaxace" width="400" height="400" loading="lazy">
          <span class="vs-step-pill">Krok 4</span>
        </div>
        <div class="vs-step-body">
          <strong>10 minut relaxace</strong>
          Pohodlně se usaďte, čtěte si nebo relaxujte - sami i ve dvou - zatímco přístroj pracuje za vás!
        </div>
      </article>
    </div>
  </section>

  <!-- MEZISEKČNÍ KONVERZNÍ BANNER -->
  <section class="vs-section vs-section--mid-cta" aria-label="Akční nabídka VeaSkin">
    <div class="vs-mid-page-cta__inner">
      <div class="vs-mid-page-cta__title">Chcete se probouzet se svěžíma očima bez otoků?</div>
      <div class="vs-mid-page-cta__sub">Využijte časově omezenou slevu 30 % s dopravou ZDARMA do zítřejší půlnoci.</div>
      <a href="#nabidka-box" class="vs-cta-btn vs-mid-page-cta__btn">
        PŘIDAT DO KOŠÍKU SE SLEVOU 30 % →
      </a>
    </div>
  </section>

  <!-- 5. TECHNOLOGIE + INTERAKTIVNÍ PŘED / PO SLIDER & 82/87/91 % -->
  <section class="vs-section" id="technologie">
    <div class="vs-science-grid" id="vysledky">
      <!-- Left: Clinical Benefits -->
      <div class="vs-science-card">
        <div>
          <span class="vs-kicker vs-kicker--dark">🔬 Klinicky ověřená synergie</span>
          <h2 class="vs-heading">Proč je <span class="vs-science-highlight">terapie červeným světlem + mikroproudy</span> tak účinná</h2>

          <ul class="vs-science-list">
            <li>
              <span class="vs-science-dot" aria-hidden="true">✓</span>
              <div><strong>Červené světlo (630-660 nm) proniká 2-3 mm hluboko</strong> - stimuluje tvorbu kolagenu a zrychluje mikrocirkulaci tam, kam běžné krémy nedosáhnou.</div>
            </li>
            <li>
              <span class="vs-science-dot" aria-hidden="true">✓</span>
              <div><strong>Mikroproudy aktivují lymfatickou drenáž</strong> - eliminují hromadění tekutiny, která způsobuje ranní otoky a váčky pod očima.</div>
            </li>
            <li>
              <span class="vs-science-dot" aria-hidden="true">✓</span>
              <div><strong>Řeší všechny 3 hlavní příčiny problémů</strong> - slabou cirkulaci (tmavé kruhy), zadržování vody (otoky) a úbytek kolagenu (vrásky).</div>
            </li>
            <li>
              <span class="vs-science-dot" aria-hidden="true">✓</span>
              <div><strong>Původ v rehabilitační medicíně a výzkumu NASA</strong> - podloženo desítkami let studií, 100% neinvazivní bez bolesti a operací.</div>
            </li>
          </ul>
        </div>
      </div>

      <!-- Right: Before / After Slider + 3 Stats -->
      <div class="vs-ba-card">
        <div>
          <div class="vs-ba-top">
            <strong>Viditelná proměna už během několika týdnů</strong>
            <span class="vs-ba-hint">↔ Posuňte pro srovnání</span>
          </div>

          <div class="vs-ba-viewer" data-vs-ba-viewer>
            <img src="{{ after_img_url }}" alt="Po používání VeaSkin" width="800" height="550" loading="lazy">
            <img src="{{ before_img_url }}" alt="Před používáním VeaSkin" class="vs-ba-before" width="800" height="550" loading="lazy" data-vs-ba-before>
            <div class="vs-ba-line" data-vs-ba-line></div>
            <div class="vs-ba-knob" aria-hidden="true" data-vs-ba-knob>↔</div>
            <span class="vs-ba-tag vs-ba-tag--left">PŘED</span>
            <span class="vs-ba-tag vs-ba-tag--right">PO KÚŘE</span>
            <input
              type="range"
              min="5"
              max="95"
              value="50"
              class="vs-ba-range"
              aria-label="Posuvník pro porovnání fotografie před a po kúře"
              data-vs-ba-range
            >
          </div>
        </div>

        <div class="vs-stats-row">
          <div class="vs-stat-box">
            <div class="vs-stat-num">82 %</div>
            <div class="vs-stat-txt">zesvětlení tmavých kruhů již po 2 týdnech</div>

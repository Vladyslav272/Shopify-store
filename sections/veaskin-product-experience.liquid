{% liquid
  assign target_product = product
  if target_product == blank
    assign target_product = all_products['led-ems-bryle-na-ocni-okoli']
  endif
  if target_product == blank
    assign target_product = collections.all.products.first
  endif

  assign first_variant = target_product.selected_or_first_available_variant
  assign v1_id = first_variant.id

  assign raw_price = first_variant.price | default: 132900
  assign raw_compare = first_variant.compare_at_price | default: 0

  if raw_compare > raw_price and raw_price > 0
    assign p_base = raw_price
    assign c_base = raw_compare
  elsif raw_price > 0 and raw_price != 132900
    assign p_base = raw_price
    assign c_base = raw_price | times: 143 | divided_by: 100
  else
    assign p_base = 132900
    assign c_base = 189900
  endif

  assign save_raw = c_base | minus: p_base
  assign p_kc = p_base | divided_by: 100
  assign c_kc = c_base | divided_by: 100
  assign save_kc = c_kc | minus: p_kc
  assign discount_pct = save_raw | times: 100 | divided_by: c_base

  assign p_base_fmt = p_base | money_without_trailing_zeros | replace: '.', ' '
  assign c_base_fmt = c_base | money_without_trailing_zeros | replace: '.', ' '
  assign save_fmt = save_raw | money_without_trailing_zeros | replace: '.', ' '

  assign badge_mode = section.settings.offer_badge_variant | default: 'combined'
  if badge_mode == 'savings'
    assign price_badge_prefix = 'Ušetříte'
    assign sticky_badge_text = '−' | append: discount_pct | append: ' %'
  elsif badge_mode == 'social'
    assign price_badge_prefix = '★ Bestseller • Ušetříte'
    assign sticky_badge_text = 'Bestseller'
  else
    assign price_badge_prefix = '★ Ušetříte'
    assign sticky_badge_text = '−' | append: discount_pct | append: ' % + E-book'
  endif

  assign ebook_title = section.settings.ebook_title | default: 'E-book „Oči bez stínů“'
  assign ebook_desc = section.settings.ebook_desc | default: 'Praktický průvodce ranní péčí a lymfatickými technikami pro jasný pohled bez tmavých kruhů a otoků – ihned po objednání do e-mailu.'
  assign ebook_value = section.settings.ebook_value | default: '290 Kč'

  assign ebook_product = section.settings.ebook_product
  assign ebook_variant_id = ''
  if ebook_product != blank and ebook_product.selected_or_first_available_variant != blank
    assign ebook_variant_id = ebook_product.selected_or_first_available_variant.id
  endif

  assign studio_hero_url = 'veaskin-hero-pearl.jpg' | asset_url
  if section.settings.hero_image != blank
    assign studio_hero_url = section.settings.hero_image | image_url: width: 1200
  endif

  if images['zenabilepozadi.jpg'] != blank
    assign model_white_url = images['zenabilepozadi.jpg'] | image_url: width: 1200
  else
    assign model_white_url = 'zenabilepozadi.jpg' | asset_url
  endif

  if section.settings.lifestyle_image != blank
    assign lifestyle_img_url = section.settings.lifestyle_image | image_url: width: 1200
  else
    assign lifestyle_img_url = 'veaskin-morning-lifestyle.jpg' | asset_url
  endif

  assign thumb_detail_url = 'veaskin-review-2.jpg' | asset_url

  if section.settings.before_image != blank
    assign before_img_url = section.settings.before_image | image_url: width: 1000
  elsif images['pred.jpg'] != blank
    assign before_img_url = images['pred.jpg'] | image_url: width: 1000
  else
    assign before_img_url = 'veaskin-den0.jpg' | asset_url
  endif

  if section.settings.after_image != blank
    assign after_img_url = section.settings.after_image | image_url: width: 1000
  elsif images['po.jpg'] != blank
    assign after_img_url = images['po.jpg'] | image_url: width: 1000
  else
    assign after_img_url = 'veaskin-den14.jpg' | asset_url
  endif

  assign rev1_img_url = 'veaskin-review-1.jpg' | asset_url
  assign rev2_img_url = 'veaskin-review-2.jpg' | asset_url
  assign rev3_img_url = 'rannikafe.jpg' | asset_url

  assign product_form_id = 'VeaSkinProductForm-' | append: section.id
%}

{% render 'theme-drawer-styles' %}
<script
  src="{{ 'product-form.js' | asset_url }}"
  type="module"
></script>

{%- if target_product != blank -%}
  <script type="application/ld+json">
    {{ target_product | structured_data }}
  </script>
{%- endif -%}

<div
  class="vs-shell"
  id="veaskin-pdp"
  data-vs-experience
  data-unit-price="{{ p_kc }}"
  data-compare-price="{{ c_kc }}"
  data-discount-pct="{{ discount_pct }}"
  data-badge-prefix="{{ price_badge_prefix | escape }}"
  data-ebook-variant-id="{{ ebook_variant_id }}"
>

  <!-- ========================================================================
       SEKCE 2: OTEVŘENÁ NÁKUPNÍ SEKCE – JEDNA VARIANTA BRÝLÍ + E-BOOK + MNOŽSTVÍ
       ======================================================================== -->
  <section class="vs-band vs-band--white" id="top">
    <div class="vs-container vs-container--hero">
      <div class="vs-hero-grid" id="nabidka">
        <!-- Levý sloupec / Mobil nahoře: Čistá produktová galerie -->
        <div class="vs-gallery">
          <div class="vs-gallery__stage">
            <img
              src="{{ studio_hero_url }}"
              alt="VeaSkin LED & EMS brýle na oční okolí – Perlově bílá otevřená konstrukce s průhlednými nožičkami"
              class="vs-gallery__main-img"
              width="960"
              height="960"
              loading="eager"
              fetchpriority="high"
              data-vs-main-img
            >
            <a
              href="#recenze-sekce"
              class="vs-gallery__trust-strip"
              aria-label="Hodnocení 4,9 z 5 hvězdiček – Ověřeno 158 zákaznicemi"
            >
              <span class="vs-stars" aria-hidden="true">★★★★★</span>
              <span class="vs-gallery__trust-text">4.9 / 5 • Ověřeno 158 zákaznicemi</span>
            </a>
          </div>

          <div class="vs-gallery__thumbs" role="tablist" aria-label="Fotografie produktu VeaSkin">
            <button
              type="button"
              class="vs-gallery__thumb is-active"
              data-vs-thumb="{{ studio_hero_url }}"
              aria-label="Detail perlově bílých brýlí VeaSkin s průhlednými nožičkami"
              aria-pressed="true"
            >
              <img src="{{ studio_hero_url }}" alt="Studiový detail perlově bílých brýlí VeaSkin" width="160" height="160" loading="eager">
            </button>
            <button
              type="button"
              class="vs-gallery__thumb"
              data-vs-thumb="{{ model_white_url }}"
              aria-label="Ukázka usazení pod očima na lícních kostech – volný výhled"
              aria-pressed="false"
            >
              <img src="{{ model_white_url }}" alt="Brýle VeaSkin nasazené pod očima s volným výhledem" width="160" height="160" loading="lazy">
            </button>
            <button
              type="button"
              class="vs-gallery__thumb"
              data-vs-thumb="{{ lifestyle_img_url }}"
              aria-label="Ranní rituál u čaje v lněném županu"
              aria-pressed="false"
            >
              <img src="{{ lifestyle_img_url }}" alt="Ranní rituál u čaje s otevřenými brýlemi VeaSkin" width="160" height="160" loading="lazy">
            </button>
            <button
              type="button"
              class="vs-gallery__thumb"
              data-vs-thumb="{{ thumb_detail_url }}"
              aria-label="Otevřená konstrukce VeaSkin u ranní kávy"
              aria-pressed="false"
            >
              <img src="{{ thumb_detail_url }}" alt="Detail otevřené konstrukce VeaSkin u ranního cappuccina" width="160" height="160" loading="lazy">
            </button>
          </div>
        </div>

        <!-- Pravý sloupec / Mobil dole: Otevřená nákupní zóna jedné varianty -->
        <div class="vs-buy-panel" id="nabidka-box">
          <div class="vs-stock-line">
            <span class="vs-stock-line__dot" aria-hidden="true"></span>
            <span>Skladem v ČR – ihned k odeslání</span>
            <span class="vs-stock-line__sep" aria-hidden="true">|</span>
            <span>Doprava zdarma</span>
          </div>

          <h1 class="vs-product-title">
            {{ section.settings.product_heading | default: 'VeaSkin LED & EMS brýle na oční okolí' }}
          </h1>

          <p class="vs-variant-meta">
            <span class="vs-variant-meta__swatch" aria-hidden="true"></span>
            <span>Provedení: Perlově bílá s průhlednými nožičkami</span>
          </p>

          <p class="vs-product-subtitle">
            {{ section.settings.product_subtitle | default: 'Svěží a odpočatý pohled za 10 minut denně – bez otoků a vrstvy korektoru. Otevřená konstrukce sedí pouze pod očima, takže přes brýle normálně vidíte.' }}
          </p>

          <!-- Cena + CRO štítek úspory (dynamicky se násobí dle vybraného množství) -->
          <div class="vs-price-block">
            <span class="vs-price-block__current" data-vs-price-display>{{ p_base_fmt }}</span>
            <span class="vs-price-block__compare" data-vs-compare-display>{{ c_base_fmt }}</span>
            <span class="vs-price-block__badge" data-vs-save-display>
              {{ price_badge_prefix }} {{ save_fmt }} (−{{ discount_pct }} %)
            </span>
          </div>

          <!-- Součást objednávky: E-book „Oči bez stínů“ ZDARMA -->
          <div class="vs-ebook-bonus">
            <span class="vs-ebook-bonus__icon" aria-hidden="true">
              <svg width="20" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
                <line x1="9" y1="7" x2="16" y2="7"></line>
                <line x1="9" y1="11" x2="14" y2="11"></line>
              </svg>
            </span>
            <div class="vs-ebook-bonus__body">
              <div class="vs-ebook-bonus__top">
                <span class="vs-ebook-bonus__title">+ K brýlím: {{ ebook_title }}</span>
                <span class="vs-ebook-bonus__tag"><s>{{ ebook_value }}</s> ZDARMA</span>
              </div>
              <p class="vs-ebook-bonus__desc">{{ ebook_desc }}</p>
            </div>
          </div>

          <!-- Obsah balení bez zmínky o českém návodu -->
          <p class="vs-package-line">
            <strong>Obsah balení:</strong> VeaSkin LED &amp; EMS brýle, ochranné pouzdro, nabíjecí USB-C kabel a digitální e-book „Oči bez stínů“.
          </p>

          <!-- Výběr množství (Stepper − / + a rychlé volby 1 ks, 2 ks, 3 ks) -->
          <div class="vs-qty-selector">
            <div class="vs-qty-selector__head">
              <span class="vs-qty-selector__label">Vyberte množství</span>
              <span class="vs-qty-selector__shipping">✓ Doprava zdarma na celou objednávku</span>
            </div>

            <div class="vs-qty-selector__controls">
              <div class="vs-qty-stepper" role="group" aria-label="Změna počtu kusů">
                <button
                  type="button"
                  class="vs-qty-btn"
                  aria-label="Snížit počet kusů"
                  data-vs-qty-btn="minus"
                >−</button>
                <span class="vs-qty-val" data-vs-qty-val>1</span>
                <button
                  type="button"
                  class="vs-qty-btn"
                  aria-label="Zvýšit počet kusů"
                  data-vs-qty-btn="plus"
                >+</button>
              </div>

              <div class="vs-qty-pills" role="radiogroup" aria-label="Rychlý výběr počtu kusů">
                <button type="button" class="vs-qty-pill is-active" data-vs-qty-pill="1" role="radio" aria-checked="true">1 ks</button>
                <button type="button" class="vs-qty-pill" data-vs-qty-pill="2" role="radio" aria-checked="false">2 ks</button>
                <button type="button" class="vs-qty-pill" data-vs-qty-pill="3" role="radio" aria-checked="false">3 ks</button>
              </div>
            </div>
          </div>

          <!-- Hlavní CTA tlačítko napojené na Shopify košík -->
          {%- if target_product != blank -%}
            <product-form-component
              data-section-id="{{ section.id }}"
              data-product-id="{{ target_product.id }}"
              data-product-url="{{ target_product.url }}"
              on:submit="/handleSubmit"
              data-quantity-default="1"
              data-quantity-error-max="{{ 'products.product.quantity_error_max' | t }}"
            >
              <div
                class="visually-hidden"
                aria-live="assertive"
                role="status"
                aria-atomic="true"
                ref="liveRegion"
              ></div>

              {%- form 'product', target_product, id: product_form_id, data-type: 'add-to-cart-form' -%}
                <input
                  type="hidden"
                  name="id"
                  ref="variantId"
                  value="{{ v1_id }}"
                  data-vs-form-id
                >
                <input
                  type="hidden"
                  name="quantity"
                  value="1"
                  data-vs-form-qty
                >
                <span class="product-form-text__error hidden" ref="addToCartTextError">
                  <span class="svg-wrapper">
                    {{- 'icon-error.svg' | inline_asset_content -}}
                  </span>
                </span>
                <button
                  type="submit"
                  name="add"
                  class="vs-cta-btn vs-cta-btn--main"
                  data-vs-cta-btn
                  {% unless first_variant.available %}disabled{% endunless %}
                >
                  {%- if first_variant.available -%}
                    <span data-vs-cta-label>Přidat do košíku — {{ p_base_fmt }}</span>
                  {%- else -%}
                    <span>Vyprodáno</span>
                  {%- endif -%}
                </button>
              {%- endform -%}
            </product-form-component>
          {%- else -%}
            <button type="button" class="vs-cta-btn vs-cta-btn--main" data-vs-cta-btn>
              <span data-vs-cta-label>Přidat do košíku — {{ p_base_fmt }}</span>
            </button>
          {%- endif -%}

          <!-- Rychlé pilíře důvěry oddělené jemnými svislými linkami -->
          <ul class="vs-quick-trust" aria-label="Garance nákupu VeaSkin">
            <li class="vs-quick-trust__item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                <path d="m9 12 2 2 4-4"></path>
              </svg>
              <span>30 dní na zkoušku</span>
            </li>
            <li class="vs-quick-trust__item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="1" y="3" width="15" height="13" rx="1"></rect>
                <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                <circle cx="5.5" cy="18.5" r="2.5"></circle>
                <circle cx="18.5" cy="18.5" r="2.5"></circle>
              </svg>
              <span>Odeslání do 24 h</span>
            </li>
            <li class="vs-quick-trust__item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
              </svg>
              <span>E-book v ceně</span>
            </li>
          </ul>

          <!-- Samostatný garanční pás 30 dní bez rizika -->
          <div class="vs-guarantee-strip">
            <span class="vs-guarantee-strip__icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="8" r="6"></circle>
                <path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"></path>
              </svg>
            </span>
            <div>
              <p class="vs-guarantee-strip__title">30 dní na vyzkoušení u ranní kávy bez rizika</p>
              <p class="vs-guarantee-strip__text">
                Vyzkoušejte VeaSkin v klidu domova. Pokud do 30 dnů neuvidíte rozdíl, vrátíme vám 100 % částky.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================
       SEKCE 3: 4 KLÍČOVÉ BENEFITY (PÁS SILK CREAM #FAF8F5 S ČISTÝMI LINKAMI)
       ======================================================================== -->
  <section class="vs-band vs-band--cream" id="benefity" aria-label="Klíčové benefity přístroje VeaSkin">
    <div class="vs-container vs-container--compact">
      <div class="vs-benefits-list">
        <div class="vs-benefit-item">
          <span class="vs-benefit-item__check" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </span>
          <div>
            <h2 class="vs-benefit-item__title">Jemná kompresní a vibrační masáž</h2>
            <p class="vs-benefit-item__desc">Uvolňuje napětí a redukuje ranní otoky.</p>
          </div>
        </div>

        <div class="vs-benefit-item">
          <span class="vs-benefit-item__check" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </span>
          <div>
            <h2 class="vs-benefit-item__title">Příjemná tepelná terapie</h2>
            <p class="vs-benefit-item__desc">Ulevuje suchým očím a únavě z obrazovek.</p>
          </div>
        </div>

        <div class="vs-benefit-item">
          <span class="vs-benefit-item__check" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </span>
          <div>
            <h2 class="vs-benefit-item__title">Více režimů a intenzit</h2>
            <p class="vs-benefit-item__desc">Péči si přizpůsobíte své aktuální potřebě.</p>
          </div>
        </div>

        <div class="vs-benefit-item">
          <span class="vs-benefit-item__check" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </span>
          <div>
            <h2 class="vs-benefit-item__title">Měkké ergonomické polstrování</h2>
            <p class="vs-benefit-item__desc">Hebký materiál, který netlačí a padne každému.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================
       SEKCE 4: EMOČNÍ LIFESTYLOVÁ SEKCE (PLNÝ PÁS BEZ KARTY)
       ======================================================================== -->
  <section class="vs-band vs-band--mint" id="ranni-ritual">
    <div class="vs-container">
      <div class="vs-lifestyle-split">
        <div class="vs-lifestyle-split__media">
          <img
            src="{{ lifestyle_img_url }}"
            alt="Usměvavá 38letá žena v béžovém lněném županu s hrnkem čaje a otevřenými perlově bílými brýlemi VeaSkin pod očima"
            width="960"
            height="720"
            loading="lazy"
          >
          <div class="vs-lifestyle-split__caption">
            ✓ Otevřená konstrukce s průhlednými nožičkami sedí pouze pod očima – během rituálu normálně vidíte.
          </div>
        </div>

        <div class="vs-lifestyle-split__copy">
          <span class="vs-kicker">☕ První krok k vaší ranní proměně</span>
          <h2 class="vs-section-heading">
            Vykročte do rána <span class="vs-text-accent">s úsměvem.</span> Stačí jen <span class="vs-text-accent">10 minut péče.</span>
          </h2>
          <p class="vs-lifestyle-split__text">
            Cítíte se plná energie, ale pohled do zrcadla říká opak? Otoky a unavené oči už nemusíte maskovat vrstvou korektoru. VeaSkin vám během ranní kávy vrátí svěží pohled a sebevědomí cítit se krásná – přirozeně a bez líčení.
          </p>
          <a href="#nabidka-box" class="vs-cta-btn vs-cta-btn--inline" data-vs-scroll-buy>
            Objednat VeaSkin + E-book zdarma →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================
       SEKCE 5: JAK TECHNOLOGIE FUNGUJE (3 OTEVŘENÉ SLOUPCE S LINKAMI)
       ======================================================================== -->
  <section class="vs-band vs-band--white" id="technologie">
    <div class="vs-container">
      <div class="vs-section-head">
        <span class="vs-kicker">630–660 nm Červené LED + EMS</span>
        <h2 class="vs-section-heading">Síla světla a jemné mikromasáže v jednom kroku</h2>
        <p class="vs-section-sub">
          Ergonomické perlově bílé oblouky působí přesně na oblast lícních kostí pod očima, zatímco vaše oči zůstávají po celou dobu volné.
        </p>
      </div>

      <div class="vs-tech-columns">
        <article class="vs-tech-col">
          <div class="vs-tech-col__icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2"></path>
              <path d="M12 20v2"></path>
              <path d="m4.93 4.93 1.41 1.41"></path>
              <path d="m17.66 17.66 1.41 1.41"></path>
              <path d="M2 12h2"></path>
              <path d="M20 12h2"></path>
              <path d="m6.34 17.66-1.41 1.41"></path>
              <path d="m19.07 4.93-1.41 1.41"></path>
            </svg>
          </div>
          <div>
            <h3 class="vs-tech-col__title">Červené LED světlo</h3>

{% javascript %}
  document.addEventListener('click', (event) => {
    const target = event.target instanceof Element ? event.target : null;
    if (!target) return;

    // 1. Thumbnail switcher
    const thumbBtn = target.closest('[data-vs-thumb]');
    if (thumbBtn) {
      const root = thumbBtn.closest('[data-vs-experience]');
      const mainImg = root?.querySelector('[data-vs-main-img]');
      const url = thumbBtn.getAttribute('data-vs-thumb');
      if (mainImg && url) {
        mainImg.setAttribute('src', url);
        root.querySelectorAll('[data-vs-thumb]').forEach((btn) => {
          const active = btn === thumbBtn;
          btn.classList.toggle('is-active', active);
          btn.setAttribute('aria-pressed', active ? 'true' : 'false');
        });
      }
      return;
    }

    // 2. Quantity selector & dynamic price calculation
    const qtyBtn = target.closest('[data-vs-qty-btn]');
    const qtyPill = target.closest('[data-vs-qty-pill]');

    if (qtyBtn || qtyPill) {
      const root = (qtyBtn || qtyPill).closest('[data-vs-experience]');
      if (!root) return;

      const qtyValEl = root.querySelector('[data-vs-qty-val]');
      const qtyInput = root.querySelector('[data-vs-form-qty]');
      const ctaMainEl = root.querySelector('[data-vs-cta-main]');
      const priceDisplayEl = root.querySelector('[data-vs-price-display]');
      const compareDisplayEl = root.querySelector('[data-vs-compare-display]');
      const saveDisplayEl = root.querySelector('[data-vs-save-display]');
      const pills = root.querySelectorAll('[data-vs-qty-pill]');

      const unitPrice = 1329;
      const comparePrice = 1899;

      let currentQty = parseInt(qtyInput ? qtyInput.value : '1', 10) || 1;

      if (qtyBtn) {
        const action = qtyBtn.getAttribute('data-vs-qty-btn');
        if (action === 'plus') currentQty += 1;
        if (action === 'minus') currentQty -= 1;
      } else if (qtyPill) {
        const pQty = parseInt(qtyPill.getAttribute('data-vs-qty-pill'), 10);
        if (!isNaN(pQty)) currentQty = pQty;
      }

      currentQty = Math.max(1, Math.min(10, currentQty));

      if (qtyValEl) qtyValEl.textContent = String(currentQty);
      if (qtyInput) qtyInput.value = String(currentQty);

      const totalCurrent = unitPrice * currentQty;
      const totalCompare = comparePrice * currentQty;
      const totalSave = totalCompare - totalCurrent;

      const fmt = (val) => val.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ' ') + ' Kč';

      if (ctaMainEl) ctaMainEl.textContent = `PŘIDAT DO KOŠÍKU — ${fmt(totalCurrent)}`;
      if (priceDisplayEl) priceDisplayEl.textContent = fmt(totalCurrent);
      if (compareDisplayEl) compareDisplayEl.textContent = fmt(totalCompare);
      if (saveDisplayEl) saveDisplayEl.textContent = `Ušetříte ${fmt(totalSave)}`;

      pills.forEach((pill) => {
        const pillVal = parseInt(pill.getAttribute('data-vs-qty-pill'), 10);
        const active = pillVal === currentQty;
        pill.classList.toggle('is-active', active);
        pill.setAttribute('aria-checked', active ? 'true' : 'false');
      });

      return;
    }
  });

  // 4. Horizontal Steps Swipe Slider sync
  const initStepsSlider = () => {
    document.querySelectorAll('[data-vs-steps-slider]').forEach((slider) => {
      const track = slider.querySelector('[data-vs-steps-track]');
      const dots = slider.querySelectorAll('[data-vs-step-dot]');
      const cards = slider.querySelectorAll('[data-vs-step-card]');
      if (!track || !dots.length) return;

      const updateActiveDot = () => {
        const scrollLeft = track.scrollLeft;
        const width = track.clientWidth;
        let activeIndex = Math.round(scrollLeft / (track.scrollWidth - width) * (cards.length - 1));
        activeIndex = Math.max(0, Math.min(cards.length - 1, activeIndex));

        dots.forEach((dot, idx) => {
          dot.classList.toggle('is-active', idx === activeIndex);
          dot.setAttribute('aria-selected', idx === activeIndex ? 'true' : 'false');
        });
      };

      track.addEventListener('scroll', updateActiveDot, { passive: true });

      dots.forEach((dot) => {
        dot.addEventListener('click', () => {
          const idx = parseInt(dot.getAttribute('data-vs-step-dot'), 10);
          if (!isNaN(idx) && cards[idx]) {
            cards[idx].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'start' });
          }
        });
      });
    });
  };
  initStepsSlider();

  // 3. Interactive Before / After range slider
  document.addEventListener('input', (event) => {
    const input = event.target instanceof HTMLInputElement ? event.target : null;
    if (!input || !input.hasAttribute('data-vs-ba-range')) return;
    const viewer = input.closest('[data-vs-ba-viewer]');
    if (!viewer) return;
    const val = Number(input.value);
    const beforeImg = viewer.querySelector('[data-vs-ba-before]');
    const line = viewer.querySelector('[data-vs-ba-line]');
    const knob = viewer.querySelector('[data-vs-ba-knob]');
    if (beforeImg instanceof HTMLElement) {
      beforeImg.style.clipPath = `inset(0 ${100 - val}% 0 0)`;
    }
    if (line instanceof HTMLElement) {
      line.style.left = `${val}%`;
    }
    if (knob instanceof HTMLElement) {
      knob.style.left = `${val}%`;
    }
  });
{% endjavascript %}


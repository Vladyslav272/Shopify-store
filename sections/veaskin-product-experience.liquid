{% javascript %}
  (() => {
    const formatKc = (amount) => {
      return Math.round(amount).toString().replace(/\B(?=(\d{3})+(?!\d))/g, ' ') + ' Kč';
    };

    const updateQuantityState = (root, nextQty) => {
      if (!root) return;
      const qty = Math.max(1, Math.min(10, nextQty));

      const unitPrice = Number(root.getAttribute('data-unit-price') || 1329);
      const comparePrice = Number(root.getAttribute('data-compare-price') || 1899);
      const discountPct = root.getAttribute('data-discount-pct') || '30';
      const badgePrefix = root.getAttribute('data-badge-prefix') || '★ Ušetříte';

      const totalCurrent = unitPrice * qty;
      const totalCompare = comparePrice * qty;
      const totalSave = Math.max(0, totalCompare - totalCurrent);

      const qtyValEl = root.querySelector('[data-vs-qty-val]');
      const qtyInput = root.querySelector('[data-vs-form-qty]');
      const priceDisplayEl = root.querySelector('[data-vs-price-display]');
      const compareDisplayEl = root.querySelector('[data-vs-compare-display]');
      const saveDisplayEl = root.querySelector('[data-vs-save-display]');
      const ctaLabelEl = root.querySelector('[data-vs-cta-label]');
      const stickyPriceEl = root.querySelector('[data-vs-sticky-price]');

      if (qtyValEl) qtyValEl.textContent = String(qty);
      if (qtyInput instanceof HTMLInputElement) qtyInput.value = String(qty);
      if (priceDisplayEl) priceDisplayEl.textContent = formatKc(totalCurrent);
      if (compareDisplayEl) compareDisplayEl.textContent = formatKc(totalCompare);
      if (saveDisplayEl) {
        saveDisplayEl.textContent = `${badgePrefix} ${formatKc(totalSave)} (−${discountPct} %)`;
      }
      if (ctaLabelEl) {
        const ksText = qty > 1 ? ` (${qty} ks)` : '';
        ctaLabelEl.textContent = `Přidat do košíku${ksText} — ${formatKc(totalCurrent)}`;
      }
      if (stickyPriceEl) stickyPriceEl.textContent = formatKc(totalCurrent);

      for (const pill of root.querySelectorAll('[data-vs-qty-pill]')) {
        const pillQty = parseInt(pill.getAttribute('data-vs-qty-pill') || '0', 10);
        const active = pillQty === qty;
        pill.classList.toggle('is-active', active);
        pill.setAttribute('aria-checked', active ? 'true' : 'false');
      }
    };

    document.addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target : null;
      if (!target) return;

      // 1. Přepínání fotografií v galerii
      const thumbBtn = target.closest('[data-vs-thumb]');
      if (thumbBtn) {
        const root = thumbBtn.closest('[data-vs-experience]');
        const mainImg = root?.querySelector('[data-vs-main-img]');
        const url = thumbBtn.getAttribute('data-vs-thumb');
        if (mainImg && url) {
          mainImg.setAttribute('src', url);
          root.querySelectorAll('[data-vs-thumb]').forEach((btn) => {
            const active = btn === thumbBtn;
            btn.classList.toggle('is-active', active);
            btn.setAttribute('aria-pressed', active ? 'true' : 'false');
          });
        }
        return;
      }

      // 2. Výběr množství (− / + stepper a rychlá tlačítka 1 ks / 2 ks / 3 ks)
      const qtyBtn = target.closest('[data-vs-qty-btn]');
      const qtyPill = target.closest('[data-vs-qty-pill]');
      if (qtyBtn || qtyPill) {
        const root = (qtyBtn || qtyPill).closest('[data-vs-experience]');
        if (!root) return;
        const qtyInput = root.querySelector('[data-vs-form-qty]');
        let currentQty = parseInt(qtyInput instanceof HTMLInputElement ? qtyInput.value : '1', 10) || 1;

        if (qtyBtn) {
          const action = qtyBtn.getAttribute('data-vs-qty-btn');
          if (action === 'plus') currentQty += 1;
          if (action === 'minus') currentQty -= 1;
        } else if (qtyPill) {
          const parsed = parseInt(qtyPill.getAttribute('data-vs-qty-pill') || '1', 10);
          if (!Number.isNaN(parsed)) currentQty = parsed;
        }

        updateQuantityState(root, currentQty);
        return;
      }

      // 3. Plynulé odscrollování k nákupní zóně
      const scrollTrigger = target.closest('[data-vs-sticky-cta], [data-vs-scroll-buy]');
      if (scrollTrigger) {
        event.preventDefault();
        const buyZone = document.querySelector('#nabidka-box');
        if (buyZone) {
          buyZone.scrollIntoView({ behavior: 'smooth', block: 'start' });
          buyZone.classList.add('is-highlighted');
          setTimeout(() => buyZone.classList.remove('is-highlighted'), 950);
        }
      }
    });

    // Volitelné automatické přidání digitálního produktu e-booku (0 Kč), pokud je spárován v editoru
    document.addEventListener('submit', (event) => {
      const form = event.target instanceof HTMLFormElement ? event.target : null;
      if (!form || form.getAttribute('data-type') !== 'add-to-cart-form') return;
      const root = form.closest('[data-vs-experience]');
      const ebookVarId = root?.getAttribute('data-ebook-variant-id');
      if (!ebookVarId) return;

      setTimeout(async () => {
        try {
          const cartRes = await fetch('/cart.js');
          if (cartRes.ok) {
            const cartData = await cartRes.json();
            const alreadyInCart = (cartData.items || []).some((item) => String(item.variant_id) === String(ebookVarId));
            if (alreadyInCart) return;
          }
          await fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ items: [{ id: Number(ebookVarId), quantity: 1 }] }),
          });
        } catch {
          // E-book je doručen automaticky e-mailem
        }
      }, 280);
    });

    // Interaktivní posuvník Před / Po
    document.addEventListener('input', (event) => {
      const input = event.target instanceof HTMLInputElement ? event.target : null;
      if (!input || !input.hasAttribute('data-vs-ba-range')) return;
      const viewer = input.closest('[data-vs-ba-viewer]');
      if (!viewer) return;
      const val = Number(input.value);
      const beforeImg = viewer.querySelector('[data-vs-ba-before]');
      const line = viewer.querySelector('[data-vs-ba-line]');
      const knob = viewer.querySelector('[data-vs-ba-knob]');
      if (beforeImg instanceof HTMLElement) {
        beforeImg.style.clipPath = `inset(0 ${100 - val}% 0 0)`;
      }
      if (line instanceof HTMLElement) {
        line.style.left = `${val}%`;
      }
      if (knob instanceof HTMLElement) {
        knob.style.left = `${val}%`;
      }
    });

    // Zobrazení dokované spodní lišty po odscrollování z Buy Boxu
    const initStickyBar = () => {
      const stickyBar = document.querySelector('[data-vs-sticky-bar]');
      const buyBox = document.querySelector('#nabidka-box');
      if (!stickyBar || !buyBox) return;

      const checkVisibility = () => {
        const rect = buyBox.getBoundingClientRect();
        const isInView = rect.top < window.innerHeight && rect.bottom > 80;
        if (!isInView && window.scrollY > 320) {
          stickyBar.classList.add('is-visible');
        } else {
          stickyBar.classList.remove('is-visible');
        }
      };

      window.addEventListener('scroll', checkVisibility, { passive: true });
      checkVisibility();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initStickyBar, { once: true });
    } else {
      initStickyBar();
    }
  })();
{% endjavascript %}


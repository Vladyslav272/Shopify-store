{{ 'veaskin-landing.css' | asset_url | stylesheet_tag }}

{% liquid
  assign product_resource = closest.product | default: product
  assign image_to_show = section.settings.image | default: product_resource.featured_media.preview_image | default: product_resource.featured_image
%}

<section class="zm-section zm-showcase" style="background-color: {{ section.settings.background_color | default: '#FAF5F5' }};">
  <div class="zm-container">
    <div class="zm-showcase__grid">
      
      <!-- Product Image Showcase Column -->
      <div class="zm-showcase__visual">
        <div class="zm-showcase__card">
          {% if image_to_show != blank %}
            {{ image_to_show | image_url: width: 900 | image_tag: 
              class: 'zm-showcase__img', 
              loading: 'lazy', 
              alt: section.settings.heading | default: product_resource.title | default: 'VeaSkin' 
            }}
          {% else %}
            {{ 'product-1' | placeholder_svg_tag: 'zm-showcase__img zm-showcase__placeholder' }}
          {% endif %}

          <div class="zm-showcase__badge">
            <span class="zm-showcase__stars">★★★★★</span>
            <div class="zm-showcase__badge-text">
              <strong>4,9 / 5</strong>
              <span>2 000+ spokojených žen</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Content Column -->
      <div class="zm-showcase__content">
        <div class="zm-showcase__kicker">
          <span class="zm-showcase__kicker-dot"></span>
          {{ section.settings.kicker | default: 'Vaše nová ranní rutina' }}
        </div>

        <h2 class="zm-showcase__heading">
          {{ section.settings.heading | default: 'Dopřejte svým očím péči, kterou si zaslouží. <em>Znovu se zamilujte do svého odrazu.</em>' }}
        </h2>

        <div class="zm-showcase__desc">
          <p>{{ section.settings.subtitle | default: 'Připojte se k tisícům spokojených žen, které každé ráno začínají s úsměvem a svěžím pohledem bez make-upu a unavených kruhů.' }}</p>
        </div>

        <!-- Trust Features -->
        <ul class="zm-showcase__features" role="list">
          <li class="zm-showcase__feature">
            <svg class="zm-showcase__icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="12" cy="12" r="10" fill="#c98a7d" fill-opacity="0.15"/>
              <path d="M8 12.5L10.5 15L16 9.5" stroke="#c98a7d" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <div>
              <strong>Viditelné výsledky již po 14 dnech</strong>
              <span>Redukce ranních otoků, zjemnění jemných linek a rozjasnění očního okolí.</span>
            </div>
          </li>
          <li class="zm-showcase__feature">
            <svg class="zm-showcase__icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="12" cy="12" r="10" fill="#c98a7d" fill-opacity="0.15"/>
              <path d="M8 12.5L10.5 15L16 9.5" stroke="#c98a7d" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <div>
              <strong>60 dní na vyzkoušení bez rizika</strong>
              <span>Pokud nebudete nadšená, jednoduše vám vrátíme 100 % částky.</span>
            </div>
          </li>
          <li class="zm-showcase__feature">
            <svg class="zm-showcase__icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="12" cy="12" r="10" fill="#c98a7d" fill-opacity="0.15"/>
              <path d="M8 12.5L10.5 15L16 9.5" stroke="#c98a7d" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <div>
              <strong>Doprava zdarma & odeslání do 24 h</strong>
              <span>Rychlé a bezpečné doručení až k vašim dveřím.</span>
            </div>
          </li>
        </ul>

        <!-- Action / CTA -->
        <div class="zm-showcase__actions">
          <a href="{{ section.settings.cta_url | default: '#MainContent' }}" class="zm-btn zm-showcase__btn" data-zm-scroll>
            <span>{{ section.settings.cta_text | default: 'Objednat VeaSkin s 60denní garancí' }}</span>
            <svg class="zm-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
          <p class="zm-note">
            <svg class="zm-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
            <span>Garance 100% spokojenosti • Bezpečný nákup • Česká podpora</span>
          </p>
        </div>

      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Landing: Product Showcase",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Barva pozadí",
      "default": "#FAF5F5"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Obrázek produktu (volitelný - jinak se použije hlavní fotka produktu)"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker / Podtitul nahoře",
      "default": "Vaše nová ranní rutina"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Hlavní nadpis",
      "default": "Dopřejte svým očím péči, kterou si zaslouží. <em>Znovu se zamilujte do svého odrazu.</em>"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Popis pod nadpisem",
      "default": "Připojte se k tisícům spokojených žen, které každé ráno začínají s úsměvem a svěžím pohledem bez make-upu a unavených kruhů."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Text tlačítka",
      "default": "Objednat VeaSkin s 60denní garancí"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Odkaz tlačítka",
      "default": "/#MainContent"
    }
  ],
  "presets": [
    {
      "name": "Landing: Product Showcase"
    }
  ]
}
{% endschema %}

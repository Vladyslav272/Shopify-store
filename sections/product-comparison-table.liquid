{% liquid
  assign bg_color = section.settings.background_color | default: '#FAF5F5'
%}

<div class="product-comparison-section section-{{ section.id }}" style="background-color: {{ bg_color }};">
  <div class="product-comparison-container">
    <div class="product-comparison-card">
      <div class="product-comparison-header">
        {% if section.settings.badge != blank %}
          <span class="product-comparison-badge">
            <span class="product-comparison-badge-icon">⚖️</span>
            {{ section.settings.badge }}
          </span>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="product-comparison-title">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.subtitle != blank %}
          <p class="product-comparison-subtitle">{{ section.settings.subtitle }}</p>
        {% endif %}
      </div>

      <div class="product-comparison-grid">
        <!-- Sloupec 1: Krémy -->
        <div class="comp-card-col">
          <h3 class="comp-col-heading">{{ section.settings.col1_title | default: 'Běžné oční krémy' }}</h3>
          <div class="comp-col-price comp-muted-price">
            {{ section.settings.col1_price | default: 'cca 1 500 Kč' }}
            <span class="comp-col-sub">{{ section.settings.col1_price_sub | default: '/ 2 měsíce' }}</span>
          </div>
          <ul class="comp-col-features">
            <li><span class="comp-icon comp-cross">✕</span> Působí pouze na povrchu epidermis</li>
            <li><span class="comp-icon comp-cross">✕</span> Nerozhýbou stagnující lymfu</li>
            <li><span class="comp-icon comp-cross">✕</span> Nutnost neustálého dokupování zásob</li>
            <li><span class="comp-icon comp-check">✓</span> Snadná domácí aplikace</li>
          </ul>
        </div>

        <!-- Sloupec 2: VeaSkin (Vítěz) -->
        <div class="comp-card-col is-winner">
          <div class="comp-winner-ribbon">Chytrá volba</div>
          <h3 class="comp-col-heading">{{ section.settings.col2_title | default: 'VeaSkin Přístroj' }}</h3>
          <div class="comp-col-price comp-hero-price">
            {{ section.settings.col2_price | default: '1 200 Kč' }}
            <span class="comp-col-sub">{{ section.settings.col2_price_sub | default: '/ jednorázově' }}</span>
          </div>
          <ul class="comp-col-features">
            <li><span class="comp-icon comp-check">✓</span> <strong>Cílená lymfatická masáž a prohřátí</strong></li>
            <li><span class="comp-icon comp-check">✓</span> <strong>Viditelná úleva od otoků už po 10 min.</strong></li>
            <li><span class="comp-icon comp-check">✓</span> <strong>Dlouholetá péče bez dalších investic</strong></li>
            <li><span class="comp-icon comp-check">✓</span> <strong>30 dní na vyzkoušení bez rizika</strong></li>
          </ul>
        </div>

        <!-- Sloupec 3: Salón / Klinika -->
        <div class="comp-card-col">
          <h3 class="comp-col-heading">{{ section.settings.col3_title | default: 'Klinické zákroky' }}</h3>
          <div class="comp-col-price comp-muted-price">
            {{ section.settings.col3_price | default: '8 000 – 15 000 Kč' }}
            <span class="comp-col-sub">{{ section.settings.col3_price_sub | default: '/ sezení' }}</span>
          </div>
          <ul class="comp-col-features">
            <li><span class="comp-icon comp-check">✓</span> Výrazný okamžitý vizuální efekt</li>
            <li><span class="comp-icon comp-cross">✕</span> Jehly, modřinky a čas na zotavení</li>
            <li><span class="comp-icon comp-cross">✕</span> Nutnost opakování každých 6-12 měsíců</li>
            <li><span class="comp-icon comp-cross">✕</span> Extrémně vysoké finanční náklady</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>

{% style %}
  .product-comparison-section {
    padding: 40px 16px;
    width: 100%;
    box-sizing: border-box;
  }

  .product-comparison-container {
    max-width: 820px;
    margin: 0 auto;
    width: 100%;
  }

  .product-comparison-card {
    background: #FFFFFF;
    border: 1px solid #EADBDA;
    border-radius: 24px;
    padding: 36px 28px;
    box-shadow: 0 4px 24px rgba(43, 35, 37, 0.05);
    box-sizing: border-box;
  }

  .product-comparison-header {
    text-align: center;
    margin-bottom: 28px;
  }

  .product-comparison-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #FBEFEE;
    color: #BB6966;
    padding: 5px 14px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 12px;
  }

  .product-comparison-title {
    font-family: var(--font-heading-family, 'Tenor Sans', serif);
    font-size: clamp(22px, 3.5vw, 30px);
    line-height: 1.25;
    color: #2B2325;
    margin: 0 0 10px;
    letter-spacing: -0.01em;
  }

  .product-comparison-subtitle {
    font-family: var(--font-body-family, 'DM Sans', sans-serif);
    font-size: 15px;
    color: #6B6264;
    max-width: 580px;
    margin: 0 auto;
    line-height: 1.5;
  }

  .product-comparison-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 24px;
    align-items: stretch;
  }

  .comp-card-col {
    background: #FAF8F8;
    border: 1.5px solid #EADBDA;
    border-radius: 18px;
    padding: 24px 18px;
    position: relative;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    transition: all 0.25s ease;
  }

  .comp-card-col.is-winner {
    background: #FFFDFD;
    border: 2px solid #BB6966;
    box-shadow: 0 10px 30px rgba(187, 105, 102, 0.14);
    transform: translateY(-4px);
  }

  .comp-winner-ribbon {
    position: absolute;
    top: -12px;
    right: 16px;
    background: #BB6966;
    color: #FFFFFF;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 4px 12px;
    border-radius: 999px;
    box-shadow: 0 2px 8px rgba(187, 105, 102, 0.3);
  }

  .comp-col-heading {
    font-family: var(--font-heading-family, 'Tenor Sans', serif);
    font-size: 18px;
    color: #2B2325;
    margin: 0 0 8px;
    line-height: 1.3;
  }

  .comp-col-price {
    font-family: var(--font-body-family, 'DM Sans', sans-serif);
    font-size: 20px;
    font-weight: 700;
    margin-bottom: 16px;
    padding-bottom: 14px;
    border-bottom: 1px dashed #EADBDA;
    display: flex;
    align-items: baseline;
    gap: 4px;
  }

  .comp-hero-price {
    color: #BB6966;
  }

  .comp-muted-price {
    color: #6B6264;
  }

  .comp-col-sub {
    font-size: 12px;
    font-weight: 400;
    color: #8A7F81;
  }

  .comp-col-features {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: 13.5px;
    line-height: 1.45;
    color: #3D3536;
    flex: 1;
  }

  .comp-col-features li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }

  .comp-icon {
    font-size: 14px;
    font-weight: 700;
    flex-shrink: 0;
    margin-top: 1px;
  }

  .comp-check {
    color: #2E7D32;
  }

  .comp-cross {
    color: #A89C9D;
  }

  @media (max-width: 720px) {
    .product-comparison-section {
      padding: 30px 14px;
    }
    .product-comparison-card {
      padding: 24px 16px;
      border-radius: 18px;
    }
    .product-comparison-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .comp-card-col.is-winner {
      transform: none;
      order: -1;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Srovnání alternativ",
  "tag": "section",
  "class": "product-comparison-table",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Barva pozadí sekce",
      "default": "#FAF5F5"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Horní odznak",
      "default": "Upřímné srovnání"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Nadpis",
      "default": "Proč je VeaSkin nejchytřejší volba?"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Podnadpis",
      "default": "Přehledné srovnání přístupu, výsledků a nákladů běžných metod vs. VeaSkin."
    },
    {
      "type": "header",
      "content": "Sloupec 1: Běžné krémy"
    },
    {
      "type": "text",
      "id": "col1_title",
      "label": "Titulek",
      "default": "Běžné oční krémy"
    },
    {
      "type": "text",
      "id": "col1_price",
      "label": "Cena",
      "default": "cca 1 500 Kč"
    },
    {
      "type": "text",
      "id": "col1_price_sub",
      "label": "Podtitul ceny",
      "default": "/ 2 měsíce"
    },
    {
      "type": "header",
      "content": "Sloupec 2: VeaSkin (Vítěz)"
    },
    {
      "type": "text",
      "id": "col2_title",
      "label": "Titulek",
      "default": "VeaSkin Přístroj"
    },
    {
      "type": "text",
      "id": "col2_price",
      "label": "Cena",
      "default": "1 200 Kč"
    },
    {
      "type": "text",
      "id": "col2_price_sub",
      "label": "Podtitul ceny",
      "default": "/ jednorázově"
    },
    {
      "type": "header",
      "content": "Sloupec 3: Klinické zákroky"
    },
    {
      "type": "text",
      "id": "col3_title",
      "label": "Titulek",
      "default": "Klinické zákroky"
    },
    {
      "type": "text",
      "id": "col3_price",
      "label": "Cena",
      "default": "8 000 – 15 000 Kč"
    },
    {
      "type": "text",
      "id": "col3_price_sub",
      "label": "Podtitul ceny",
      "default": "/ sezení"
    }
  ],
  "presets": [
    {
      "name": "Srovnání alternativ"
    }
  ]
}
{% endschema %}

{{ 'veaskin-landing.css' | asset_url | stylesheet_tag }}

<section class="zm-section zm-tl" style="background-color: {{ section.settings.background_color }};">
  <div class="zm-container zm-container--narrow">
    <div class="zm-head">
      <h2 class="zm-heading">
        {{ section.settings.heading | default: 'Co se stane, když začnete? <em>Znovu se zamilujete do svého odrazu.</em>' }}
      </h2>
      <div class="zm-text">
        <p>{{ section.settings.subtitle | default: 'Už za pár týdnů pocítíte ten rozdíl. Nejen na pleti, ale v tom, jak sebevědomě a s úsměvem vstupujete do každého nového dne.' }}</p>
      </div>
    </div>

    <ol class="zm-tl__list" role="list">
      <li class="zm-tl__step" style="--step-color: #bb6966; --next-color: #a2524f;">
        <span class="zm-tl__dot" aria-hidden="true">1</span>
        <div class="zm-tl__card">
          <h3 class="zm-tl__label">Po 7 dnech: První ranní úsměv bez korektoru</h3>
          <div class="zm-tl__text">
            <p><strong>Okamžitý pocit lehkosti.</strong> Ranní otoky a váčky mizí po 10 minutách jemného rituálu. Když se podíváte do zrcadla, nevidíte unavenou tvář, ale svěží, probuzený pohled, který vám hned po ránu vykouzlí úsměv na rtech.</p>
          </div>
        </div>
      </li>

      <li class="zm-tl__step" style="--step-color: #a2524f; --next-color: #4a7c59;">
        <span class="zm-tl__dot" aria-hidden="true">2</span>
        <div class="zm-tl__card">
          <h3 class="zm-tl__label">Po 14 dnech: Komplimenty, které zahřejí u srdce</h3>
          <div class="zm-tl__text">
            <p><strong>Lidé si všimnou té změny.</strong> Kolegyně v práci i partner se zeptají: <em>„Ty dnes vypadáš tak odpočatě, byla jsi na kosmetice?“</em> Tmavé kruhy blednou a vaše oči znovu získávají tu přirozenou jiskru, kterou jste postrádala.</p>
          </div>
        </div>
      </li>

      <li class="zm-tl__step" style="--step-color: #4a7c59; --next-color: #4a7c59;">
        <span class="zm-tl__dot" aria-hidden="true">3</span>
        <div class="zm-tl__card">
          <h3 class="zm-tl__label">Po 30 dnech: Skutečný pocit krásy a přitažlivosti</h3>
          <div class="zm-tl__text">
            <p><strong>Mladistvé sebevědomí bez filtrů.</strong> Pokožka je pevná, jemné vějířky kolem očí zjemněné a vy můžete s hrdostí vyrazit ven bez jediné kapky make-upu. Ten pocit svobody a čisté ženské krásy je k nezaplacení.</p>
          </div>
        </div>
      </li>
    </ol>

    <div class="zm-actions" style="margin-top: 36px;">
      <a href="#MainContent" class="zm-btn" data-zm-scroll>
        <span>{{ section.settings.cta_text | default: 'Chci se znovu cítit krásná a zářit' }}</span>
        <svg class="zm-icon zm-icon--arrow_down" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 5v14M19 12l-7 7-7-7"/>
        </svg>
      </a>
      <p class="zm-note">
        <svg class="zm-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
        <span>Garance spokojenosti 60 dní: Buď se zamilujete do svého odrazu, nebo vrátíme peníze.</span>
      </p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Landing: Timeline Results",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Barva pozadí",
      "default": "#FFFFFF"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Nadpis",
      "default": "Co se stane, když začnete? <em>Znovu se zamilujete do svého odrazu.</em>"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Podnadpis",
      "default": "Už za pár týdnů pocítíte ten rozdíl. Nejen na pleti, ale v tom, jak sebevědomě a s úsměvem vstupujete do každého nového dne."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Text tlačítka",
      "default": "Chci se znovu cítit krásná a zářit"
    }
  ],
  "presets": [
    {
      "name": "Landing: Timeline Results"
    }
  ]
}
{% endschema %}

{{ 'veaskin-landing.css' | asset_url | stylesheet_tag }}

<section class="zm-section zm-tl" style="background-color: {{ section.settings.background_color }};">
  <div class="zm-container zm-container--narrow">
    <div class="zm-head">
      <h2 class="zm-heading">
        {{ section.settings.heading | default: 'Co můžete očekávat? <em>Viditelné výsledky krok za krokem.</em>' }}
      </h2>
      <div class="zm-text">
        <p>{{ section.settings.subtitle | default: 'Pouhých 10 minut denně v pohodlí domova stačí k postupné obnově mladistvého očního okolí.' }}</p>
      </div>
    </div>

    <ol class="zm-tl__list" role="list">
      <li class="zm-tl__step" style="--step-color: #bb6966; --next-color: #a2524f;">
        <span class="zm-tl__dot" aria-hidden="true">1</span>
        <div class="zm-tl__card">
          <h3 class="zm-tl__label">Po 7 dnech: Rychlá úleva od otoků</h3>
          <div class="zm-tl__text">
            <p><strong>Okamžitý ranní lifting.</strong> Jemné mikroproudy a prohřívání rozproudí lymfatický oběh, odplaví zadržovanou tekutinu a redukují ranní váčky pod očima již během prvního týdne.</p>
          </div>
        </div>
      </li>

      <li class="zm-tl__step" style="--step-color: #a2524f; --next-color: #4a7c59;">
        <span class="zm-tl__dot" aria-hidden="true">2</span>
        <div class="zm-tl__card">
          <h3 class="zm-tl__label">Po 14 dnech: Zesvětlení tmavých kruhů</h3>
          <div class="zm-tl__text">
            <p><strong>Rozjasněný a svěží pohled.</strong> Terapie červeným světlem v kombinaci se sonickými vibracemi okysličuje podkoží, stimuluje mikrocirkulaci a viditelně zesvětluje tmavé kruhy.</p>
          </div>
        </div>
      </li>

      <li class="zm-tl__step" style="--step-color: #4a7c59; --next-color: #4a7c59;">
        <span class="zm-tl__dot" aria-hidden="true">3</span>
        <div class="zm-tl__card">
          <h3 class="zm-tl__label">Po 30 dnech: Vyhlazení vrásek a zpevnění</h3>
          <div class="zm-tl__text">
            <p><strong>Trvalé omlazení bez jehel.</strong> Hloubková stimulace tvorby vlastního kolagenu a elastinu obnovuje pevnost pleti. Jemné mimické vrásky a vějířky kolem očí jsou prokazatelně zjemněné.</p>
          </div>
        </div>
      </li>
    </ol>

    <div class="zm-actions" style="margin-top: 36px;">
      <a href="#MainContent" class="zm-btn" data-zm-scroll>
        <span>{{ section.settings.cta_text | default: 'Chci začít s proměnou ještě dnes' }}</span>
        <svg class="zm-icon zm-icon--arrow_down" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 5v14M19 12l-7 7-7-7"/>
        </svg>
      </a>
      <p class="zm-note">
        <svg class="zm-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
        <span>Garance spokojenosti 60 dní: Pokud neuvidíte změnu, vrátíme vám peníze.</span>
      </p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Landing: Timeline Results",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Barva pozadí",
      "default": "#FFFFFF"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Nadpis",
      "default": "Co můžete očekávat? <em>Viditelné výsledky krok za krokem.</em>"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Podnadpis",
      "default": "Pouhých 10 minut denně v pohodlí domova stačí k postupné obnově mladistvého očního okolí."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Text tlačítka",
      "default": "Chci začít s proměnou ještě dnes"
    }
  ],
  "presets": [
    {
      "name": "Landing: Timeline Results"
    }
  ]
}
{% endschema %}

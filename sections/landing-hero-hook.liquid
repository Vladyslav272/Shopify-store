{{ 'veaskin-landing.css' | asset_url | stylesheet_tag }}
<script src="{{ 'veaskin-landing.js' | asset_url }}" defer="defer"></script>

<section class="zm-section zm-hero" style="background-color: {{ section.settings.background_color }};">
  <div class="zm-container zm-container--narrow">
    <div class="zm-hero__inner">
      <div class="zm-hero__content">
        <div class="zm-hero__rating">
          <span class="zm-hero__stars" style="color: #e28743; letter-spacing: 2px;">★★★★★</span>
          <span class="zm-hero__score"><strong>4,9/5</strong></span>
          <span class="zm-hero__sep">•</span>
          <span class="zm-hero__social">2 000+ žen, které znovu září</span>
          <span class="zm-hero__sep">•</span>
          <span class="zm-hero__badge">Česká značka</span>
        </div>

        <h1 class="zm-heading">
          {{ section.settings.heading | default: 'Znovu se podívejte do zrcadla s úsměvem a hrdostí.* <em>Cítit se přirozeně krásná nebyl nikdy snadnější rituál.</em>' }}
        </h1>

        <div class="zm-text">
          <p>
            {{ section.settings.subheading | default: 'Už žádné vrstvy korektoru ani nepříjemné otázky okolí, jestli jste se nevyspala. Dopřejte si 10 minut luxusní péče denně – probuďte zářivý, odpočatý pohled a znovu zažijte ten nádherný pocit ženského sebevědomí, kdy se cítíte neodolatelná i bez kapky make-upu.' }}
          </p>
        </div>

        <div class="zm-hero__actions">
          <div class="zm-actions">
            <a href="#MainContent" class="zm-btn" data-zm-scroll>
              <span>{{ section.settings.cta_text | default: 'Chci se znovu cítit krásná a zářit' }}</span>
              <svg class="zm-icon zm-icon--arrow_down" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 5v14M19 12l-7 7-7-7"/>
              </svg>
            </a>

            <p class="zm-note">
              <svg class="zm-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4a7c59" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              </svg>
              <span><strong>60 dní na zamilování se do svého odrazu</strong> – buď budete nadšená, nebo vrátíme peníze</span>
            </p>

            <p class="zm-footnote" style="font-size: 0.82rem; color: #b5a8aa; margin-top: 4px;">
              *Výsledky se mohou lišit. Založeno na spotřebitelském testování při pravidelném používání.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Landing: Hero Hook",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Barva pozadí",
      "default": "#000000"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Hlavní nadpis (podporuje <em> pro zvýraznění)",
      "default": "Znovu se podívejte do zrcadla s úsměvem a hrdostí.* <em>Cítit se přirozeně krásná nebyl nikdy snadnější rituál.</em>"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Podnadpis",
      "default": "Už žádné vrstvy korektoru ani nepříjemné otázky okolí, jestli jste se nevyspala. Dopřejte si 10 minut luxusní péče denně – probuďte zářivý, odpočatý pohled a znovu zažijte ten nádherný pocit ženského sebevědomí, kdy se cítíte neodolatelná i bez kapky make-upu."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Text tlačítka",
      "default": "Chci se znovu cítit krásná a zářit"
    }
  ],
  "presets": [
    {
      "name": "Landing: Hero Hook"
    }
  ]
}
{% endschema %}

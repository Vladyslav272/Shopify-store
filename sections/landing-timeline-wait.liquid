{{ 'veaskin-landing.css' | asset_url | stylesheet_tag }}

<section class="zm-section zm-tl zm-tl--warning" style="background-color: {{ section.settings.background_color }};">
  <div class="zm-container zm-container--narrow">
    <div class="zm-head">
      <h2 class="zm-heading">
        {{ section.settings.heading | default: 'Čas běží a unavený výraz se sám nenapraví. <em>A ztráta sebevědomí bolí nejvíc.</em>' }}
      </h2>
    </div>

    <ol class="zm-tl__list" role="list">
      <li class="zm-tl__step" style="--step-color: #725d57; --next-color: #8c5755;">
        <span class="zm-tl__dot" aria-hidden="true">1</span>
        <div class="zm-tl__card">
          <h3 class="zm-tl__label">Dnes: Zklamání před ranním zrcadlem</h3>
          <div class="zm-tl__text">
            <p>Snažíte se zamaskovat únavu a ranní otoky korektorem, ale máte pocit, že ztrácíte svou přirozenou svěžest a jiskru v očích.</p>
          </div>
        </div>
      </li>

      <li class="zm-tl__step" style="--step-color: #8c5755; --next-color: #a4484b;">
        <span class="zm-tl__dot" aria-hidden="true">2</span>
        <div class="zm-tl__card">
          <h3 class="zm-tl__label">Za pár měsíců: Make-up přestává pomáhat</h3>
          <div class="zm-tl__text">
            <p>Korektor zalézá do mimických vrásek a únavu spíše zvýrazňuje. Častěji slýcháte otázky: <em>„Jsi nevyspalá?“</em>, i když jste odpočívala.</p>
          </div>
        </div>
      </li>

      <li class="zm-tl__step" style="--step-color: #a4484b; --next-color: #bb3941;">
        <span class="zm-tl__dot" aria-hidden="true">3</span>
        <div class="zm-tl__card">
          <h3 class="zm-tl__label">Za rok či dva: Vyhýbání se fotkám bez filtru</h3>
          <div class="zm-tl__text">
            <p>Povislá víčka a trvalé kruhy vám ubírají pocit ženskosti a přitažlivosti. Ztrácíte radost ze společenských akcí i rodinných fotek.</p>
          </div>
        </div>
      </li>

      <li class="zm-tl__step" style="--step-color: #bb3941; --next-color: #bb3941;">
        <span class="zm-tl__dot" aria-hidden="true">4</span>
        <div class="zm-tl__card">
          <h3 class="zm-tl__label">Později: Strach z invazivních zákroků</h3>
          <div class="zm-tl__text">
            <p>Když přirozená pružnost pleti zmizí, zbývají jen drahé injekce, botox s rizikem „zamrzlé“ mimiky nebo bolestivá operace očních víček.</p>
          </div>
        </div>
      </li>
    </ol>

    <div class="zm-actions" style="margin-top: 36px;">
      <a href="#MainContent" class="zm-btn" data-zm-scroll>
        <span>{{ section.settings.cta_text | default: 'Zastavit stárnutí včas a cítit se znovu krásná' }}</span>
        <svg class="zm-icon zm-icon--arrow_down" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 5v14M19 12l-7 7-7-7"/>
        </svg>
      </a>
      <p class="zm-note">
        <span>Začněte se správnou péčí dříve, než se z unaveného výrazu stane trvalý problém.</span>
      </p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Landing: Timeline Wait",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Barva pozadí",
      "default": "#FAF5F5"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Nadpis",
      "default": "Čas běží a unavený výraz se sám nenapraví. <em>A ztráta sebevědomí bolí nejvíc.</em>"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Text tlačítka",
      "default": "Zastavit stárnutí včas a cítit se znovu krásná"
    }
  ],
  "presets": [
    {
      "name": "Landing: Timeline Wait"
    }
  ]
}
{% endschema %}

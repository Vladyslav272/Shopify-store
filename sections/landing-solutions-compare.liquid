{{ 'veaskin-landing.css' | asset_url | stylesheet_tag }}

<section class="zm-section zm-compare" style="background-color: {{ section.settings.background_color }};">
  <div class="zm-container">
    <div class="zm-head">
      <h2 class="zm-heading">
        {{ section.settings.heading | default: 'Proč běžná péče nestačí? <em>A jak znovu získat mladistvý půvab.</em>' }}
      </h2>
      <div class="zm-text">
        <p>{{ section.settings.subtitle | default: 'Skutečné sebevědomí nepřichází z maskování vad, ale z přirozeně zdravé, odpočaté a zářící pleti.' }}</p>
      </div>
    </div>

    <ul class="zm-compare__grid" role="list">
      <!-- Option 1: Creams -->
      <li class="zm-compare__card zm-compare__card--bad" style="border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 20px; padding: 24px; background: #141414;">
        <div class="zm-compare__top" style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
          <span class="zm-compare__icon" style="color: #e05d6a; background: rgba(224, 93, 106, 0.15); width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
            <svg class="zm-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 6 6 18"></path><path d="m6 6 12 12"></path>
            </svg>
          </span>
          <h3 class="zm-compare__title" style="margin: 0; font-size: 1.25rem; font-weight: 700; color: #ffffff;">Běžné oční krémy</h3>
        </div>
        <div class="zm-compare__text" style="font-size: 0.95rem; line-height: 1.5; color: #b5a8aa;">
          <p style="margin-bottom: 8px;"><strong style="color: #ffffff;">Příslib:</strong> příjemná vůně a chvilkový pocit hydratace na povrchu.</p>
          <p style="margin: 0;"><strong style="color: #ffffff;">Zklamání:</strong> působí jen na svrchní vrstvu kůže. Nedokážou odplavit hromadící se lymfu ani aktivovat ochabující kolagen. Ranní zklamání před zrcadlem tak přetrvává dál.</p>
        </div>
      </li>

      <!-- Option 2: Clinic / Botox -->
      <li class="zm-compare__card zm-compare__card--bad" style="border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 20px; padding: 24px; background: #141414;">
        <div class="zm-compare__top" style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
          <span class="zm-compare__icon" style="color: #e05d6a; background: rgba(224, 93, 106, 0.15); width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
            <svg class="zm-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 6 6 18"></path><path d="m6 6 12 12"></path>
            </svg>
          </span>
          <h3 class="zm-compare__title" style="margin: 0; font-size: 1.25rem; font-weight: 700; color: #ffffff;">Estetické kliniky & botox</h3>
        </div>
        <div class="zm-compare__text" style="font-size: 0.95rem; line-height: 1.5; color: #b5a8aa;">
          <p style="margin-bottom: 8px;"><strong style="color: #ffffff;">Příslib:</strong> okamžitý, dramatický efekt po zákroku.</p>
          <p style="margin: 0;"><strong style="color: #ffffff;">Daň za výsledek:</strong> desítky tisíc korun ročně, nepříjemné vpichy jehel, modřiny a riziko „zamrzlého“ výrazu, který vás připraví o přirozený, vřelý úsměv.</p>
        </div>
      </li>

      <!-- Option 3: Veaskin -->
      <li class="zm-compare__card zm-compare__card--good" style="border: 2px solid #c98a7d; border-radius: 20px; padding: 24px; background: #1a1516; box-shadow: 0 10px 30px rgba(201, 138, 125, 0.2);">
        <div class="zm-compare__top" style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
          <span class="zm-compare__icon" style="color: #ffffff; background: #c98a7d; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
            <svg class="zm-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 6 9 17l-5-5"></path>
            </svg>
          </span>
          <h3 class="zm-compare__title" style="margin: 0; font-size: 1.25rem; font-weight: 700; color: #ffffff;">Veaskin Eye Care</h3>
        </div>
        <div class="zm-compare__text" style="font-size: 0.95rem; line-height: 1.5; color: #e5d8da;">
          <p style="margin-bottom: 8px;"><strong style="color: #ffffff;">Skutečný benefit:</strong> probudí přirozenou tvorbu vlastního kolagenu a lymfatickou mikrocirkulaci. Výsledkem je svěží pohled a radost při každém ranním pohledu do zrcadla.</p>
          <p style="margin: 0;"><strong style="color: #ffffff;">Pocit svobody:</strong> příjemný relaxační rituál v teple domova bez jehel a bolesti. Investice, která vám vrátí sebevědomí na roky dopředu.</p>
        </div>
      </li>
    </ul>

    <div class="zm-actions" style="margin-top: 36px;">
      <a href="#MainContent" class="zm-btn" data-zm-scroll>
        <span>{{ section.settings.cta_text | default: 'Zvolit přirozenou krásu s Veaskin' }}</span>
        <svg class="zm-icon zm-icon--arrow_down" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 5v14M19 12l-7 7-7-7"/>
        </svg>
      </a>
      <p class="zm-note">
        <svg class="zm-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
        <span>60denní garance spokojenosti: uvidíte změnu na vlastní oči, nebo vrátíme peníze.</span>
      </p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Landing: Solutions Compare",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Barva pozadí",
      "default": "#000000"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Nadpis",
      "default": "Proč běžná péče nestačí? <em>A jak znovu získat mladistvý půvab.</em>"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Podnadpis",
      "default": "Skutečné sebevědomí nepřichází z maskování vad, ale z přirozeně zdravé, odpočaté a zářící pleti."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Text tlačítka",
      "default": "Zvolit přirozenou krásu s Veaskin"
    }
  ],
  "presets": [
    {
      "name": "Landing: Solutions Compare"
    }
  ]
}
{% endschema %}

{{ 'veaskin-landing.css' | asset_url | stylesheet_tag }}

<section class="zm-section zm-compare" style="background-color: {{ section.settings.background_color }};">
  <div class="zm-container">
    <div class="zm-head">
      <h2 class="zm-heading">
        {{ section.settings.heading | default: 'Běžné krémy, klinika, nebo rovnou <em>Veaskin?</em>' }}
      </h2>
      <div class="zm-text">
        <p>Všechny cesty mají něco do sebe a možná jste o nich už přemýšlela. Každá má ale svůj <strong>háček</strong>.</p>
      </div>
    </div>

    <ul class="zm-compare__grid" role="list" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px;">
      <!-- Option 1: Creams -->
      <li class="zm-compare__card zm-compare__card--bad" style="border: 1px solid rgba(163, 56, 66, 0.25); border-radius: 20px; padding: 24px; background: #ffffff;">
        <div class="zm-compare__top" style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
          <span class="zm-compare__icon" style="color: #a33842; background: rgba(163, 56, 66, 0.1); width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
            <svg class="zm-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 6 6 18"></path><path d="m6 6 12 12"></path>
            </svg>
          </span>
          <h3 class="zm-compare__title" style="margin: 0; font-size: 1.25rem; font-weight: 700; color: #2b2325;">Běžné oční krémy</h3>
        </div>
        <div class="zm-compare__text" style="font-size: 0.95rem; line-height: 1.5; color: #5e5054;">
          <p style="margin-bottom: 8px;"><strong>Výhoda:</strong> jsou levné, snadno dostupné a příjemně voní.</p>
          <p style="margin: 0;"><strong>Háček:</strong> pronikají jen do nejsvrchnější vrstvy kůže. Hluboké vrásky, lymfatické otoky a nedostatek kolagenu pod očima zkrátka nevyřeší.</p>
        </div>
      </li>

      <!-- Option 2: Clinic / Botox -->
      <li class="zm-compare__card zm-compare__card--bad" style="border: 1px solid rgba(163, 56, 66, 0.25); border-radius: 20px; padding: 24px; background: #ffffff;">
        <div class="zm-compare__top" style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
          <span class="zm-compare__icon" style="color: #a33842; background: rgba(163, 56, 66, 0.1); width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
            <svg class="zm-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 6 6 18"></path><path d="m6 6 12 12"></path>
            </svg>
          </span>
          <h3 class="zm-compare__title" style="margin: 0; font-size: 1.25rem; font-weight: 700; color: #2b2325;">Estetické kliniky & botox</h3>
        </div>
        <div class="zm-compare__text" style="font-size: 0.95rem; line-height: 1.5; color: #5e5054;">
          <p style="margin-bottom: 8px;"><strong>Výhoda:</strong> rychlý a dramatický efekt po zákroku.</p>
          <p style="margin: 0;"><strong>Háček:</strong> stojí desítky tisíc korun ročně, zahrnuje bolestivé vpichy jehel, riziko nepřirozené mimiky, modřin a nutnost neustále zákroky opakovat.</p>
        </div>
      </li>

      <!-- Option 3: Veaskin -->
      <li class="zm-compare__card zm-compare__card--good" style="border: 2px solid #bb6966; border-radius: 20px; padding: 24px; background: #ffffff; box-shadow: 0 10px 25px rgba(187, 105, 102, 0.15);">
        <div class="zm-compare__top" style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
          <span class="zm-compare__icon" style="color: #ffffff; background: #bb6966; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
            <svg class="zm-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 6 9 17l-5-5"></path>
            </svg>
          </span>
          <h3 class="zm-compare__title" style="margin: 0; font-size: 1.25rem; font-weight: 700; color: #2b2325;">Veaskin Eye Care</h3>
        </div>
        <div class="zm-compare__text" style="font-size: 0.95rem; line-height: 1.5; color: #5e5054;">
          <p style="margin-bottom: 8px;"><strong>Výhoda:</strong> šetrná medicínská technologie červeného světla a mikroproudů v pohodlí domova. Bez jehel, bez bolesti a bez rekonvalescence.</p>
          <p style="margin: 0;"><strong>Investice:</strong> jednorázová koupě přístroje, který vám vydrží roky každodenní péče za zlomek ceny jediné návštěvy kliniky.</p>
        </div>
      </li>
    </ul>

    <div class="zm-actions" style="margin-top: 36px;">
      <a href="#MainContent" class="zm-btn" data-zm-scroll>
        <span>{{ section.settings.cta_text | default: 'Chci vyzkoušet Veaskin' }}</span>
        <svg class="zm-icon zm-icon--arrow_down" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 5v14M19 12l-7 7-7-7"/>
        </svg>
      </a>
      <p class="zm-note">
        <span>Garantujeme 60 dní na vyzkoušení s plnou zárukou vrácení peněz.</span>
      </p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Landing: Solutions Compare",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Barva pozadí",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Nadpis",
      "default": "Běžné krémy, klinika, nebo rovnou <em>Veaskin?</em>"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Text tlačítka",
      "default": "Chci vyzkoušet Veaskin"
    }
  ],
  "presets": [
    {
      "name": "Landing: Solutions Compare"
    }
  ]
}
{% endschema %}
